 			v = strings.TrimSpace(v)
--- a/infra/conf/tls_allow_insecure_test.go
+++ b/infra/conf/tls_allow_insecure_test.go
@@ -0,0 +1,70 @@
+package conf_test
+
+import (
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/infra/conf"
+	xraytls "github.com/xtls/xray-core/transport/internet/tls"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestTLSAllowInsecure(t *testing.T) {
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.StartTLS()
+	defer server.Close()
+	hash := sha256.Sum256(server.Certificate().Raw)
+	pin := hex.EncodeToString(hash[:])
+	for _, tc := range []struct {
+		name    string
+		options string
+		wantOK  bool
+	}{
+		{"default rejects untrusted certificate", `{}`, false},
+		{"false rejects untrusted certificate", `{"allowInsecure":false}`, false},
+		{"true accepts untrusted certificate", `{"allowInsecure":true}`, true},
+		{"valid pin", `{"pinnedPeerCertSha256":"` + pin + `"}`, true},
+		{"true with valid pin", `{"allowInsecure":true,"pinnedPeerCertSha256":"` + pin + `"}`, true},
+		{"true preserves invalid pin rejection", `{"allowInsecure":true,"pinnedPeerCertSha256":"` + strings.Repeat("00", 32) + `"}`, false},
+		{"true preserves explicit name verification", `{"allowInsecure":true,"verifyPeerCertByName":"wrong.invalid"}`, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var input conf.TLSConfig
+			if err := json.Unmarshal([]byte(tc.options), &input); err != nil {
+				t.Fatal(err)
+			}
+			input.ServerName = "example.com"
+			built, err := input.Build()
+			if err != nil {
+				t.Fatal(err)
+			}
+			// Exercise the protobuf path used by the core, not just the JSON loader.
+			data, err := proto.Marshal(built)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var config xraytls.Config
+			if err := proto.Unmarshal(data, &config); err != nil {
+				t.Fatal(err)
+			}
+			conn, err := tls.DialWithDialer(&net.Dialer{Timeout: 3 * time.Second}, "tcp", server.Listener.Addr().String(), config.GetTLSConfig())
+			if conn != nil {
+				conn.Close()
+			}
+			if (err == nil) != tc.wantOK {
+				t.Fatalf("handshake error = %v, want success %v", err, tc.wantOK)
+			}
+		})
+	}
+}
