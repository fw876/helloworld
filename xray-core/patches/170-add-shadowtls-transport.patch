+package shadowtls
+
+import (
+	"context"
+	"crypto/x509"
+	"fmt"
+	"net"
+	"slices"
+	"strings"
+	"time"
+
+	utls "github.com/metacubex/utls"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	protocol "github.com/xtls/xray-core/transport/internet/shadowtls/protocol"
+)
+
+func ConfigFromStreamSettings(settings *internet.MemoryStreamConfig) *Config {
+	if settings == nil {
+		return nil
+	}
+	c, _ := settings.SecuritySettings.(*Config)
+	return c
+}
+func (c *Config) Timeout() time.Duration {
+	if c.HandshakeTimeout == 0 {
+		return 15 * time.Second
+	}
+	return time.Duration(c.HandshakeTimeout) * time.Second
+}
+
+func (c *Config) Validate() error {
+	if c.Version < 1 || c.Version > 3 {
+		return fmt.Errorf("shadowtls: version must be 1, 2 or 3")
+	}
+	if c.HandshakeTimeout > 300 {
+		return fmt.Errorf("shadowtls: handshakeTimeout must not exceed 300 seconds")
+	}
+	if (c.Version == 2 && c.Password == "") || (c.Version == 3 && c.Password == "" && len(c.Users) == 0) {
+		return fmt.Errorf("shadowtls: password or users required")
+	}
+	for _, u := range c.Users {
+		if u == nil || u.Password == "" {
+			return fmt.Errorf("shadowtls: empty user password")
+		}
+	}
+	if _, err := fingerprint(c.Fingerprint); err != nil {
+		return err
+	}
+	switch c.WildcardSni {
+	case "", "off", "authed", "all":
+	default:
+		return fmt.Errorf("shadowtls: invalid wildcardSni")
+	}
+	for _, addr := range c.HandshakeForServerName {
+		if err := checkAddress(addr); err != nil {
+			return err
+		}
+	}
+	for name := range c.HandshakeForServerName {
+		if name == "" {
+			return fmt.Errorf("shadowtls: empty handshake server name")
+		}
+	}
+	if c.Handshake != "" {
+		if err := checkAddress(c.Handshake); err != nil {
+			return err
+		}
+	}
+	_, err := c.roots()
+	return err
+}
+func checkAddress(addr string) error {
+	d, err := xnet.ParseDestination("tcp:" + addr)
+	if err != nil || d.Port == 0 || d.Address == nil {
+		return fmt.Errorf("shadowtls: invalid handshake address %q", addr)
+	}
+	return nil
+}
+func (c *Config) roots() (*x509.CertPool, error) {
+	if len(c.Certificates) == 0 {
+		return nil, nil
+	}
+	pool, err := x509.SystemCertPool()
+	if err != nil {
+		pool = x509.NewCertPool()
+	}
+	for _, pem := range c.Certificates {
+		if !pool.AppendCertsFromPEM(pem) {
+			return nil, fmt.Errorf("shadowtls: invalid CA certificate")
+		}
+	}
+	return pool, nil
+}
+func fingerprint(name string) (*utls.ClientHelloID, error) {
+	ids := map[string]utls.ClientHelloID{"chrome": utls.HelloChrome_Auto, "firefox": utls.HelloFirefox_Auto, "safari": utls.HelloSafari_Auto, "ios": utls.HelloIOS_Auto, "android": utls.HelloAndroid_11_OkHttp, "edge": utls.HelloEdge_Auto, "360": utls.Hello360_Auto, "qq": utls.HelloQQ_Auto, "chrome120": utls.HelloChrome_120, "firefox120": utls.HelloFirefox_120, "safari16": utls.HelloSafari_16_0, "randomized": utls.HelloRandomized}
+	switch name {
+	case "", "none", "golang":
+		return nil, nil
+	}
+	id, ok := ids[name]
+	if !ok {
+		return nil, fmt.Errorf("shadowtls: unknown fingerprint %q", name)
+	}
+	return &id, nil
+}
+
+func (c *Config) Client(ctx context.Context, conn net.Conn, dest xnet.Destination) (net.Conn, error) {
+	if err := c.Validate(); err != nil {
+		return nil, err
+	}
+	if c.Version > 1 && c.Password == "" {
+		return nil, fmt.Errorf("shadowtls: outbound password required")
+	}
+	host := c.ServerName
+	if host == "" {
+		host = dest.Address.String()
+	}
+	roots, err := c.roots()
+	if err != nil {
+		return nil, err
+	}
+	fp, err := fingerprint(c.Fingerprint)
+	if err != nil {
+		return nil, err
+	}
+	alpn := c.Alpn
+	if len(alpn) == 0 {
+		alpn = protocol.DefaultALPN
+	}
+	client, err := protocol.NewClient(protocol.ClientConfig{Version: int(c.Version), Password: c.Password, StrictMode: c.StrictMode, TLSHandshake: func(ctx context.Context, raw net.Conn, generator protocol.TLSSessionIDGeneratorFunc) error {
+		tc := &utls.Config{ServerName: host, RootCAs: roots, InsecureSkipVerify: c.AllowInsecure, MinVersion: utls.VersionTLS12, NextProtos: alpn, SessionIDGenerator: generator}
+		if c.Version == 1 {
+			tc.MaxVersion = utls.VersionTLS12
+			return utls.Client(raw, tc).HandshakeContext(ctx)
+		}
+		// V2 cannot authenticate a handshake using the post-quantum key share.
+		if c.Version == 2 {
+			tc.CurvePreferences = []utls.CurveID{utls.X25519, utls.CurveP256, utls.CurveP384}
+		}
+		if fp == nil {
+			return utls.Client(raw, tc).HandshakeContext(ctx)
+		}
+		uc := utls.UClient(raw, tc, *fp)
+		if err := uc.BuildHandshakeState(); err != nil {
+			return err
+		}
+		for _, extension := range uc.Extensions {
+			switch e := extension.(type) {
+			case *utls.ALPNExtension:
+				if len(c.Alpn) > 0 {
+					e.AlpnProtocols = append([]string(nil), alpn...)
+				}
+			case *utls.SupportedCurvesExtension:
+				if c.Version == 2 {
+					e.Curves = slices.DeleteFunc(e.Curves, func(v utls.CurveID) bool { return v == utls.X25519MLKEM768 })
+				}
+			case *utls.KeyShareExtension:
+				if c.Version == 2 {
+					e.KeyShares = slices.DeleteFunc(e.KeyShares, func(v utls.KeyShare) bool { return v.Group == utls.X25519MLKEM768 })
+				}
+			}
+		}
+		if err := uc.BuildHandshakeState(); err != nil {
+			return err
+		}
+		return uc.HandshakeContext(ctx)
+	}})
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithTimeout(ctx, c.Timeout())
+	defer cancel()
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	result, err := client.DialContextConn(ctx, conn)
+	if !stop() && err == nil {
+		err = ctx.Err()
+	}
+	return result, err
+}
+
+type handshakeConn struct {
+	net.Conn
+	stop func() bool
+}
+
+func (c *handshakeConn) Close() error { c.stop(); return c.Conn.Close() }
+func (c *Config) ServerConfig(sockopt *internet.SocketConfig) (*protocol.ServerConfig, error) {
+	if err := c.Validate(); err != nil {
+		return nil, err
+	}
+	dial := func(ctx context.Context, network, addr string) (net.Conn, error) {
+		dest, err := xnet.ParseDestination("tcp:" + addr)
+		if err != nil {
+			return nil, err
+		}
+		conn, err := internet.DialSystem(ctx, dest, sockopt)
+		if err != nil {
+			return nil, err
+		}
+		return &handshakeConn{Conn: conn, stop: context.AfterFunc(ctx, func() { conn.Close() })}, nil
+	}
+	handshake := protocol.HandshakeConfig{Server: c.Handshake, DialContext: dial}
+	custom := make(map[string]protocol.HandshakeConfig, len(c.HandshakeForServerName))
+	for name, addr := range c.HandshakeForServerName {
+		custom[name] = protocol.HandshakeConfig{Server: addr, DialContext: dial}
+	}
+	users := make([]protocol.User, 0, len(c.Users)+1)
+	for _, u := range c.Users {
+		users = append(users, protocol.User{Name: u.Name, Password: u.Password})
+	}
+	if len(users) == 0 && c.Password != "" {
+		users = append(users, protocol.User{Password: c.Password})
+	}
+	wildcard := protocol.WildcardSNIOff
+	switch strings.ToLower(c.WildcardSni) {
+	case "authed":
+		wildcard = protocol.WildcardSNIAuthed
+	case "all":
+		wildcard = protocol.WildcardSNIAll
+	}
+	return protocol.NewServerConfig(int(c.Version), c.Password, users, handshake, custom, c.StrictMode, wildcard)
+}
