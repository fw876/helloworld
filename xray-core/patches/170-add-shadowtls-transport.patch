+	net.Conn
+	prefix *bytes.Reader
+}
+
+func newCachedConn(conn net.Conn, prefix []byte) net.Conn {
+	return &cachedConn{Conn: conn, prefix: bytes.NewReader(prefix)}
+}
+func (c *cachedConn) Read(b []byte) (int, error) {
+	if c.prefix.Len() > 0 {
+		return c.prefix.Read(b)
+	}
+	return c.Conn.Read(b)
+}
+func relayContext(ctx context.Context, a, b net.Conn) error {
+	stop := context.AfterFunc(ctx, func() { a.Close(); b.Close() })
+	defer stop()
+	done := make(chan error, 1)
+	go func() { _, err := io.Copy(a, b); closeWrite(a); done <- err }()
+	_, err := io.Copy(b, a)
+	closeWrite(b)
+	return joinCopyErrors(err, <-done)
+}
+
+func (c *cachedConn) Upstream() any { return c.Conn }
