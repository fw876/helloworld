+		return nil, "", fmt.Errorf("shadow-tls: write client handshake: %w", err)
+	}
+	serverHello, err := readFrame(handshakeConn)
+	if err != nil {
+		return nil, "", fmt.Errorf("shadow-tls: read server handshake: %w", err)
+	}
