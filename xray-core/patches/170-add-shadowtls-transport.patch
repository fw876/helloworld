+++ b/infra/conf/shadowtls.go
@@ -0,0 +1,48 @@
+package conf
+
+import (
+	"github.com/xtls/xray-core/transport/internet/shadowtls"
+	"os"
+)
+
+type ShadowTLSUser struct {
+	Name     string `json:"name"`
+	Password string `json:"password"`
+}
+type ShadowTLSConfig struct {
+	Version                uint32            `json:"version"`
+	Password               string            `json:"password"`
+	ServerName             string            `json:"serverName"`
+	Fingerprint            string            `json:"fingerprint"`
+	AllowInsecure          bool              `json:"allowInsecure"`
+	ALPN                   []string          `json:"alpn"`
+	CertificateFiles       []string          `json:"certificateFiles"`
+	StrictMode             bool              `json:"strictMode"`
+	Handshake              string            `json:"handshake"`
+	Users                  []ShadowTLSUser   `json:"users"`
+	HandshakeForServerName map[string]string `json:"handshakeForServerName"`
+	WildcardSNI            string            `json:"wildcardSni"`
+	HandshakeTimeout       uint32            `json:"handshakeTimeout"`
+}
+
+func (c *ShadowTLSConfig) Build() (*shadowtls.Config, error) {
+	version := c.Version
+	if version == 0 {
+		version = 3
+	}
+	cfg := &shadowtls.Config{Version: version, Password: c.Password, ServerName: c.ServerName, Fingerprint: c.Fingerprint, AllowInsecure: c.AllowInsecure, Alpn: c.ALPN, StrictMode: c.StrictMode, Handshake: c.Handshake, HandshakeForServerName: c.HandshakeForServerName, WildcardSni: c.WildcardSNI, HandshakeTimeout: c.HandshakeTimeout}
+	for _, u := range c.Users {
+		cfg.Users = append(cfg.Users, &shadowtls.User{Name: u.Name, Password: u.Password})
+	}
+	for _, file := range c.CertificateFiles {
+		pem, err := os.ReadFile(file)
+		if err != nil {
+			return nil, err
+		}
+		cfg.Certificates = append(cfg.Certificates, pem)
+	}
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+	return cfg, nil
+}
