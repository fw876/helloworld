+		_, _ = hmacAdd.Write(serverRandom)
+		_, _ = hmacAdd.Write([]byte("C"))
+		hmacVerify := hmac.New(sha1.New, []byte(c.password))
+		_, _ = hmacVerify.Write(serverRandom)
