@@ -0,0 +1,43 @@
+package kcptun
+
+import (
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/transport/internet"
+	protocol "github.com/xtls/xray-core/transport/internet/kcptun/protocol"
+)
+
+const protocolName = "kcptun"
+
+func (c *Config) Build() (protocol.Config, error) {
+	cfg := protocol.Config{
+		Key:          c.Key,
+		Crypt:        c.Crypt,
+		Mode:         c.Mode,
+		Conn:         int(c.Conn),
+		AutoExpire:   int(c.Autoexpire),
+		ScavengeTTL:  int(c.Scavengettl),
+		MTU:          int(c.Mtu),
+		RateLimit:    int(c.Ratelimit),
+		SndWnd:       int(c.Sndwnd),
+		RcvWnd:       int(c.Rcvwnd),
+		DataShard:    int(c.Datashard),
+		ParityShard:  int(c.Parityshard),
+		DSCP:         int(c.Dscp),
+		NoComp:       c.Nocomp,
+		AckNodelay:   c.Acknodelay,
+		NoDelay:      int(c.Nodelay),
+		Interval:     int(c.Interval),
+		Resend:       int(c.Resend),
+		NoCongestion: int(c.Nc),
+		SockBuf:      int(c.Sockbuf),
+		SmuxVer:      int(c.Smuxver),
+		SmuxBuf:      int(c.Smuxbuf),
+		FrameSize:    int(c.Framesize),
+		StreamBuf:    int(c.Streambuf),
+		KeepAlive:    int(c.Keepalive),
+	}
+	return protocol.Normalize(cfg)
+}
+func init() {
+	common.Must(internet.RegisterProtocolConfigCreator(protocolName, func() interface{} { return new(Config) }))
+}
