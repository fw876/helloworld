+package conf
+
+import "github.com/xtls/xray-core/transport/internet/kcptun"
+
+type KcptunConfig kcptun.Config
+
+func (c *KcptunConfig) Build() (*kcptun.Config, error) {
+	cfg := (*kcptun.Config)(c)
+	if _, err := cfg.Build(); err != nil {
+		return nil, err
+	}
+	return cfg, nil
+}
