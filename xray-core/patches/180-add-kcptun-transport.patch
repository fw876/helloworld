+package internet
+
+import (
+	"errors"
+	"io"
+	"sync"
+)
+
+// transportClients owns pooled transport connections for a single outbound.
+// Keeping ownership here prevents sharing credentials or sockets across outbounds.
+type transportClients struct {
+	mu     sync.Mutex
+	closed bool
+	values map[string]io.Closer
+}
+
+func (s *MemoryStreamConfig) TransportClient(key string, create func() (io.Closer, error)) (io.Closer, error) {
+	s.clients.mu.Lock()
+	defer s.clients.mu.Unlock()
+	if s.clients.closed {
+		return nil, io.ErrClosedPipe
+	}
+	if value := s.clients.values[key]; value != nil {
+		return value, nil
+	}
+	if len(s.clients.values) >= 256 {
+		return nil, errors.New("too many transport client destinations")
+	}
+	value, err := create()
+	if err != nil {
+		return nil, err
+	}
+	if s.clients.values == nil {
+		s.clients.values = make(map[string]io.Closer)
+	}
+	s.clients.values[key] = value
+	return value, nil
+}
+
+func (s *MemoryStreamConfig) Close() error {
+	if s == nil {
+		return nil
+	}
+	s.clients.mu.Lock()
+	s.clients.closed = true
+	values := s.clients.values
+	s.clients.values = nil
+	s.clients.mu.Unlock()
+	var result error
+	for _, value := range values {
+		result = errors.Join(result, value.Close())
+	}
+	if s.DownloadSettings != nil {
+		result = errors.Join(result, s.DownloadSettings.Close())
+	}
+	return result
+}
