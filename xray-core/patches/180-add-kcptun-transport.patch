@@ -0,0 +1,69 @@
+package kcptun
+
+import (
+	"fmt"
+	kcp "github.com/metacubex/kcp-go"
+	"github.com/metacubex/smux"
+	"time"
+)
+
+// Normalize preserves Mihomo defaults and rejects invalid settings before opening sockets.
+func Normalize(c Config) (Config, error) {
+	c.FillDefaults()
+	switch c.Crypt {
+	case "aes", "aes-128", "aes-192", "aes-128-gcm", "null", "none", "tea", "xor", "blowfish", "twofish", "cast5", "3des", "xtea", "salsa20":
+	default:
+		return c, fmt.Errorf("kcptun: unknown crypt %q", c.Crypt)
+	}
+	switch c.Mode {
+	case "normal", "fast", "fast2", "fast3", "manual":
+	default:
+		return c, fmt.Errorf("kcptun: unknown mode %q", c.Mode)
+	}
+	if c.Conn < 1 || c.Conn > 256 {
+		return c, fmt.Errorf("kcptun: conn must be 1..256")
+	}
+	if c.MTU < 256 || c.MTU > 1500 {
+		return c, fmt.Errorf("kcptun: mtu must be 256..1500")
+	}
+	if !(c.DataShard == -1 && c.ParityShard == -1) && (c.DataShard < 1 || c.ParityShard < 1 || c.DataShard+c.ParityShard > 256) {
+		return c, fmt.Errorf("kcptun: invalid FEC shard counts")
+	}
+	if c.SndWnd < 1 || c.RcvWnd < 1 || c.SndWnd > 65535 || c.RcvWnd > 65535 {
+		return c, fmt.Errorf("kcptun: invalid windows")
+	}
+	if c.AutoExpire < 0 || c.ScavengeTTL < 0 || c.RateLimit < 0 || c.SockBuf < 1 || c.SockBuf > 1<<28 || c.DSCP < 0 || c.DSCP > 63 {
+		return c, fmt.Errorf("kcptun: invalid socket or expiry settings")
+	}
+	if c.NoDelay < 0 || c.NoDelay > 1 || c.NoCongestion < 0 || c.NoCongestion > 1 || c.Interval < 1 || c.Interval > 5000 || c.Resend < 0 || c.Resend > 2 {
+		return c, fmt.Errorf("kcptun: invalid manual timing")
+	}
+	if c.KeepAlive < 1 || c.KeepAlive > 3600 || c.SmuxBuf > 1<<28 {
+		return c, fmt.Errorf("kcptun: invalid smux limits")
+	}
+	if err := smux.VerifyConfig(c.SmuxConfig()); err != nil {
+		return c, fmt.Errorf("kcptun: %w", err)
+	}
+	return c, nil
+}
+func (c *Config) SmuxConfig() *smux.Config {
+	cfg := smux.DefaultConfig()
+	cfg.Version = c.SmuxVer
+	cfg.MaxReceiveBuffer = c.SmuxBuf
+	cfg.MaxStreamBuffer = c.StreamBuf
+	cfg.MaxFrameSize = c.FrameSize
+	cfg.KeepAliveInterval = time.Duration(c.KeepAlive) * time.Second
+	if cfg.KeepAliveInterval >= cfg.KeepAliveTimeout {
+		cfg.KeepAliveTimeout = 3 * cfg.KeepAliveInterval
+	}
+	return cfg
+}
+func (c *Config) Apply(conn *kcp.UDPSession) {
+	conn.SetStreamMode(true)
+	conn.SetWriteDelay(false)
+	conn.SetNoDelay(c.NoDelay, c.Interval, c.Resend, c.NoCongestion)
+	conn.SetWindowSize(c.SndWnd, c.RcvWnd)
+	conn.SetMtu(c.MTU)
+	conn.SetACKNoDelay(c.AckNodelay)
+	conn.SetRateLimit(uint32(c.RateLimit))
+}
