+package kcptun
+
+import "net"
+
+// Kcptun carries a reliable stream; Xray's stream protocols expect TCP addresses.
+type streamConn struct{ net.Conn }
+
+func tcpAddr(addr net.Addr) net.Addr {
+	if udp, ok := addr.(*net.UDPAddr); ok {
+		return &net.TCPAddr{IP: udp.IP, Port: udp.Port, Zone: udp.Zone}
+	}
+	return addr
+}
+func (c *streamConn) LocalAddr() net.Addr  { return tcpAddr(c.Conn.LocalAddr()) }
+func (c *streamConn) RemoteAddr() net.Addr { return tcpAddr(c.Conn.RemoteAddr()) }
