+package kcptun
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/transport/internet"
+	protocol "github.com/xtls/xray-core/transport/internet/kcptun/protocol"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"io"
+	"net"
+)
+
+type connectedPacket struct{ net.Conn }
+
+func (c *connectedPacket) ReadFrom(b []byte) (int, net.Addr, error) {
+	n, err := c.Read(b)
+	return n, c.RemoteAddr(), err
+}
+func (c *connectedPacket) WriteTo(b []byte, _ net.Addr) (int, error) { return c.Write(b) }
+
+func Dial(ctx context.Context, dest xnet.Destination, settings *internet.MemoryStreamConfig) (stat.Connection, error) {
+	cfg, err := settings.ProtocolSettings.(*Config).Build()
+	if err != nil {
+		return nil, err
+	}
+	dest.Network = xnet.Network_UDP
+	key := "kcptun:" + dest.String()
+	if outbounds := session.OutboundsFromContext(ctx); len(outbounds) > 0 {
+		if gateway := outbounds[len(outbounds)-1].Gateway; gateway != nil {
+			key += "/" + gateway.String()
+		}
+	}
+	owner, err := settings.TransportClient(key, func() (io.Closer, error) { return protocol.NewClient(cfg) })
+	if err != nil {
+		return nil, err
+	}
+	stream, err := owner.(*protocol.Client).OpenStream(ctx, func(ctx context.Context) (net.PacketConn, net.Addr, error) {
+		var conn net.Conn
+		var err error
+		if settings.FinalMask != nil {
+			conn, err = settings.FinalMask.DialUDP(ctx, dest)
+		} else {
+			conn, err = internet.DialSystem(ctx, dest, settings.SocketSettings)
+		}
+		if err != nil {
+			return nil, nil, err
+		}
+		if pc, ok := conn.(*xnet.PacketConnWrapper); ok {
+			return pc.PacketConn, pc.Dest, nil
+		}
+		return &connectedPacket{Conn: conn}, conn.RemoteAddr(), nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return &streamConn{Conn: stream}, nil
+}
+func init() { common.Must(internet.RegisterTransportDialer(protocolName, Dial)) }
