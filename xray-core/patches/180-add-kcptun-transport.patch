+// Adapted from MetaCubeX/mihomo v1.19.32; GPL-3.0-or-later.
+package kcptun
+
+import (
+	"context"
+	kcp "github.com/metacubex/kcp-go"
+	"github.com/metacubex/smux"
+	"math/rand/v2"
+	"net"
+	"sync"
+	"time"
+)
+
+type DialFn func(context.Context) (net.PacketConn, net.Addr, error)
+type timedSession struct {
+	session *smux.Session
+	expiry  time.Time
+}
+type Client struct {
+	config   Config
+	block    kcp.BlockCrypt
+	ctx      context.Context
+	cancel   context.CancelFunc
+	done     chan struct{}
+	mu       sync.Mutex
+	slots    []timedSession
+	sessions map[*smux.Session]time.Time
+	next     int
+}
+
+func NewClient(cfg Config) (*Client, error) {
+	cfg, err := Normalize(cfg)
+	if err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	c := &Client{config: cfg, block: cfg.NewBlock(), ctx: ctx, cancel: cancel, done: make(chan struct{}), slots: make([]timedSession, cfg.Conn), sessions: make(map[*smux.Session]time.Time)}
+	go c.scavenge()
+	return c, nil
+}
+func (c *Client) Close() error { c.cancel(); <-c.done; return nil }
+func (c *Client) scavenge() {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	defer close(c.done)
+	for {
+		select {
+		case <-c.ctx.Done():
+			c.mu.Lock()
+			for session := range c.sessions {
+				session.Close()
+			}
+			clear(c.sessions)
+			c.mu.Unlock()
+			return
+		case now := <-ticker.C:
+			c.mu.Lock()
+			for session, expiry := range c.sessions {
+				if session.IsClosed() || (!expiry.IsZero() && now.After(expiry)) {
+					session.Close()
+					delete(c.sessions, session)
+				}
+			}
+			c.mu.Unlock()
+		}
+	}
+}
+func (c *Client) createConn(ctx context.Context, dial DialFn) (*smux.Session, error) {
+	pc, addr, err := dial(ctx)
+	if err != nil {
+		return nil, err
+	}
+	conn, err := kcp.NewConn4(rand.Uint32(), addr, c.block, c.config.DataShard, c.config.ParityShard, true, pc)
+	if err != nil {
+		pc.Close()
+		return nil, err
+	}
+	c.config.Apply(conn)
+	_ = conn.SetDSCP(c.config.DSCP)
+	_ = conn.SetReadBuffer(c.config.SockBuf)
+	_ = conn.SetWriteBuffer(c.config.SockBuf)
+	var raw net.Conn = conn
+	if !c.config.NoComp {
+		raw = NewCompStream(raw)
+	}
+	mux, err := smux.Client(raw, c.config.SmuxConfig())
+	if err != nil {
+		raw.Close()
+		return nil, err
+	}
+	return mux, nil
+}
+func (c *Client) OpenStream(ctx context.Context, dial DialFn) (*smux.Stream, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stop := context.AfterFunc(c.ctx, cancel)
+	defer stop()
+	c.mu.Lock()
+	if c.ctx.Err() != nil {
+		c.mu.Unlock()
+		return nil, net.ErrClosed
+	}
+	idx := c.next
+	c.next = (c.next + 1) % len(c.slots)
+	slot := &c.slots[idx]
+	if slot.session == nil || slot.session.IsClosed() || (c.config.AutoExpire > 0 && time.Now().After(slot.expiry)) {
+		mux, err := c.createConn(ctx, dial)
+		if err != nil {
+			c.mu.Unlock()
+			return nil, err
+		}
+		slot.session = mux
+		expiry := time.Time{}
+		if c.config.AutoExpire > 0 {
+			slot.expiry = time.Now().Add(time.Duration(c.config.AutoExpire) * time.Second)
+			expiry = slot.expiry.Add(time.Duration(c.config.ScavengeTTL) * time.Second)
+		}
+		c.sessions[mux] = expiry
+	}
+	mux := slot.session
+	c.mu.Unlock()
+	stream, err := mux.OpenStream()
+	if err != nil {
+		mux.Close()
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		stream.Close()
+		return nil, err
+	}
+	return stream, nil
+}
