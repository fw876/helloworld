@@ -0,0 +1,38 @@
+package kcptun
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	protocol "github.com/xtls/xray-core/transport/internet/kcptun/protocol"
+	"net"
+)
+
+func Listen(ctx context.Context, address xnet.Address, port xnet.Port, settings *internet.MemoryStreamConfig, handler internet.ConnHandler) (internet.Listener, error) {
+	if address.Family().IsDomain() || port == 0 {
+		return nil, errors.New("kcptun: UDP listener requires an IP and port")
+	}
+	cfg, err := settings.ProtocolSettings.(*Config).Build()
+	if err != nil {
+		return nil, err
+	}
+	var pc net.PacketConn
+	addr := &net.UDPAddr{IP: address.IP(), Port: int(port)}
+	if settings.FinalMask != nil {
+		pc, err = settings.FinalMask.ListenPacket(ctx, addr)
+	} else {
+		pc, err = internet.ListenSystemPacket(ctx, addr, settings.SocketSettings)
+	}
+	if err != nil {
+		return nil, err
+	}
+	server, err := protocol.NewServer(pc, cfg, func(conn net.Conn) { handler(&streamConn{Conn: conn}) })
+	if err != nil {
+		return nil, err
+	}
+	errors.LogInfo(ctx, "listening Kcptun on ", server.Addr())
+	return server, nil
+}
+func init() { common.Must(internet.RegisterTransportListener(protocolName, Listen)) }
