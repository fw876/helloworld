+// Adapted from MetaCubeX/mihomo v1.19.32; GPL-3.0-or-later.
+package kcptun
+
+import (
+	kcp "github.com/metacubex/kcp-go"
+	"github.com/metacubex/smux"
+	"net"
+	"sync"
+)
+
+type Server struct {
+	config      Config
+	listener    *kcp.Listener
+	pc          net.PacketConn
+	mu          sync.Mutex
+	closed      bool
+	connections map[*kcp.UDPSession]struct{}
+	wg          sync.WaitGroup
+	once        sync.Once
+}
+
+func NewServer(pc net.PacketConn, cfg Config, handler func(net.Conn)) (*Server, error) {
+	cfg, err := Normalize(cfg)
+	if err != nil {
+		pc.Close()
+		return nil, err
+	}
+	listener, err := kcp.ServeConn(cfg.NewBlock(), cfg.DataShard, cfg.ParityShard, pc)
+	if err != nil {
+		pc.Close()
+		return nil, err
+	}
+	_ = listener.SetDSCP(cfg.DSCP)
+	_ = listener.SetReadBuffer(cfg.SockBuf)
+	_ = listener.SetWriteBuffer(cfg.SockBuf)
+	s := &Server{config: cfg, listener: listener, pc: pc, connections: make(map[*kcp.UDPSession]struct{})}
+	s.wg.Add(1)
+	go s.serve(handler)
+	return s, nil
+}
+func (s *Server) Addr() net.Addr { return s.pc.LocalAddr() }
+func (s *Server) Close() error {
+	s.once.Do(func() {
+		s.mu.Lock()
+		s.closed = true
+		s.listener.Close()
+		s.pc.Close()
+		for conn := range s.connections {
+			conn.Close()
+		}
+		s.mu.Unlock()
+	})
+	s.wg.Wait()
+	return nil
+}
+func (s *Server) serve(handler func(net.Conn)) {
+	defer s.wg.Done()
+	for {
+		conn, err := s.listener.AcceptKCP()
+		if err != nil {
+			return
+		}
+		s.mu.Lock()
+		if s.closed {
+			s.mu.Unlock()
+			conn.Close()
+			return
+		}
+		s.connections[conn] = struct{}{}
+		s.wg.Add(1)
+		s.mu.Unlock()
+		go s.serveConn(conn, handler)
+	}
+}
+func (s *Server) serveConn(conn *kcp.UDPSession, handler func(net.Conn)) {
+	defer s.wg.Done()
+	defer func() { conn.Close(); s.mu.Lock(); delete(s.connections, conn); s.mu.Unlock() }()
+	s.config.Apply(conn)
+	var raw net.Conn = conn
+	if !s.config.NoComp {
+		raw = NewCompStream(raw)
+	}
+	mux, err := smux.Server(raw, s.config.SmuxConfig())
+	if err != nil {
+		return
+	}
+	defer mux.Close()
+	for {
+		stream, err := mux.AcceptStream()
+		if err != nil {
+			return
+		}
+		go handler(stream)
+	}
+}
