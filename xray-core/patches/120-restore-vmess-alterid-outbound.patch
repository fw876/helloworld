+package conf_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/xtls/xray-core/infra/conf"
+	"github.com/xtls/xray-core/proxy/vmess"
+	"github.com/xtls/xray-core/proxy/vmess/outbound"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestVMessAlterIDConfig(t *testing.T) {
+	for _, aid := range []int{0, 1, 64} {
+		for _, flat := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%d/flat=%v", aid, flat), func(t *testing.T) {
+				fields := fmt.Sprintf(`"id":"e641f5ad-9397-41e3-bf1a-e8740dfed019","alterId":%d`, aid)
+				raw := `{"address":"127.0.0.1","port":443,` + fields + `}`
+				if !flat {
+					raw = `{"vnext":[{"address":"127.0.0.1","port":443,"users":[{` + fields + `}]}]}`
+				}
+				var config conf.VMessOutboundConfig
+				if err := json.Unmarshal([]byte(raw), &config); err != nil {
+					t.Fatal(err)
+				}
+				message, err := config.Build()
+				if err != nil {
+					t.Fatal(err)
+				}
+				user, err := message.(*outbound.Config).Receiver.User.ToMemoryUser()
+				if err != nil {
+					t.Fatal(err)
+				}
+				account := user.Account.(*vmess.MemoryAccount)
+				if len(account.AlterIDs) != aid {
+					t.Fatalf("lost alterId: %d", len(account.AlterIDs))
+				}
+				wire, err := proto.Marshal(account.ToProto())
+				if err != nil {
+					t.Fatal(err)
+				}
+				var decoded vmess.Account
+				if err = proto.Unmarshal(wire, &decoded); err != nil {
+					t.Fatal(err)
+				}
+				if decoded.AlterId != uint32(aid) {
+					t.Fatal("protobuf round trip lost alterId")
+				}
+			})
+		}
+	}
+	for _, raw := range []string{`{"alterId":-1}`, `{"alterId":65536}`, `{"alterId":1.5}`} {
+		var c conf.VMessOutboundConfig
+		if err := json.Unmarshal([]byte(raw), &c); err == nil {
+			t.Fatalf("accepted %s", raw)
+		}
+	}
+	if _, err := (&vmess.Account{Id: "e641f5ad-9397-41e3-bf1a-e8740dfed019", AlterId: 65536}).AsAccount(); err == nil {
+		t.Fatal("accepted oversized protobuf alterId")
+	}
+	var inbound conf.VMessInboundConfig
+	if err := json.Unmarshal([]byte(`{"clients":[{"id":"e641f5ad-9397-41e3-bf1a-e8740dfed019","alterId":1}]}`), &inbound); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := inbound.Build(); err == nil {
+		t.Fatal("silently accepted unsupported legacy inbound")
+	}
+}
