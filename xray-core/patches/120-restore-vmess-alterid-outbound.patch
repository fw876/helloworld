+// AnyValidID chooses an authentication ID without changing the primary command key.
+func (a *MemoryAccount) AnyValidID() *protocol.ID {
+	if len(a.AlterIDs) == 0 {
+		return a.ID
+	}
+	return a.AlterIDs[dice.Roll(len(a.AlterIDs))]
+}
+
+// newAlterIDs follows the original VMess alternative UUID derivation.
+func newAlterIDs(previous uuid.UUID, count uint32) []*protocol.ID {
+	if count == 0 {
+		return nil
+	}
+	ids := make([]*protocol.ID, count)
+	for i := range ids {
+		h := md5.New()
+		h.Write(previous.Bytes())
+		h.Write([]byte("16167dc8-16b6-4e6d-b8bb-65dd68113a81"))
+		var next uuid.UUID
+		for {
+			h.Sum(next[:0])
+			if !bytes.Equal(next.Bytes(), previous.Bytes()) {
+				break
+			}
+			h.Write([]byte("533eff8a-4113-4b10-b5ce-0f5d76b98cd2"))
+		}
+		ids[i] = protocol.NewID(next)
+		previous = next
+	}
+	return ids
+}
