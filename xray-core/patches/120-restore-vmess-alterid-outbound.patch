+func TestLegacyVMessTCPAndUDP(t *testing.T) {
+	for _, security := range []protocol.SecurityType{protocol.SecurityType_AES128_GCM, protocol.SecurityType_CHACHA20_POLY1305} {
+		for _, command := range []protocol.RequestCommand{protocol.RequestCommandTCP, protocol.RequestCommandUDP} {
+			t.Run(fmt.Sprintf("%v/%v", security, command), func(t *testing.T) {
+				c, req, header := legacyRequest(t, security, command)
+				server := &ServerSession{}
+				copy(server.requestBodyIV[:], header[1:17])
+				copy(server.requestBodyKey[:], header[17:33])
+				server.responseBodyKey = md5.Sum(header[17:33])
+				server.responseBodyIV = md5.Sum(header[1:17])
+				var upload, download bytes.Buffer
+				writer, err := c.EncodeRequestBody(req, &upload)
+				if err != nil {
+					t.Fatal(err)
+				}
+				payload := bytes.Repeat([]byte("legacy vmess packet "), 40)
+				if err = writer.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes(payload)}); err != nil {
+					t.Fatal(err)
+				}
+				reader, err := server.DecodeRequestBody(req, &upload)
+				if err != nil {
+					t.Fatal(err)
+				}
+				assertPacket(t, reader, payload)
+				response := []byte{header[33], 0, 0, 0}
+				block, err := aes.NewCipher(server.responseBodyKey[:])
+				if err != nil {
+					t.Fatal(err)
+				}
+				cipher.NewCFBEncrypter(block, server.responseBodyIV[:]).XORKeyStream(response, response)
+				download.Write(response)
+				writer, err = server.EncodeResponseBody(req, &download)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = writer.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes(payload)}); err != nil {
+					t.Fatal(err)
+				}
+				if _, err = c.DecodeResponseHeader(&download); err != nil {
+					t.Fatal(err)
+				}
+				reader, err = c.DecodeResponseBody(req, &download)
+				if err != nil {
+					t.Fatal(err)
+				}
+				assertPacket(t, reader, payload)
+			})
+		}
+	}
+}
+
+func assertPacket(t *testing.T, r buf.Reader, want []byte) {
+	t.Helper()
+	b, err := r.ReadMultiBuffer()
+	defer buf.ReleaseMulti(b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []byte
+	for _, part := range b {
+		got = append(got, part.Bytes()...)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatal("payload mismatch")
+	}
+}
+
+func TestLegacyResponseRejectsInvalidHeader(t *testing.T) {
+	for _, truncated := range []bool{false, true} {
+		c, _, header := legacyRequest(t, protocol.SecurityType_AES128_GCM, protocol.RequestCommandTCP)
+		response := []byte{header[33] ^ 1, 0, 0, 0}
+		block, _ := aes.NewCipher(c.responseBodyKey[:])
+		cipher.NewCFBEncrypter(block, c.responseBodyIV[:]).XORKeyStream(response, response)
+		if truncated {
+			response = response[:2]
+		}
+		if _, err := c.DecodeResponseHeader(bytes.NewReader(response)); err == nil {
+			t.Fatal("accepted invalid response")
+		}
+	}
+}
