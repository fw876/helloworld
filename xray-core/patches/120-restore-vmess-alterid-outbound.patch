+type failedLegacyWriter struct{}
+
+func (failedLegacyWriter) Write([]byte) (int, error) { return 0, io.ErrClosedPipe }
+func TestLegacyRequestWriteError(t *testing.T) {
+	c, req, _ := legacyRequest(t, protocol.SecurityType_AES128_GCM, protocol.RequestCommandTCP)
+	if err := c.EncodeRequestHeader(req, failedLegacyWriter{}); err != io.ErrClosedPipe {
+		t.Fatalf("got %v", err)
+	}
+}
