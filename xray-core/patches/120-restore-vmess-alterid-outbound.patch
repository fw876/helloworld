+
+func legacyRequest(t *testing.T, security protocol.SecurityType, command protocol.RequestCommand) (*ClientSession, *protocol.RequestHeader, []byte) {
+	t.Helper()
+	a, err := (&vmess.Account{Id: "e641f5ad-9397-41e3-bf1a-e8740dfed019", AlterId: 1}).AsAccount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := &protocol.RequestHeader{Version: 1, User: &protocol.MemoryUser{Account: a}, Command: command, Address: net.DomainAddress("example.com"), Port: 443, Security: security, Option: protocol.RequestOptionChunkStream | protocol.RequestOptionChunkMasking | protocol.RequestOptionGlobalPadding}
+	c := NewClientSession(context.Background(), 0, true)
+	var wire bytes.Buffer
+	if err := c.EncodeRequestHeader(req, &wire); err != nil {
+		t.Fatal(err)
+	}
+	raw := wire.Bytes()
+	// Independently recover the timestamp from the legacy HMAC-MD5 authenticator.
+	var stamp [8]byte
+	found := false
+	for ts := time.Now().Unix() - 35; ts <= time.Now().Unix()+35; ts++ {
+		binary.BigEndian.PutUint64(stamp[:], uint64(ts))
+		auth := hmac.New(md5.New, a.(*vmess.MemoryAccount).AlterIDs[0].Bytes())
+		auth.Write(stamp[:])
+		if hmac.Equal(auth.Sum(nil), raw[:16]) {
+			found = true
+			break
+		}
+	}
+	if !found {
+		t.Fatal("legacy authentication ID or timestamp mismatch")
+	}
+	iv := md5.Sum(bytes.Repeat(stamp[:], 4))
+	block, err := aes.NewCipher(a.(*vmess.MemoryAccount).ID.CmdKey())
+	if err != nil {
+		t.Fatal(err)
+	}
+	header := append([]byte(nil), raw[16:]...)
+	cipher.NewCFBDecrypter(block, iv[:]).XORKeyStream(header, header)
+	h := fnv.New32a()
+	h.Write(header[:len(header)-4])
+	if binary.BigEndian.Uint32(header[len(header)-4:]) != h.Sum32() {
+		t.Fatal("invalid request header checksum")
+	}
+	if header[0] != 1 || header[37] != byte(command) || header[35]&15 != byte(security) {
+		t.Fatal("invalid request header fields")
+	}
+	return c, req, header
+}
