+package naive
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/base64"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet"
+	nt "github.com/xtls/xray-core/transport/internet/naive"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+type Server struct {
+	config *ServerConfig
+	policy policy.Session
+}
+
+func NewServer(ctx context.Context, c *ServerConfig) (*Server, error) {
+	settings, _ := session.StreamSettingsFromContext(ctx).(*internet.MemoryStreamConfig)
+	if settings == nil || settings.ProtocolName != "naive" {
+		return nil, errors.New("naive inbound requires naive transport")
+	}
+	if len(c.Users) == 0 {
+		return nil, errors.New("naive requires users")
+	}
+	return &Server{config: c, policy: core.MustFromContext(ctx).GetFeature(policy.ManagerType()).(policy.Manager).ForLevel(c.Level)}, nil
+}
+func (*Server) Network() []net.Network { return []net.Network{net.Network_TCP} }
+func (s *Server) Process(ctx context.Context, _ net.Network, conn stat.Connection, d routing.Dispatcher) error {
+	c, ok := stat.TryUnwrapStatsConn(conn).(*nt.Conn)
+	if !ok {
+		return errors.New("naive requires HTTP CONNECT transport")
+	}
+	defer c.Finish()
+	r := c.Request
+	if r.Method != http.MethodConnect || r.Header.Get("Padding") == "" {
+		c.Respond(400, "")
+		return errors.New("invalid naive CONNECT")
+	}
+	raw, e := base64.StdEncoding.DecodeString(strings.TrimPrefix(r.Header.Get("Proxy-Authorization"), "Basic "))
+	user, pass, valid := strings.Cut(string(raw), ":")
+	auth := 0
+	if e == nil && valid && strings.HasPrefix(r.Header.Get("Proxy-Authorization"), "Basic ") {
+		for _, a := range s.config.Users {
+			auth |= subtle.ConstantTimeCompare([]byte(user), []byte(a.Username)) & subtle.ConstantTimeCompare([]byte(pass), []byte(a.Password))
+		}
+	}
+	if auth != 1 {
+		c.Respond(407, "")
+		return errors.New("naive authentication failed")
+	}
+	host := r.Header.Get("-connect-authority")
+	if host == "" {
+		host = r.Host
+	}
+	dest, e := net.ParseDestination("tcp:" + host)
+	if e != nil || dest.Address == nil {
+		c.Respond(400, "")
+		return errors.New("invalid CONNECT authority")
+	}
+	isUOT := dest.Address.String() == uot.MagicAddress || dest.Address.String() == uot.LegacyMagicAddress
+	if dest.Port == 0 && !isUOT {
+		c.Respond(400, "")
+		return errors.New("invalid CONNECT port")
+	}
+	// HTTP/2 requests share a physical connection: copy session state per stream.
+	if in := session.InboundFromContext(ctx); in != nil {
+		copyIn := *in
+		copyIn.Name = "naive"
+		copyIn.CanSpliceCopy = 3
+		copyIn.User = &protocol.MemoryUser{Email: user, Level: s.config.Level}
+		ctx = session.ContextWithInbound(ctx, &copyIn)
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stop := context.AfterFunc(r.Context(), cancel)
+	defer stop()
+	if e = c.Respond(200, generatePaddingHeader()); e != nil {
+		return e
+	}
+	padded := &paddingConn{Conn: conn}
+	var reader buf.Reader = buf.NewReader(padded)
+	var writer buf.Writer = buf.NewWriter(padded)
+	if isUOT {
+		req := &uot.Request{}
+		if dest.Address.String() == uot.MagicAddress {
+			req, e = uot.ReadRequest(padded)
+			if e != nil {
+				return e
+			}
+		}
+		pc := uot.NewConn(padded, *req)
+		reader = &packetReader{conn: pc}
+		writer = &packetWriter{conn: pc, destination: req.Destination}
+		dest = net.UDPDestination(net.ParseAddress("127.0.0.1"), 1)
+		if req.Destination.IsValid() {
+			dest = net.UDPDestination(net.ParseAddress(req.Destination.AddrString()), net.Port(req.Destination.Port))
+		}
+	}
+	link, err := d.Dispatch(ctx, dest)
+	if err != nil {
+		return err
+	}
+	return relay(ctx, reader, link.Writer, link.Reader, writer, padded, s.policy)
+}
+func init() {
+	common.Must(common.RegisterConfig((*ServerConfig)(nil), func(ctx context.Context, c interface{}) (interface{}, error) {
+		return NewServer(ctx, c.(*ServerConfig))
+	}))
+}
