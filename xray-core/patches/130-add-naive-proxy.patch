@@ -0,0 +1,87 @@
+package conf
+
+import (
+	"encoding/base64"
+	"fmt"
+	"github.com/xtls/xray-core/proxy/naive"
+	"golang.org/x/net/http/httpguts"
+	"google.golang.org/protobuf/proto"
+	"os"
+	"strings"
+)
+
+type NaiveAccount struct {
+	Username string `json:"username"`
+	Password string `json:"password"`
+}
+type NaiveServerConfig struct {
+	Users []NaiveAccount `json:"users"`
+	Level uint32         `json:"level"`
+}
+
+func (c *NaiveServerConfig) Build() (proto.Message, error) {
+	if len(c.Users) == 0 {
+		return nil, fmt.Errorf("naive: users required")
+	}
+	out := &naive.ServerConfig{Level: c.Level}
+	seen := map[string]bool{}
+	for _, u := range c.Users {
+		if u.Username == "" || strings.Contains(u.Username, ":") || u.Password == "" || seen[u.Username] {
+			return nil, fmt.Errorf("naive: invalid or duplicate user")
+		}
+		seen[u.Username] = true
+		out.Users = append(out.Users, &naive.Account{Username: u.Username, Password: u.Password})
+	}
+	return out, nil
+}
+
+type NaiveClientConfig struct {
+	Address                  *Address          `json:"address"`
+	Port                     uint16            `json:"port"`
+	Username                 string            `json:"username"`
+	Password                 string            `json:"password"`
+	ServerName               string            `json:"serverName"`
+	Certificate              []string          `json:"certificate"`
+	CertificateFile          string            `json:"certificateFile"`
+	QUIC                     bool              `json:"quic"`
+	UDPOverTCP               bool              `json:"udpOverTcp"`
+	Level                    uint32            `json:"level"`
+	InsecureConcurrency      uint32            `json:"insecureConcurrency"`
+	ExtraHeaders             map[string]string `json:"extraHeaders"`
+	ReceiveWindow            uint64            `json:"receiveWindow"`
+	QUICCongestionControl    string            `json:"quicCongestionControl"`
+	QUICSessionReceiveWindow uint64            `json:"quicSessionReceiveWindow"`
+	ECHConfigList            string            `json:"echConfigList"`
+}
+
+func (c *NaiveClientConfig) Build() (proto.Message, error) {
+	if c.Address == nil || c.Port == 0 || c.Username == "" || strings.Contains(c.Username, ":") || c.Password == "" {
+		return nil, fmt.Errorf("naive: address, port, username and password required")
+	}
+	switch c.QUICCongestionControl {
+	case "", "bbr", "bbr2", "cubic", "reno":
+	default:
+		return nil, fmt.Errorf("naive: invalid QUIC congestion control")
+	}
+	for k, v := range c.ExtraHeaders {
+		if !httpguts.ValidHeaderFieldName(k) || !httpguts.ValidHeaderFieldValue(v) || strings.ContainsAny(k+v, "\r\n") || strings.EqualFold(k, "Proxy-Authorization") || strings.EqualFold(k, "Padding") || strings.EqualFold(k, "Host") {
+			return nil, fmt.Errorf("naive: invalid or reserved extra header %q", k)
+		}
+	}
+	cert := strings.Join(c.Certificate, "\n")
+	if c.CertificateFile != "" {
+		if cert != "" {
+			return nil, fmt.Errorf("naive: specify certificate or certificateFile")
+		}
+		b, e := os.ReadFile(c.CertificateFile)
+		if e != nil {
+			return nil, e
+		}
+		cert = string(b)
+	}
+	ech, e := base64.StdEncoding.DecodeString(c.ECHConfigList)
+	if e != nil {
+		return nil, fmt.Errorf("naive: invalid ECH config: %w", e)
+	}
+	return &naive.ClientConfig{Address: c.Address.Build(), Port: uint32(c.Port), Username: c.Username, Password: c.Password, ServerName: c.ServerName, TrustedRootCertificates: cert, Quic: c.QUIC, UdpOverTcp: c.UDPOverTCP, Level: c.Level, Concurrency: c.InsecureConcurrency, ExtraHeaders: c.ExtraHeaders, ReceiveWindow: c.ReceiveWindow, QuicCongestionControl: c.QUICCongestionControl, QuicSessionReceiveWindow: c.QUICSessionReceiveWindow, EchConfigList: ech}, nil
+}
