+// Adapted from sing-box protocol/naive/inbound_conn.go (GPL-3.0-or-later).
+package naive
+
+import (
+	"encoding/binary"
+	"io"
+	"math/rand"
+	"net"
+)
+
+const paddingCount = 8
+
+func generatePaddingHeader() string {
+	p := make([]byte, 30+rand.Intn(32))
+	bits := rand.Uint64()
+	for i := range 16 {
+		p[i] = "!#$()+<>?@[]^`{}"[bits&15]
+		bits >>= 4
+	}
+	for i := 16; i < len(p); i++ {
+		p[i] = '~'
+	}
+	return string(p)
+}
+
+type paddingConn struct {
+	net.Conn
+	readPadding, writePadding, remaining, skip int
+}
+
+func (c *paddingConn) Read(p []byte) (int, error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	for {
+		if c.remaining > 0 {
+			if len(p) > c.remaining {
+				p = p[:c.remaining]
+			}
+			n, e := c.Conn.Read(p)
+			c.remaining -= n
+			if e == io.EOF && c.remaining > 0 {
+				e = io.ErrUnexpectedEOF
+			}
+			return n, e
+		}
+		if c.skip > 0 {
+			_, e := io.CopyN(io.Discard, c.Conn, int64(c.skip))
+			if e != nil {
+				if e == io.EOF {
+					e = io.ErrUnexpectedEOF
+				}
+				return 0, e
+			}
+			c.skip = 0
+		}
+		if c.readPadding >= paddingCount {
+			return c.Conn.Read(p)
+		}
+		var h [3]byte
+		if _, e := io.ReadFull(c.Conn, h[:]); e != nil {
+			return 0, e
+		}
+		c.remaining = int(binary.BigEndian.Uint16(h[:2]))
+		c.skip = int(h[2])
+		c.readPadding++
+	}
+}
+func (c *paddingConn) Write(p []byte) (n int, err error) {
+	for len(p) > 0 {
+		if c.writePadding >= paddingCount {
+			k, e := c.Conn.Write(p)
+			return n + k, e
+		}
+		k := min(len(p), 65535)
+		pad := rand.Intn(256)
+		frame := make([]byte, 3+k+pad)
+		binary.BigEndian.PutUint16(frame[:2], uint16(k))
+		frame[2] = byte(pad)
+		copy(frame[3:], p[:k])
+		written, e := c.Conn.Write(frame)
+		if e == nil && written != len(frame) {
+			e = io.ErrShortWrite
+		}
+		if e != nil {
+			return n, e
+		}
+		c.writePadding++
+		n += k
+		p = p[k:]
+	}
+	return
+}
