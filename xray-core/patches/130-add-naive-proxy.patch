+// Naive HTTP CONNECT transport. Protocol authentication belongs to proxy/naive.
+package naive
+
+import (
+	"bufio"
+	"context"
+	"crypto/tls"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/apernet/quic-go/http3"
+	"github.com/xtls/xray-core/common"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	xtls "github.com/xtls/xray-core/transport/internet/tls"
+	"golang.org/x/net/http2"
+)
+
+type Conn struct {
+	Request   *http.Request
+	writer    http.ResponseWriter
+	done      chan struct{}
+	once      sync.Once
+	closeOnce sync.Once
+	local     net.Addr
+	raw       net.Conn
+	buffered  *bufio.ReadWriter
+}
+
+func (c *Conn) Respond(status int, padding string) error {
+	if padding != "" {
+		c.writer.Header().Set("Padding", padding)
+	}
+	c.writer.WriteHeader(status)
+	if err := http.NewResponseController(c.writer).Flush(); err != nil {
+		return err
+	}
+	if c.Request.ProtoMajor == 1 && status == 200 {
+		var err error
+		c.raw, c.buffered, err = http.NewResponseController(c.writer).Hijack()
+		return err
+	}
+	return nil
+}
+
+func (c *Conn) Read(p []byte) (int, error) {
+	if c.raw != nil {
+		return c.buffered.Read(p)
+	}
+	return c.Request.Body.Read(p)
+}
+
+func (c *Conn) Write(p []byte) (int, error) {
+	if c.raw != nil {
+		return c.raw.Write(p)
+	}
+	n, err := c.writer.Write(p)
+	if err == nil {
+		err = http.NewResponseController(c.writer).Flush()
+	}
+	return n, err
+}
+func (c *Conn) Close() error {
+	c.closeOnce.Do(func() {
+		if c.raw != nil {
+			c.raw.Close()
+			return
+		}
+		c.SetReadDeadline(time.Now())
+		c.Request.Body.Close()
+		c.SetWriteDeadline(time.Now())
+	})
+	return nil
+}
+func (c *Conn) Finish() { c.Close(); c.once.Do(func() { close(c.done) }) }
+
+func (c *Conn) LocalAddr() net.Addr { return c.local }
+func (c *Conn) RemoteAddr() net.Addr {
+	a, _ := net.ResolveTCPAddr("tcp", c.Request.RemoteAddr)
+	return a
+}
+func (c *Conn) SetReadDeadline(t time.Time) error {
+	if c.raw != nil {
+		return c.raw.SetReadDeadline(t)
+	}
+	return http.NewResponseController(c.writer).SetReadDeadline(t)
+}
+func (c *Conn) SetWriteDeadline(t time.Time) error {
+	if c.raw != nil {
+		return c.raw.SetWriteDeadline(t)
+	}
+	return http.NewResponseController(c.writer).SetWriteDeadline(t)
+}
+func (c *Conn) SetDeadline(t time.Time) error {
+	return errors.Join(c.SetReadDeadline(t), c.SetWriteDeadline(t))
+}
+
+type Listener struct {
+	tcp    net.Listener
+	udp    net.PacketConn
+	h2     *http.Server
+	h3     *http3.Server
+	add    internet.ConnHandler
+	ctx    context.Context
+	cancel context.CancelFunc
+	addr   net.Addr
+}
+
+func (l *Listener) Addr() net.Addr { return l.addr }
+func (l *Listener) Close() error {
+	l.cancel()
+	if l.h2 != nil {
+		l.h2.Close()
+	}
+	if l.h3 != nil {
+		l.h3.Close()
+	}
+	if l.tcp != nil {
+		l.tcp.Close()
+	}
+	if l.udp != nil {
+		l.udp.Close()
+	}
+	return nil
+}
+func (l *Listener) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+
+	c := &Conn{Request: r, writer: w, done: make(chan struct{}), local: l.addr}
+	l.add(c)
+	select {
+	case <-c.done:
+	case <-r.Context().Done():
+		r.Body.Close()
+		<-c.done
+	case <-l.ctx.Done():
+		r.Body.Close()
+		<-c.done
+	}
+}
+func Listen(ctx context.Context, address xnet.Address, port xnet.Port, settings *internet.MemoryStreamConfig, add internet.ConnHandler) (internet.Listener, error) {
+	tc := xtls.ConfigFromStreamSettings(settings)
+	if tc == nil {
+		return nil, errors.New("naive transport requires TLS")
+	}
+	if address.Family().IsDomain() {
+		return nil, errors.New("naive listen address must be an IP")
+	}
+	l := &Listener{add: add, addr: &net.TCPAddr{IP: address.IP(), Port: int(port)}}
+	l.ctx, l.cancel = context.WithCancel(ctx)
+	h2 := len(tc.NextProtocol) == 0 || slices.Contains(tc.NextProtocol, "h2") || slices.Contains(tc.NextProtocol, "http/1.1")
+	h3 := slices.Contains(tc.NextProtocol, "h3")
+	if !h2 && !h3 {
+		l.Close()
+		return nil, errors.New("naive ALPN must include h2 or h3")
+	}
+	if h2 {
+		raw, err := internet.ListenSystem(ctx, l.addr, settings.SocketSettings)
+		if err != nil {
+			l.Close()
+			return nil, err
+		}
+		cfg := tc.GetTLSConfig()
+		cfg.NextProtos = []string{"h2", "http/1.1"}
+		l.tcp = tls.NewListener(raw, cfg)
+		l.h2 = &http.Server{Handler: l, ReadHeaderTimeout: 15 * time.Second, BaseContext: func(net.Listener) context.Context { return l.ctx }}
+		if err = http2.ConfigureServer(l.h2, &http2.Server{}); err != nil {
+			l.Close()
+			return nil, err
+		}
+		go l.h2.Serve(l.tcp)
+	}
+	if h3 {
+		pc, err := internet.ListenSystemPacket(ctx, &net.UDPAddr{IP: address.IP(), Port: int(port)}, settings.SocketSettings)
+		if err != nil {
+			l.Close()
+			return nil, err
+		}
+		l.udp = pc
+		cfg := tc.GetTLSConfig()
+		cfg.NextProtos = []string{"h3"}
+		l.h3 = &http3.Server{Handler: l, TLSConfig: cfg}
+		go l.h3.Serve(pc)
+	}
+	return l, nil
+}
+
+var _ io.ReadWriteCloser = (*Conn)(nil)
+
+func init() {
+	common.Must(internet.RegisterProtocolConfigCreator("naive", func() interface{} { return &Config{} }))
+	common.Must(internet.RegisterTransportListener("naive", Listen))
+}
