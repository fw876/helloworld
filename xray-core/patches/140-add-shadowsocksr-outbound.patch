+package pool
+
+import (
+	"bytes"
+	"sync"
+)
+
+const RelayBufferSize = 32 * 1024
+
+var buffers = sync.Pool{New: func() any { return new(bytes.Buffer) }}
+var packets = sync.Pool{New: func() any { return make([]byte, 65536) }}
+
+func Get(n int) []byte {
+	if n > 65536 {
+		return make([]byte, n)
+	}
+	return packets.Get().([]byte)[:n]
+}
+func Put(b []byte) {
+	if cap(b) == 65536 {
+		clear(b[:cap(b)])
+		packets.Put(b[:cap(b)])
+	}
+}
+func GetBuffer() *bytes.Buffer { return buffers.Get().(*bytes.Buffer) }
+func PutBuffer(b *bytes.Buffer) {
+	b.Reset()
+	if b.Cap() <= 65536 {
+		buffers.Put(b)
+	}
+}
