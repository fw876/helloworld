+// SPDX-License-Identifier: GPL-3.0-or-later
+// Adapted from MetaCubeX/mihomo v1.19.32.
+package protocol
+
+import (
+	"bytes"
+	"io"
+	"net"
+
+	"github.com/xtls/xray-core/proxy/shadowsocksr/pool"
+)
+
+type Conn struct {
+	net.Conn
+	Protocol
+	decoded      bytes.Buffer
+	underDecoded bytes.Buffer
+	readErr      error
+}
+
+func (c *Conn) Read(b []byte) (int, error) {
+	if len(b) == 0 {
+		return 0, nil
+	}
+	for c.decoded.Len() == 0 {
+		if c.readErr != nil {
+			if c.underDecoded.Len() > 0 && c.readErr == io.EOF {
+				return 0, io.ErrUnexpectedEOF
+			}
+			return 0, c.readErr
+		}
+		data := pool.Get(pool.RelayBufferSize)
+		n, err := c.Conn.Read(data)
+		c.readErr = err
+		c.underDecoded.Write(data[:n])
+		pool.Put(data)
+		if err := c.Decode(&c.decoded, &c.underDecoded); err != nil {
+			return 0, err
+		}
+	}
+	return c.decoded.Read(b)
+}
+
+func (c *Conn) Write(b []byte) (int, error) {
+	bLength := len(b)
+	buf := pool.GetBuffer()
+	defer pool.PutBuffer(buf)
+	err := c.Encode(buf, b)
+	if err != nil {
+		return 0, err
+	}
+	n, err := c.Conn.Write(buf.Bytes())
+	if err == nil && n != buf.Len() {
+		err = io.ErrShortWrite
+	}
+	if err != nil {
+		return 0, err
+	}
+	return bLength, nil
+}
