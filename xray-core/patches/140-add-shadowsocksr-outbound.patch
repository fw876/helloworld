+++ b/proxy/shadowsocksr/client.go
@@ -0,0 +1,136 @@
+package shadowsocksr
+
+import (
+	"context"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/common/task"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	C "github.com/xtls/xray-core/proxy/shadowsocksr/cipher"
+	O "github.com/xtls/xray-core/proxy/shadowsocksr/obfs"
+	P "github.com/xtls/xray-core/proxy/shadowsocksr/protocol"
+	"github.com/xtls/xray-core/proxy/shadowsocksr/shadowstream"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+type Client struct {
+	server   net.Destination
+	policy   policy.Session
+	cipher   C.Cipher
+	obfs     O.Obfs
+	protocol P.Protocol
+}
+
+// Validate checks the same cipher, protocol and obfuscation registry used at runtime.
+func Validate(config *ClientConfig) error { _, err := newClient(config); return err }
+func newClient(config *ClientConfig) (*Client, error) {
+	if config.Address == nil || config.Port == 0 || config.Port > 65535 || config.Password == "" {
+		return nil, errors.New("shadowsocksr: invalid server or password")
+	}
+	cipher, err := C.PickCipher(config.Method, nil, config.Password)
+	if err != nil {
+		return nil, err
+	}
+	key := C.Kdf(config.Password, 16)
+	ivSize := 0
+	if stream, ok := cipher.(*C.StreamCipher); ok {
+		key = stream.Key
+		ivSize = stream.IVSize()
+	}
+	obfs, overhead, err := O.PickObfs(config.Obfs, &O.Base{Host: config.Address.AsAddress().String(), Port: int(config.Port), Key: key, IVSize: ivSize, Param: config.ObfsParam})
+	if err != nil {
+		return nil, err
+	}
+	protocol, err := P.PickProtocol(config.Protocol, &P.Base{Key: key, Overhead: overhead, Param: config.ProtocolParam})
+	if err != nil {
+		return nil, err
+	}
+	return &Client{server: net.TCPDestination(config.Address.AsAddress(), net.Port(config.Port)), cipher: cipher, obfs: obfs, protocol: protocol}, nil
+}
+func NewClient(ctx context.Context, config *ClientConfig) (*Client, error) {
+	c, err := newClient(config)
+	if err != nil {
+		return nil, err
+	}
+	c.policy = core.MustFromContext(ctx).GetFeature(policy.ManagerType()).(policy.Manager).ForLevel(config.Level)
+	return c, nil
+}
+func (c *Client) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	outbounds := session.OutboundsFromContext(ctx)
+	if len(outbounds) == 0 {
+		return errors.New("shadowsocksr: missing target")
+	}
+	ob := outbounds[len(outbounds)-1]
+	target := ob.Target
+	if !target.IsValid() || (target.Network != net.Network_TCP && target.Network != net.Network_UDP) {
+		return errors.New("shadowsocksr: unsupported target")
+	}
+	ob.Name = "shadowsocksr"
+	ob.CanSpliceCopy = 3
+	server := c.server
+	server.Network = target.Network
+	conn, err := dialer.Dial(ctx, server)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+	var reader buf.Reader
+	var writer buf.Writer
+	if target.Network == net.Network_TCP {
+		conn.SetDeadline(time.Now().Add(c.policy.Timeouts.Handshake))
+		stream := c.cipher.StreamConn(c.obfs.StreamConn(conn))
+		var iv []byte
+		if sc, ok := stream.(*shadowstream.Conn); ok {
+			iv, err = sc.ObtainWriteIV()
+			if err != nil {
+				return err
+			}
+		}
+		stream = c.protocol.StreamConn(stream, iv)
+		if err = M.SocksaddrSerializer.WriteAddrPort(stream, socksaddr(target)); err != nil {
+			return err
+		}
+		conn.SetDeadline(time.Time{})
+		reader = buf.NewReader(stream)
+		writer = buf.NewWriter(stream)
+	} else {
+		pc := c.protocol.PacketConn(c.cipher.PacketConn(&connectedPacketConn{Conn: conn}))
+		reader = &packetReader{conn: pc}
+		writer = &packetWriter{conn: pc, server: conn.RemoteAddr(), destination: target}
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	timer := signal.CancelAfterInactivity(ctx, cancel, c.policy.Timeouts.ConnectionIdle)
+	defer timer.SetTimeout(0)
+	request := func() error {
+		defer timer.SetTimeout(c.policy.Timeouts.DownlinkOnly)
+		return buf.Copy(link.Reader, writer, buf.UpdateActivity(timer))
+	}
+	response := func() error {
+		defer timer.SetTimeout(c.policy.Timeouts.UplinkOnly)
+		return buf.Copy(reader, link.Writer, buf.UpdateActivity(timer))
+	}
+	if err = task.Run(ctx, request, task.OnSuccess(response, task.Close(link.Writer))); err != nil {
+		common.Interrupt(link.Reader)
+		common.Interrupt(link.Writer)
+		return errors.New("shadowsocksr: connection ends").Base(err)
+	}
+	return nil
+}
+func socksaddr(d net.Destination) M.Socksaddr {
+	return M.ParseSocksaddrHostPort(d.Address.String(), uint16(d.Port))
+}
+func init() {
+	common.Must(common.RegisterConfig((*ClientConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewClient(ctx, config.(*ClientConfig))
+	}))
+}
