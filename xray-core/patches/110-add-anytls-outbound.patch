+package conf_test
+
+import (
+	"encoding/json"
+	"github.com/xtls/xray-core/infra/conf"
+	"github.com/xtls/xray-core/proxy/anytls"
+	"google.golang.org/protobuf/proto"
+	"testing"
+)
+
+func TestAnyTLSConfig(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		valid bool
+	}{
+		{`{"address":"example.com","port":443,"password":"test","idleSessionCheckInterval":30,"idleSessionTimeout":60,"minIdleSession":2}`, true},
+		{`{"port":443,"password":"test"}`, false},
+		{`{"address":"example.com","password":"test"}`, false},
+		{`{"address":"example.com","port":443}`, false},
+		{`{"address":"example.com","port":443,"password":"test","minIdleSession":-1}`, false},
+	} {
+		var config conf.AnyTLSClientConfig
+		if err := json.Unmarshal([]byte(tc.input), &config); err != nil {
+			t.Fatal(err)
+		}
+		built, err := config.Build()
+		if (err == nil) != tc.valid {
+			t.Fatalf("Build(%s): %v", tc.input, err)
+		}
+		if !tc.valid {
+			continue
+		}
+		data, err := proto.Marshal(built)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var result anytls.ClientConfig
+		if err = proto.Unmarshal(data, &result); err != nil {
+			t.Fatal(err)
+		}
+		if result.Password != "test" || result.Port != 443 || result.IdleSessionTimeout != 60 || result.MinIdleSession != 2 {
+			t.Fatal("configuration lost during protobuf serialization")
+		}
+	}
+}
