+package anytls
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	singanytls "github.com/sagernet/sing-anytls"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/common/task"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+// Client adapts the same AnyTLS implementation used by sing-box. The session
+// pool belongs to the outbound handler, not to an individual proxied request.
+type Client struct {
+	server  net.Destination
+	policy  policy.Session
+	options singanytls.ClientOptions
+	mu      sync.Mutex
+	client  *singanytls.Client
+	closed  bool
+}
+
+func NewClient(ctx context.Context, config *ClientConfig) (*Client, error) {
+	if config.Address == nil || config.Port == 0 || config.Port > 65535 || config.Password == "" {
+		return nil, errors.New("anytls: invalid server or password")
+	}
+	manager := core.MustFromContext(ctx).GetFeature(policy.ManagerType()).(policy.Manager)
+	return &Client{
+		server: net.TCPDestination(config.Address.AsAddress(), net.Port(config.Port)),
+		policy: manager.ForLevel(config.Level),
+		options: singanytls.ClientOptions{
+			Password:                 config.Password,
+			IdleSessionCheckInterval: time.Duration(config.IdleSessionCheckInterval) * time.Second,
+			IdleSessionTimeout:       time.Duration(config.IdleSessionTimeout) * time.Second,
+			MinIdleSession:           int(config.MinIdleSession),
+		},
+	}, nil
+}
+
+func (c *Client) getClient(dialer internet.Dialer) (*singanytls.Client, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, errors.New("anytls: client closed")
+	}
+	if c.client == nil {
+		options := c.options
+		options.DialOut = func(ctx context.Context) (net.Conn, error) {
+			// Keep Xray's configured TLS/uTLS, socket mark, and outbound chaining.
+			return dialer.Dial(ctx, c.server)
+		}
+		client, err := singanytls.NewClient(options)
+		if err != nil {
+			return nil, err
+		}
+		c.client = client
+	}
+	return c.client, nil
+}
+
+func (c *Client) Close() error {
+	c.mu.Lock()
+	c.closed = true
+	client := c.client
+	c.mu.Unlock()
+	if client != nil {
+		return client.Close()
+	}
+	return nil
+}
+
+func (c *Client) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	outbounds := session.OutboundsFromContext(ctx)
+	if len(outbounds) == 0 {
+		return errors.New("anytls: target not specified")
+	}
+	ob := outbounds[len(outbounds)-1]
+	target := ob.Target
+	if !target.IsValid() || (target.Network != net.Network_TCP && target.Network != net.Network_UDP) {
+		return errors.New("anytls: unsupported target")
+	}
+	ob.Name = "anytls"
+	ob.CanSpliceCopy = 3
+	client, err := c.getClient(dialer)
+	if err != nil {
+		return err
+	}
+	destination := socksaddr(target)
+	streamDestination := destination
+	if target.Network == net.Network_UDP {
+		streamDestination = uot.RequestDestination(uot.Version)
+	}
+	dialCtx, dialCancel := context.WithTimeout(ctx, c.policy.Timeouts.Handshake)
+	conn, err := client.DialContext(dialCtx, streamDestination)
+	dialCancel()
+	if err != nil {
+		return errors.New("anytls: failed to open stream").Base(err)
+	}
+	defer conn.Close()
+	errors.LogInfo(ctx, "tunneling request to ", target, " via ", c.server.NetAddr())
+
+	var reader buf.Reader = buf.NewReader(conn)
+	var writer buf.Writer = buf.NewWriter(conn)
+	if target.Network == net.Network_UDP {
+		// UoT v2, with an address per datagram for transparent UDP and SOCKS5.
+		conn.SetWriteDeadline(time.Now().Add(c.policy.Timeouts.Handshake))
+		packetConn, err := (&uot.Client{Version: uot.Version}).DialConn(conn, false, destination)
+		conn.SetWriteDeadline(time.Time{})
+		if err != nil {
+			return errors.New("anytls: failed to start UoT").Base(err)
+		}
+		reader = &packetReader{conn: packetConn}
+		writer = &packetWriter{conn: packetConn, destination: destination}
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	timer := signal.CancelAfterInactivity(ctx, cancel, c.policy.Timeouts.ConnectionIdle)
+	defer timer.SetTimeout(0)
+	request := func() error {
+		defer timer.SetTimeout(c.policy.Timeouts.DownlinkOnly)
+		return buf.Copy(link.Reader, writer, buf.UpdateActivity(timer))
+	}
+	response := func() error {
+		defer timer.SetTimeout(c.policy.Timeouts.UplinkOnly)
+		return buf.Copy(reader, link.Writer, buf.UpdateActivity(timer))
+	}
+	if err := task.Run(ctx, request, task.OnSuccess(response, task.Close(link.Writer))); err != nil {
+		// Unblock the other copy task on cancellation as well as I/O failures.
+		common.Interrupt(link.Reader)
+		common.Interrupt(link.Writer)
+		return errors.New("anytls: connection ends").Base(err)
+	}
+	return nil
+}
+
+func socksaddr(destination net.Destination) M.Socksaddr {
+	return M.ParseSocksaddrHostPort(destination.Address.String(), uint16(destination.Port))
+}
+
+func init() {
+	common.Must(common.RegisterConfig((*ClientConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewClient(ctx, config.(*ClientConfig))
+	}))
+}
--- a/proxy/anytls/client_test.go
+++ b/proxy/anytls/client_test.go
@@ -0,0 +1,199 @@
+package anytls
+
+import (
+	"bytes"
+	"context"
+	"io"
+	stdnet "net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	singanytls "github.com/sagernet/sing-anytls"
+	singbuf "github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/pipe"
+)
+
+type echoHandler struct{}
+
+func (echoHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	defer conn.Close()
+	if destination.Fqdn != uot.MagicAddress {
+		io.Copy(conn, conn)
+		return
+	}
+	request, err := uot.ReadRequest(conn)
+	if err != nil {
+		return
+	}
+	packets := uot.NewConn(conn, *request)
+	data := singbuf.NewSize(65535)
+	defer data.Release()
+	for {
+		data.Reset()
+		address, err := packets.ReadPacket(data)
+		if err != nil {
+			return
+		}
+		if err := packets.WritePacket(data, address); err != nil {
+			return
+		}
+	}
+}
+
+type testDialer struct {
+	service *singanytls.Service
+	dialed  atomic.Int32
+	active  atomic.Int32
+}
+
+func (d *testDialer) Dial(ctx context.Context, dest net.Destination) (stat.Connection, error) {
+	a, b := stdnet.Pipe()
+	d.dialed.Add(1)
+	d.active.Add(1)
+	go func() {
+		defer d.active.Add(-1)
+		defer b.Close()
+		d.service.NewConnection(context.Background(), b, M.Socksaddr{}, nil)
+	}()
+	return a, nil
+}
+func (*testDialer) DestIpAddress() net.IP                                 { return nil }
+func (*testDialer) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+func newTestClient(t *testing.T, password string) (*Client, *testDialer) {
+	t.Helper()
+	service, err := singanytls.NewService("test-password", singanytls.ServiceOptions{Handler: echoHandler{}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &Client{server: net.TCPDestination(net.LocalHostIP, 443), policy: policy.SessionDefault(), options: singanytls.ClientOptions{Password: password}}
+	d := &testDialer{service: service}
+	t.Cleanup(func() {
+		c.Close()
+		deadline := time.Now().Add(3 * time.Second)
+		for d.active.Load() != 0 && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if d.active.Load() != 0 {
+			t.Error("session connection leaked after Close")
+		}
+		if _, err := c.getClient(d); err == nil {
+			t.Error("client reopened after Close")
+		}
+	})
+	return c, d
+}
+
+func exchange(t *testing.T, c *Client, d *testDialer, udp bool) {
+	t.Helper()
+	target := net.TCPDestination(net.DomainAddress("echo.example"), 443)
+	if udp {
+		target = net.UDPDestination(net.DomainAddress("dns.example"), 53)
+	}
+	ctx, cancel := context.WithCancel(session.ContextWithOutbounds(context.Background(), []*session.Outbound{{Target: target}}))
+	uplink, input := pipe.New()
+	output, downlink := pipe.New()
+	done := make(chan error, 1)
+	go func() { done <- c.Process(ctx, &transport.Link{Reader: uplink, Writer: downlink}, d) }()
+	defer func() {
+		cancel()
+		input.Close()
+		output.Interrupt()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("Process did not exit after cancellation")
+		}
+	}()
+	sizes := []int{13, 9000}
+	for i, size := range sizes {
+		payload := bytes.Repeat([]byte{byte(i + 1)}, size)
+		b := buf.FromBytes(payload)
+		address := target
+		if udp {
+			if i == 1 {
+				address = net.UDPDestination(net.ParseAddress("2001:db8::1"), 12345)
+			}
+			b.UDP = &address
+		}
+		if err := input.WriteMultiBuffer(buf.MultiBuffer{b}); err != nil {
+			t.Fatal(err)
+		}
+		received := []byte{}
+		for len(received) < len(payload) {
+			mb, err := output.ReadMultiBufferTimeout(3 * time.Second)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, packet := range mb {
+				if udp && (packet.UDP == nil || *packet.UDP != address) {
+					t.Errorf("UDP source mismatch: %v != %v", packet.UDP, address)
+				}
+				received = append(received, packet.Bytes()...)
+			}
+			buf.ReleaseMulti(mb)
+		}
+		if !bytes.Equal(received, payload) {
+			t.Fatal("payload corrupted")
+		}
+	}
+}
+
+func TestAnyTLSProcess(t *testing.T) {
+	for _, udp := range []bool{false, true} {
+		name := "TCP"
+		if udp {
+			name = "UDP"
+		}
+		t.Run(name, func(t *testing.T) { c, d := newTestClient(t, "test-password"); exchange(t, c, d, udp) })
+	}
+}
+
+func TestAnyTLSReuseAndClose(t *testing.T) {
+	c, d := newTestClient(t, "test-password")
+	for i := 0; i < 10; i++ {
+		exchange(t, c, d, false)
+	}
+	if n := d.dialed.Load(); n > 2 {
+		t.Fatalf("sessions were not reused: %d dials for 10 requests", n)
+	}
+	c.Close()
+	c.Close()
+}
+
+func TestAnyTLSWrongPassword(t *testing.T) {
+	c, d := newTestClient(t, "wrong-password")
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: net.TCPDestination(net.DomainAddress("echo.example"), 443)}})
+	uplink, input := pipe.New()
+	output, downlink := pipe.New()
+	defer input.Close()
+	defer output.Interrupt()
+	done := make(chan error, 1)
+	go func() { done <- c.Process(ctx, &transport.Link{Reader: uplink, Writer: downlink}, d) }()
+	input.WriteMultiBuffer(buf.MultiBuffer{buf.FromBytes([]byte("must not be echoed"))})
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("wrong password accepted")
+		}
+	case <-ctx.Done():
+		t.Fatal("wrong password did not fail promptly")
+	}
+	mb, err := output.ReadMultiBufferTimeout(time.Second)
+	defer buf.ReleaseMulti(mb)
+	if err == nil && len(mb) > 0 {
+		t.Fatal("received payload with wrong password")
+	}
+}
