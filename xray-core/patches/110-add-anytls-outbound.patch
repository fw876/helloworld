--- a/proxy/anytls/packet.go
+++ b/proxy/anytls/packet.go
@@ -0,0 +1,44 @@
+package anytls
+
+import (
+	singbuf "github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/common/uot"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/net"
+)
+
+type packetReader struct{ conn *uot.Conn }
+
+func (r *packetReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	// Read one whole datagram, including packets larger than Xray's 8K buffer.
+	packet := singbuf.NewSize(65535)
+	defer packet.Release()
+	address, err := r.conn.ReadPacket(packet)
+	if err != nil {
+		return nil, err
+	}
+	b := buf.FromBytes(append([]byte(nil), packet.Bytes()...))
+	destination := net.UDPDestination(net.ParseAddress(address.AddrString()), net.Port(address.Port))
+	b.UDP = &destination
+	return buf.MultiBuffer{b}, nil
+}
+
+type packetWriter struct {
+	conn        *uot.Conn
+	destination M.Socksaddr
+}
+
+func (w *packetWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		destination := w.destination
+		if b.UDP != nil {
+			destination = socksaddr(*b.UDP)
+		}
+		if err := w.conn.WritePacket(singbuf.As(b.Bytes()), destination); err != nil {
+			return err
+		}
+	}
+	return nil
+}
