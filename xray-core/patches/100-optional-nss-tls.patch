+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+//go:build linux && arm64
+
+package cipher
+
+import (
+	"bytes"
+	"crypto/internal/fips140/aes"
+	"os"
+	"strconv"
+	"syscall"
+	"testing"
+	"unsafe"
+)
+
+func testDMAStorage(t *testing.T) *nssDMA {
+	t.Helper()
+	f, err := os.OpenFile("/dev/null", os.O_RDWR, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mem, err := syscall.Mmap(-1, 0, 2*nssDMACapacity, syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_PRIVATE|syscall.MAP_ANON)
+	if err != nil {
+		f.Close()
+		t.Fatal(err)
+	}
+	block, err := aes.New(make([]byte, 16))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cpu, err := NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	g := &nssDMA{file: f, mem: mem, fallback: cpu}
+	t.Cleanup(g.Close)
+	return g
+}
+func TestNSSDMABorrowSurvivesClose(t *testing.T) {
+	g := testDMAStorage(t)
+	input, output, release := g.NSSRecordBuffers()
+	input[0] = 0xa5
+	output[0] = 0x5a
+	g.Close()
+	if g.mem == nil || input[0] != 0xa5 || output[0] != 0x5a {
+		t.Fatal("Close invalidated borrowed record storage")
+	}
+	release()
+	release()
+	if g.mem != nil || g.borrowers != 0 {
+		t.Fatal("last borrower did not release mapping exactly once")
+	}
+	if in, _, done := g.NSSRecordBuffers(); in != nil || done != nil {
+		t.Fatal("borrow accepted after Close")
+	}
+}
+func TestNSSDMASubmitFailurePreservesInput(t *testing.T) {
+	for _, prefixLen := range []int{5, 13} {
+		for _, offset := range []int{0, 37} {
+			g := testDMAStorage(t)
+			input, _, release := g.NSSRecordBuffers()
+			prefix := bytes.Repeat([]byte{0x23}, prefixLen)
+			aad := bytes.Repeat([]byte{0x5a}, prefixLen)
+			nonce := make([]byte, 12)
+			plain := bytes.Repeat([]byte{0x61}, 17)
+			copy(input[offset:], prefix)
+			copy(input[offset+prefixLen:], plain)
+			want := g.fallback.Seal(nil, nonce, plain, aad)
+			// /dev/null rejects RUN. Test real mapped pointer/offset handling and
+			// fallback after AAD replaces the wire header (as in TLS 1.2).
+			got, err := g.NSSSealRecord(input[offset:offset+prefixLen], nonce,
+				input[offset+prefixLen:offset+prefixLen+len(plain)], aad)
+			if err != nil || !bytes.Equal(got[:prefixLen], prefix) ||
+				!bytes.Equal(got[prefixLen:], want) ||
+				!bytes.Equal(input[offset+prefixLen:offset+prefixLen+len(plain)], plain) {
+				t.Fatalf("bad submission fallback, prefix=%d offset=%d: %v", prefixLen, offset, err)
+			}
+			copy(input[offset+prefixLen:], want)
+			opened, err := g.NSSOpenRecord(nonce,
+				input[offset+prefixLen:offset+prefixLen+len(want)], aad)
+			if err != nil || !bytes.Equal(opened, plain) {
+				t.Fatalf("bad decrypt fallback: %v", err)
+			}
+			release()
+			g.Close()
+		}
+	}
+}
+
+func TestNSSDMABatchEngine(t *testing.T) {
+	for _, tc := range []struct {
+		hardware bool
+		size     int
+	}{{false, 16}, {false, 32}, {true, 16}, {true, 32}} {
+		hardware := tc.hardware
+		name := "cpu-control"
+		if hardware {
+			name = "hardware"
+		}
+		t.Run(name+strconv.Itoa(tc.size), func(t *testing.T) {
+			if hardware && os.Getenv("XRAY_NSS_HARDWARE_TEST") != "1" {
+				t.Skip("explicit hardware test required")
+			}
+			key := make([]byte, tc.size)
+			block, err := aes.New(key)
+			if err != nil {
+				t.Fatal(err)
+			}
+			cpu, err := NewGCM(block)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var g *nssDMA
+			if hardware {
+				t.Setenv("XRAY_NSS_DMA_BATCH", "4")
+				var ok bool
+				g, ok = newNSSDMA(key, cpu).(*nssDMA)
+				if !ok {
+					t.Fatal("hardware constructor fell back")
+				}
+			} else {
+				g = &nssDMA{mem: make([]byte, 8*nssDMACapacity), slots: 4, fallback: cpu, cpuOnly: true}
+			}
+			defer g.Close()
+			input, _, release := g.NSSRecordBuffers()
+			defer release()
+			slots, err := g.NSSBeginRecordBatch()
+			if err != nil || slots != 4 {
+				t.Fatalf("begin %d %v", slots, err)
+			}
+			if hardware {
+				bad := nssDMABatch{Count: 1}
+				bad.Req[0] = nssDMARequest{Op: 3, Offset: 1, Len: 1, AAD: 5}
+				if err := nssDMAIoctl(g.file, 0xc2884e61, unsafe.Pointer(&bad)); err != syscall.EINVAL {
+					t.Fatalf("misaligned in-place slot accepted: %v", err)
+				}
+			}
+
+			var records, expected [4][]byte
+			var nonces [4][12]byte
+			var aad [4][]byte
+			for i, n := range []int{0, 1, 16384, 7} {
+				nonces[i][11] = byte(i)
+				aad[i] = bytes.Repeat([]byte{byte(i + 1)}, 13)
+				off := i * nssDMACapacity
+				prefix := input[off : off+13]
+				copy(prefix, bytes.Repeat([]byte{0x23}, 13))
+				plain := input[off+13 : off+13+n]
+				for j := range plain {
+					plain[j] = byte(i + j)
+				}
+				expected[i] = cpu.Seal(nil, nonces[i][:], plain, aad[i])
+				records[i], err = g.NSSSealRecord(prefix, nonces[i][:], plain, aad[i])
+				if err != nil {
+					t.Fatal(err)
+				}
+				records[i][3] = byte((n + 24) >> 8)
+				records[i][4] = byte(n + 24)
+			}
+			if err = g.NSSFlushRecordBatch(); err != nil {
+				t.Fatal(err)
+			}
+			g.NSSAbortRecordBatch()
+			var encrypted [4][]byte
+			var prefixes [4][]byte
+			off := 0
+			for i := range records {
+				if !bytes.Equal(records[i][13:], expected[i]) {
+					t.Fatalf("seal mismatch slot %d", i)
+				}
+				n := copy(input[off:], records[i])
+				prefixes[i] = append([]byte(nil), input[off:off+13]...)
+				encrypted[i] = input[off+13 : off+n]
+				off += n
+			}
+			encrypted[3][len(encrypted[3])-1] ^= 1
+			out, errs := g.NSSOpenRecords(nonces[:], encrypted[:], aad[:])
+			for i := range out {
+				if i == 3 {
+					if errs[i] != syscall.EBADMSG || out[i] != nil {
+						t.Fatal("bad tag was not rejected")
+					}
+					continue
+				}
+				want, err := cpu.Open(nil, nonces[i][:], encrypted[i], aad[i])
+				if err != nil || errs[i] != nil || !bytes.Equal(out[i], want) {
+					t.Fatalf("open slot %d: %v %v", i, err, errs[i])
+				}
+			}
+			off = 0
+			for i, r := range records {
+				if !bytes.Equal(input[off:off+13], prefixes[i]) {
+					t.Fatal("lookahead modified wire prefix")
+				}
+				off += len(r)
+			}
+		})
+	}
+}
