+func TestNSSWriteFromReady(t *testing.T) {
+	for _, version := range []uint16{VersionTLS12, VersionTLS13} {
+		for _, fixed := range []bool{false, true} {
+			tx, rx := newBatchMappedTestAEAD(t), newBatchMappedTestAEAD(t)
+			wire := &batchWireConn{}
+			writer := &Conn{conn: wire, vers: version, config: &Config{DynamicRecordSizingDisabled: fixed}, out: batchHalf(version, tx)}
+			writer.isHandshakeComplete.Store(true)
+			packets := writer.packetsSent
+			handled, rerr, werr := writer.NSSWriteFromReady(func([][]byte) (int, error) { return 0, nil }, nil)
+			if handled || rerr != nil || werr != nil || writer.packetsSent != packets || wire.Len() != 0 {
+				t.Fatal("empty ready read changed writer")
+			}
+			var want []byte
+			observed := false
+			handled, rerr, werr = writer.NSSWriteFromReady(func(parts [][]byte) (int, error) {
+				n := 0
+				for i, p := range parts {
+					if i == len(parts)-1 {
+						p = p[:len(p)/2]
+					}
+					for j := range p {
+						p[j] = byte(n + j)
+					}
+					want = append(want, p...)
+					n += len(p)
+				}
+				return n, io.EOF
+			}, func(parts [][]byte) {
+				observed = true
+				if !bytes.Equal(bytes.Join(parts, nil), want) {
+					t.Fatal("plaintext observation changed")
+				}
+			})
+			if !handled || rerr != io.EOF || werr != nil || !observed {
+				t.Fatalf("ready read: %v %v %v", handled, rerr, werr)
+			}
+			in := batchHalf(version, rx)
+			var got []byte
+			for wire.Len() > 0 {
+				raw := wire.Bytes()
+				size := 5 + (int(raw[3]) << 8) + int(raw[4])
+				record := wire.Next(size)
+				copy(rx.input, record)
+				plain, kind, err := in.decrypt(rx.input[:size])
+				if err != nil || kind != recordTypeApplicationData {
+					t.Fatal("direct ciphertext", kind, err)
+				}
+				got = append(got, plain...)
+			}
+			if !bytes.Equal(got, want) {
+				t.Fatal("direct plaintext changed")
+			}
+			if tx.borrowers != 0 || tx.queued {
+				t.Fatal("direct input lease leaked")
+			}
+			writer.activeCall.Store(1)
+			handled, _, werr = writer.NSSWriteFromReady(func([][]byte) (int, error) { t.Fatal("read after close"); return 0, nil }, nil)
+			if !handled || werr != net.ErrClosed {
+				t.Fatal("close ignored")
+			}
+		}
+	}
+}
