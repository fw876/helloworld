@@ -0,0 +1,118 @@
+//go:build linux && (arm64 || amd64)
+
+// SPDX-License-Identifier: MPL-2.0
+package buf
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+type directCounter struct{ n int64 }
+
+func (c *directCounter) Value() int64      { return c.n }
+func (c *directCounter) Set(n int64) int64 { old := c.n; c.n = n; return old }
+func (c *directCounter) Add(n int64) int64 { old := c.n; c.n += n; return old }
+
+func TestNSSReadyReadTCP(t *testing.T) {
+	listener, err := net.ListenTCP("tcp4", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	tx, err := net.DialTCP("tcp4", nil, listener.Addr().(*net.TCPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Close()
+	rx, err := listener.AcceptTCP()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rx.Close()
+	raw, err := rx.SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	counter := &directCounter{}
+	r := NewReadVReader(rx, raw, counter)
+	parts := [][]byte{make([]byte, 3), make([]byte, 7)}
+	rx.SetReadDeadline(time.Now().Add(time.Second))
+	if n, err := r.NSSReadReadyBuffers(parts); n != 0 || err != nil {
+		t.Fatalf("idle socket waited: %d %v", n, err)
+	}
+	if _, err := tx.Write([]byte("0123456789")); err != nil {
+		t.Fatal(err)
+	}
+	var got []byte
+	until := time.Now().Add(time.Second)
+	for len(got) < 10 && time.Now().Before(until) {
+		n, err := r.NSSReadReadyBuffers(parts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, p := range parts {
+			take := min(n, len(p))
+			got = append(got, p[:take]...)
+			n -= take
+		}
+		if len(got) < 10 {
+			time.Sleep(time.Millisecond)
+		}
+	}
+	if !bytes.Equal(got, []byte("0123456789")) || counter.Value() != 10 {
+		t.Fatal("data/counter", string(got), counter.Value())
+	}
+	rx.SetReadDeadline(time.Now().Add(-time.Second))
+	if _, err := r.NSSReadReadyBuffers(parts); err == nil {
+		t.Fatal("deadline bypassed")
+	}
+}
+
+type directNoReader struct{}
+
+func (directNoReader) ReadMultiBuffer() (MultiBuffer, error) { panic("unexpected fallback") }
+
+type directCopyWriter struct {
+	writeErr error
+	called   int
+}
+
+func (w *directCopyWriter) WriteMultiBuffer(mb MultiBuffer) error { ReleaseMulti(mb); return nil }
+func (w *directCopyWriter) NSSCopyReadyFrom(_ Reader, observe func(MultiBuffer)) (bool, error, error) {
+	w.called++
+	mb := BorrowMulti([][]byte{[]byte("abc"), []byte("defg")}, func() {})
+	observe(mb)
+	ReleaseMulti(mb)
+	return true, io.EOF, w.writeErr
+}
+func TestNSSDirectCopyAccountingAndErrors(t *testing.T) {
+	old := nssDirectCopyEnabled
+	nssDirectCopyEnabled = true
+	defer func() { nssDirectCopyEnabled = old }()
+	for _, writeErr := range []error{nil, io.ErrClosedPipe} {
+		w := &directCopyWriter{writeErr: writeErr}
+		buffered := NewBufferedWriter(w)
+		handled, _, _ := buffered.NSSCopyReadyFrom(directNoReader{}, nil)
+		if handled || w.called != 0 {
+			t.Fatal("bypassed pending protocol header")
+		}
+		if err := buffered.SetBuffered(false); err != nil {
+			t.Fatal(err)
+		}
+		var count SizeCounter
+		err := Copy(directNoReader{}, buffered, CountSize(&count))
+		if count.Size != 7 || w.called != 1 {
+			t.Fatal("accounting", count.Size, w.called)
+		}
+		if writeErr == nil && err != nil {
+			t.Fatal(err)
+		}
+		if writeErr != nil && !IsWriteError(err) {
+			t.Fatal("write error classification", err)
+		}
+	}
+}
