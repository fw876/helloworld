+++ b/_nss/nss_linux_arm64.go
@@ -0,0 +1,253 @@
+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+//go:build linux && arm64
+
+package cipher
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+)
+
+// The ioctl layouts below are the cryptodev-linux arm64 ABI, not AF_ALG.
+type nssSession struct {
+	Cipher, Mac, Keylen uint32
+	Key                 *byte
+	Mackeylen           uint32
+	Mackey              *byte
+	Ses                 uint32
+}
+type nssInfo struct {
+	Ses                              uint32
+	Cipher, Driver, Hash, HashDriver [64]byte
+	Align                            uint16
+	Flags                            uint32
+}
+type nssAuth struct {
+	Ses                uint32
+	Op, Flags          uint16
+	Len, Authlen       uint32
+	Aad, Src, Dst, Tag *byte
+	Taglen             uint32
+	IV                 *byte
+	IVlen              uint32
+}
+
+var nssVerify = os.Getenv("XRAY_NSS_TLS_VERIFY") == "1"
+
+// Include AAD and tag. The tested NSS firmware silently skips some larger
+// requests; keep them on CPU even when used with an older cryptodev build.
+const nssMaxRequest = 65023
+
+var nssMode = os.Getenv("XRAY_NSS_TLS")
+var nssEnabled = nssMode == "1" || nssMode == "cryptodev" || (nssMode == "dmabuf" || nssMode == "cpu-batch")
+var nssMin = func() int {
+	n, _ := strconv.Atoi(os.Getenv("XRAY_NSS_TLS_MIN"))
+	if n < 0 {
+		return 0
+	}
+	return n
+}()
+var nssWarn sync.Once
+var nssCreated, nssClosed, nssSeals, nssOpens, nssFallbacks atomic.Uint64
+
+// NSSStats reports sessions opened/closed, hardware seals/opens and fallbacks.
+// It is intended for the accompanying loopback benchmark.
+func NSSStats() [5]uint64 {
+	return [5]uint64{nssCreated.Load(), nssClosed.Load(), nssSeals.Load(), nssOpens.Load(), nssFallbacks.Load()}
+}
+func nssWarning(err error) {
+	nssWarn.Do(func() { fmt.Fprintln(os.Stderr, "xray NSS TLS: using CPU fallback:", err) })
+}
+func nssPtr(b []byte) *byte {
+	if len(b) == 0 {
+		return nil
+	}
+	return &b[0]
+}
+func nssIoctl(f *os.File, request uintptr, arg unsafe.Pointer) error {
+	var pin runtime.Pinner
+	pin.Pin(arg)
+	defer pin.Unpin()
+	_, _, e := syscall.Syscall(syscall.SYS_IOCTL, f.Fd(), request, uintptr(arg))
+	runtime.KeepAlive(f)
+	if e != 0 {
+		return e
+	}
+	return nil
+}
+
+// NewNSSGCM wraps only TLS AES-GCM records. Disabled unless XRAY_NSS_TLS=1.
+// It checks the selected driver so a software CryptoAPI implementation cannot
+// silently be reported as NSS acceleration. ChaCha20 and handshakes are untouched.
+func NewNSSGCM(key []byte, fallback AEAD) AEAD {
+	if !nssEnabled {
+		return fallback
+	}
+	if fallback.NonceSize() != 12 || fallback.Overhead() != 16 {
+		return fallback
+	}
+	if nssMode == "dmabuf" || nssMode == "cpu-batch" {
+		return newNSSDMA(key, fallback)
+	}
+	f, err := os.OpenFile("/dev/crypto", os.O_RDWR, 0)
+	if err != nil {
+		nssFallbacks.Add(1)
+		nssWarning(err)
+		return fallback
+	}
+	var pin runtime.Pinner
+	pin.Pin(nssPtr(key))
+	defer pin.Unpin()
+	s := nssSession{Cipher: 50, Keylen: uint32(len(key)), Key: nssPtr(key)}
+	err = nssIoctl(f, 0xc0306366, unsafe.Pointer(&s))
+	runtime.KeepAlive(key)
+	if err == nil {
+		info := nssInfo{Ses: s.Ses}
+		err = nssIoctl(f, 0xc10c636b, unsafe.Pointer(&info))
+		if err == nil && info.Flags&2 == 0 {
+			err = errors.New("cryptodev lacks the NSS GCM linear-buffer fix")
+		}
+		if err == nil && string(bytes.TrimRight(info.Driver[:], "\x00")) != "nss-gcm" {
+			err = errors.New("selected AES-GCM driver is not nss-gcm")
+		}
+	}
+	if err != nil {
+		f.Close()
+		nssFallbacks.Add(1)
+		nssWarning(err)
+		return fallback
+	}
+	g := &nssGCM{file: f, session: s.Ses, fallback: fallback}
+	nssCreated.Add(1)
+	// Deterministic Close is used by TLS; the finalizer also covers abandoned
+	// connections and AEADs owned by callers outside the TLS connection lifecycle.
+	runtime.SetFinalizer(g, (*nssGCM).Close)
+	return g
+}
+
+type nssGCM struct {
+	mu       sync.Mutex
+	file     *os.File
+	session  uint32
+	fallback AEAD
+	scratch  []byte
+}
+
+func (g *nssGCM) NonceSize() int { return 12 }
+func (g *nssGCM) Overhead() int  { return 16 }
+func (g *nssGCM) closeLocked() {
+	if g.file != nil {
+		g.file.Close()
+		g.file = nil
+		nssClosed.Add(1)
+	}
+	clear(g.scratch)
+	g.scratch = nil
+}
+func (g *nssGCM) Close() { g.mu.Lock(); defer g.mu.Unlock(); g.closeLocked() }
+func (g *nssGCM) run(op uint16, nonce, in, aad []byte) ([]byte, error) {
+	size := len(in) + 16
+	if cap(g.scratch) < size {
+		g.scratch = make([]byte, size)
+	} else {
+		g.scratch = g.scratch[:size]
+	}
+	var pin runtime.Pinner
+	pin.Pin(nssPtr(nonce))
+	pin.Pin(nssPtr(in))
+	pin.Pin(nssPtr(g.scratch))
+	if len(aad) > 0 {
+		pin.Pin(nssPtr(aad))
+	}
+	defer pin.Unpin()
+	a := nssAuth{Ses: g.session, Op: op, Len: uint32(len(in)), Authlen: uint32(len(aad)), Aad: nssPtr(aad), Src: nssPtr(in), Dst: nssPtr(g.scratch), Taglen: 16, IV: nssPtr(nonce), IVlen: 12}
+	err := nssIoctl(g.file, 0xc048636d, unsafe.Pointer(&a))
+	runtime.KeepAlive(nonce)
+	runtime.KeepAlive(in)
+	runtime.KeepAlive(aad)
+	runtime.KeepAlive(g)
+	if err != nil {
+
+		clear(g.scratch)
+		return nil, err
+	}
+	if op == 1 {
+		size = len(in) - 16
+	}
+	return g.scratch[:size], nil
+}
+func (g *nssGCM) Seal(dst, nonce, plaintext, aad []byte) []byte {
+	if len(nonce) != 12 {
+		panic("cipher: incorrect nonce length given to NSS GCM")
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.file != nil && len(plaintext) > 0 && len(plaintext) >= nssMin && len(aad) <= 255 && len(plaintext)+len(aad)+16 <= nssMaxRequest {
+		out, err := g.run(0, nonce, plaintext, aad)
+		if err == nil {
+			if nssVerify {
+				want := g.fallback.Seal(nil, nonce, plaintext, aad)
+				if !bytes.Equal(out, want) {
+					g.closeLocked()
+					nssFallbacks.Add(1)
+					nssWarning(errors.New("hardware encryption failed CPU verification"))
+					return append(dst, want...)
+				}
+			}
+			nssSeals.Add(1)
+			return append(dst, out...)
+		}
+		g.closeLocked()
+		nssWarning(err)
+	}
+	nssFallbacks.Add(1)
+	return g.fallback.Seal(dst, nonce, plaintext, aad)
+}
+func (g *nssGCM) Open(dst, nonce, ciphertext, aad []byte) ([]byte, error) {
+	if len(nonce) != 12 {
+		panic("cipher: incorrect nonce length given to NSS GCM")
+	}
+	if len(ciphertext) < 16 {
+		return nil, errors.New("cipher: message authentication failed")
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+
+	if g.file != nil && len(ciphertext) > 16 && len(ciphertext)-16 >= nssMin && len(aad) <= 255 && len(ciphertext)+len(aad) <= nssMaxRequest {
+		out, err := g.run(1, nonce, ciphertext, aad)
+		if err == nil {
+			if nssVerify {
+				want, e := g.fallback.Open(nil, nonce, ciphertext, aad)
+				if e != nil || !bytes.Equal(out, want) {
+					g.closeLocked()
+					nssFallbacks.Add(1)
+					nssWarning(errors.New("hardware decryption failed CPU verification"))
+					if e != nil {
+						return nil, e
+					}
+					return append(dst, want...), nil
+				}
+			}
+			nssOpens.Add(1)
+			return append(dst, out...), nil
+		}
+		// Never release plaintext on failed authentication. A driver error also
+		// requires CPU verification of the original, untouched ciphertext.
+		if err == syscall.EBADMSG {
+			return nil, errors.New("cipher: message authentication failed")
+		}
+
+		g.closeLocked()
+		nssWarning(err)
+	}
+	nssFallbacks.Add(1)
+	return g.fallback.Open(dst, nonce, ciphertext, aad)
+}
