+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+package tls
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"io"
+	"net"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+type mappedTestAEAD struct {
+	cpu           cipher.AEAD
+	input, output []byte
+	borrowers     int
+	closed        bool
+}
+
+func newMappedTestAEAD(t *testing.T) *mappedTestAEAD {
+	block, err := aes.NewCipher(make([]byte, 16))
+	if err != nil {
+		t.Fatal(err)
+	}
+	cpu, err := cipher.NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &mappedTestAEAD{cpu: cpu, input: make([]byte, 32768), output: make([]byte, 32768)}
+}
+func (g *mappedTestAEAD) NonceSize() int { return 12 }
+func (g *mappedTestAEAD) Overhead() int  { return 16 }
+func (g *mappedTestAEAD) Seal([]byte, []byte, []byte, []byte) []byte {
+	panic("generic Seal bypassed mapped record API")
+}
+func (g *mappedTestAEAD) Open([]byte, []byte, []byte, []byte) ([]byte, error) {
+	panic("generic Open bypassed mapped record API")
+}
+func (g *mappedTestAEAD) Close() {
+	g.closed = true
+	if g.borrowers == 0 {
+		clear(g.input)
+		clear(g.output)
+	}
+}
+func (g *mappedTestAEAD) NSSRecordBuffers() ([]byte, []byte, func()) {
+	g.borrowers++
+	var once sync.Once
+	return g.input, g.output, func() {
+		once.Do(func() {
+			g.borrowers--
+			if g.closed && g.borrowers == 0 {
+				clear(g.input)
+				clear(g.output)
+			}
+		})
+	}
+}
+func (g *mappedTestAEAD) NSSSealRecord(prefix, nonce, plain, aad []byte) ([]byte, error) {
+	off := len(prefix)
+	if len(plain) > 0 && &plain[0] != &g.input[off] {
+		panic("encryption did not use mapped input")
+	}
+	copy(g.output, prefix)
+	return g.cpu.Seal(g.output[:off], nonce, plain, aad), nil
+}
+func (g *mappedTestAEAD) NSSOpenRecord(nonce, encrypted, aad []byte) ([]byte, error) {
+	if len(encrypted) > 0 && &encrypted[0] != &g.input[len(aad)] {
+		panic("decryption did not use mapped input")
+	}
+	return g.cpu.Open(g.output[:0], nonce, encrypted, aad)
+}
+func TestNSSMappedRecords(t *testing.T) {
+	for _, version := range []uint16{VersionTLS12, VersionTLS13} {
+		tx, rx := newMappedTestAEAD(t), newMappedTestAEAD(t)
+		out, in := halfConn{version: version}, halfConn{version: version}
+		if version == VersionTLS12 {
+			out.cipher = &prefixNonceAEAD{aead: tx}
+			in.cipher = &prefixNonceAEAD{aead: rx}
+		} else {
+			out.cipher = &xorNonceAEAD{aead: tx}
+			in.cipher = &xorNonceAEAD{aead: rx}
+		}
+		for _, size := range []int{1, 4096, 16384, 31} {
+			plain := bytes.Repeat([]byte{byte(size)}, size)
+			header := tx.input[:5]
+			copy(header, []byte{23, 3, 3, byte(size >> 8), byte(size)})
+			encrypted, err := out.encrypt(header, plain, rand.Reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			copy(rx.input, encrypted)
+			opened, typ, err := in.decrypt(rx.input[:len(encrypted)])
+			if err != nil || typ != recordTypeApplicationData || !bytes.Equal(opened, plain) {
+				t.Fatalf("TLS %x size %d: typ %d err %v", version, size, typ, err)
+			}
+		}
+	}
+}
+func TestNSSMappedKeyChangeRetainsPrefetch(t *testing.T) {
+	old, next := newMappedTestAEAD(t), newMappedTestAEAD(t)
+	c := &Conn{}
+	c.in.cipher = &xorNonceAEAD{aead: old}
+	c.nssPrepareInput()
+	want := []byte("prefetched next-key record")
+	copy(old.input, want)
+	c.rawInput = *bytes.NewBuffer(old.input[:len(want)])
+	old.Close()
+	if old.borrowers != 1 || !bytes.Equal(c.rawInput.Bytes(), want) {
+		t.Fatal("old mapping released while prefetched data is live")
+	}
+	c.in.cipher = &xorNonceAEAD{aead: next}
+	c.nssPrepareInput()
+	if old.borrowers != 0 || next.borrowers != 1 || !bytes.Equal(c.rawInput.Bytes(), want) {
+		t.Fatal("key change lost prefetched data")
+	}
+	c.nssReleaseInput()
+	if next.borrowers != 0 {
+		t.Fatal("mapping reference leaked")
+	}
+}
+func TestNSSMappedSocketReadAndCompaction(t *testing.T) {
+	g := newMappedTestAEAD(t)
+	c := &Conn{}
+	c.in.cipher = &xorNonceAEAD{aead: g}
+	c.nssPrepareInput()
+	defer c.nssReleaseInput()
+	// Consume most of a large read so bytes.Buffer would otherwise grow away
+	// from its mapped allocation. Ensure refill compacts within the same slot.
+	data := bytes.Repeat([]byte{0x73}, 30000)
+	if err := c.readFromUntil(bytes.NewReader(data), 30000); err != nil {
+		t.Fatal(err)
+	}
+	c.rawInput.Next(20000)
+	tail := bytes.Repeat([]byte{0x41}, 8000)
+	if err := c.readFromUntil(bytes.NewReader(tail), 18000); err != nil {
+		t.Fatal(err)
+	}
+	got := c.rawInput.Bytes()
+	if &got[0] != &g.input[0] || !bytes.Equal(got[:10000], data[:10000]) || !bytes.Equal(got[10000:], tail) {
+		t.Fatal("refill lost mapped storage or changed bytes")
+	}
+	if err := c.readFromUntil(bytes.NewReader(nil), len(got)+1); err != io.ErrUnexpectedEOF {
+		t.Fatalf("unexpected EOF behavior: %v", err)
+	}
+}
