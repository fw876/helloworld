+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+package tls
+
+import (
+	"bytes"
+	"io"
+	"net"
+)
+
+// Private record API: returned buffers are borrowed until release, unlike
+// ordinary cipher.AEAD results. Implemented only by the DMA-BUF backend.
+type nssMappedAEAD interface {
+	NSSRecordBuffers() (input, output []byte, release func())
+	NSSSealRecord(prefix, nonce, plaintext, aad []byte) ([]byte, error)
+	NSSOpenRecord(nonce, ciphertext, aad []byte) ([]byte, error)
+}
+
+func nssRecords(v any) nssMappedAEAD {
+	if c, ok := v.(interface{ nssRecordCipher() nssMappedAEAD }); ok {
+		return c.nssRecordCipher()
+	}
+	return nil
+}
+func (f *prefixNonceAEAD) nssRecordCipher() nssMappedAEAD {
+	if _, ok := f.aead.(nssMappedAEAD); ok {
+		return f
+	}
+	return nil
+}
+func (f *xorNonceAEAD) nssRecordCipher() nssMappedAEAD {
+	if _, ok := f.aead.(nssMappedAEAD); ok {
+		return f
+	}
+	return nil
+}
+func (f *prefixNonceAEAD) NSSRecordBuffers() ([]byte, []byte, func()) {
+	return f.aead.(nssMappedAEAD).NSSRecordBuffers()
+}
+func (f *xorNonceAEAD) NSSRecordBuffers() ([]byte, []byte, func()) {
+	return f.aead.(nssMappedAEAD).NSSRecordBuffers()
+}
+func (f *prefixNonceAEAD) NSSSealRecord(prefix, nonce, plaintext, aad []byte) ([]byte, error) {
+	copy(f.nonce[4:], nonce)
+	return f.aead.(nssMappedAEAD).NSSSealRecord(prefix, f.nonce[:], plaintext, aad)
+}
+func (f *prefixNonceAEAD) NSSOpenRecord(nonce, ciphertext, aad []byte) ([]byte, error) {
+	copy(f.nonce[4:], nonce)
+	return f.aead.(nssMappedAEAD).NSSOpenRecord(f.nonce[:], ciphertext, aad)
+}
+func (f *xorNonceAEAD) NSSSealRecord(prefix, nonce, plaintext, aad []byte) ([]byte, error) {
+	mask := f.nonceMask
+	for i, b := range nonce {
+		mask[4+i] ^= b
+	}
+	return f.aead.(nssMappedAEAD).NSSSealRecord(prefix, mask[:], plaintext, aad)
+}
+func (f *xorNonceAEAD) NSSOpenRecord(nonce, ciphertext, aad []byte) ([]byte, error) {
+	mask := f.nonceMask
+	for i, b := range nonce {
+		mask[4+i] ^= b
+	}
+	return f.aead.(nssMappedAEAD).NSSOpenRecord(mask[:], ciphertext, aad)
+}
+
+// Bind raw socket input to CMA once per traffic key. Retain the old mapping
+// across cipher Close until any prefetched ciphertext has moved to the new
+// record owner. Key changes may copy pending bytes; the steady-state path reads
+// socket data directly into CMA and submits a slot offset without staging.
+func (c *Conn) nssPrepareInput() {
+	owner := nssRecords(c.in.cipher)
+	if owner == c.nssReadOwner {
+		return
+	}
+	var input []byte
+	var release func()
+	if owner != nil {
+		input, _, release = owner.NSSRecordBuffers()
+	}
+	c.in.nssPrefetched = nil
+	clear(c.in.nssPrefetchStorage[:])
+	pending := c.rawInput.Bytes()
+	if input != nil && len(pending) <= cap(input) {
+		copy(input, pending)
+		c.rawInput = *bytes.NewBuffer(input[:len(pending)])
+	} else if c.nssReadRelease != nil {
+		c.rawInput = *bytes.NewBuffer(append([]byte(nil), pending...))
+	}
+	if c.nssReadRelease != nil {
+		c.nssReadRelease()
+	}
+	c.nssReadOwner = owner
+	c.nssReadBuffer = input
+	c.nssReadRelease = release
+}
+func (c *Conn) nssCompactInput(needs int) {
+	if c.nssReadBuffer == nil || c.rawInput.Available() >= needs+bytes.MinRead {
+		return
+	}
+	pending := c.rawInput.Bytes()
+	if len(pending)+needs+bytes.MinRead > cap(c.nssReadBuffer) {
+		return
+	}
+	copy(c.nssReadBuffer, pending)
+	c.rawInput = *bytes.NewBuffer(c.nssReadBuffer[:len(pending)])
+}
+func (c *Conn) nssReleaseInput() {
+	if c.nssReadLease != nil {
+		if c.nssReadLease.cond != nil {
+			c.nssReadLease.cond.Broadcast()
+		} else {
+			close(c.nssReadLease.canceled)
+		}
+		c.nssReadLease = nil
+	}
+	if c.nssReadRelease == nil {
+		return
+	}
+	c.input.Reset(nil)
+	c.in.nssPrefetched = nil
+	clear(c.in.nssPrefetchStorage[:])
+	c.rawInput = bytes.Buffer{}
+	c.nssReadRelease()
+	c.nssReadRelease = nil
+	c.nssReadBuffer = nil
+	c.nssReadOwner = nil
+}
+
+// Only currently available records are grouped. No timer or extra socket read
+// waits for a batch. A change of traffic key invalidates speculative decrypts.
+type nssBatchAEAD interface {
+	nssMappedAEAD
+	NSSBatchSize() int
+	NSSBeginRecordBatch() (int, error)
+	NSSFlushRecordBatch() error
+	NSSAbortRecordBatch()
+	NSSOpenRecords(nonces [][12]byte, inputs, aads [][]byte) ([][]byte, []error)
+}
+
+func nssBatchRecords(v any) nssBatchAEAD {
+	switch f := v.(type) {
+	case *prefixNonceAEAD:
+		if _, ok := f.aead.(nssBatchAEAD); ok {
+			return f
+		}
+	case *xorNonceAEAD:
+		if _, ok := f.aead.(nssBatchAEAD); ok {
+			return f
+		}
+	}
+	return nil
+}
+func (f *prefixNonceAEAD) NSSBatchSize() int { return f.aead.(nssBatchAEAD).NSSBatchSize() }
+func (f *xorNonceAEAD) NSSBatchSize() int    { return f.aead.(nssBatchAEAD).NSSBatchSize() }
+func (f *prefixNonceAEAD) NSSBeginRecordBatch() (int, error) {
+	return f.aead.(nssBatchAEAD).NSSBeginRecordBatch()
+}
+func (f *xorNonceAEAD) NSSBeginRecordBatch() (int, error) {
+	return f.aead.(nssBatchAEAD).NSSBeginRecordBatch()
+}
+func (f *prefixNonceAEAD) NSSFlushRecordBatch() error {
+	return f.aead.(nssBatchAEAD).NSSFlushRecordBatch()
+}
+func (f *xorNonceAEAD) NSSFlushRecordBatch() error {
+	return f.aead.(nssBatchAEAD).NSSFlushRecordBatch()
+}
+func (f *prefixNonceAEAD) NSSAbortRecordBatch() { f.aead.(nssBatchAEAD).NSSAbortRecordBatch() }
+func (f *xorNonceAEAD) NSSAbortRecordBatch()    { f.aead.(nssBatchAEAD).NSSAbortRecordBatch() }
+func (f *prefixNonceAEAD) NSSOpenRecords(nonces [][12]byte, inputs, aads [][]byte) ([][]byte, []error) {
+	for i := range nonces {
+		n := f.nonce
+		copy(n[4:], nonces[i][:8])
+		nonces[i] = n
+	}
+	return f.aead.(nssBatchAEAD).NSSOpenRecords(nonces, inputs, aads)
+}
+func (f *xorNonceAEAD) NSSOpenRecords(nonces [][12]byte, inputs, aads [][]byte) ([][]byte, []error) {
+	for i := range nonces {
+		n := f.nonceMask
+		for j, b := range nonces[i][:8] {
+			n[4+j] ^= b
+		}
+		nonces[i] = n
+	}
+	return f.aead.(nssBatchAEAD).NSSOpenRecords(nonces, inputs, aads)
+}
+func (c *Conn) nssWriteRecords(mapped nssBatchAEAD, data []byte) (int, error) {
+	return c.nssWriteScattered(mapped, [][]byte{data})
+}
+func (c *Conn) nssWriteScattered(mapped nssBatchAEAD, parts [][]byte) (int, error) {
+	remaining := 0
+	for _, p := range parts {
+		if len(p) > int(^uint(0)>>1)-remaining {
+			return 0, io.ErrShortBuffer
+		}
+		remaining += len(p)
+	}
+	part, offset := 0, 0
+	input, _, release := mapped.NSSRecordBuffers()
+	if release == nil {
+		return 0, io.ErrClosedPipe
+	}
+	defer release()
+	slots, err := mapped.NSSBeginRecordBatch()
+	if err != nil {
+		return 0, err
+	}
+	defer mapped.NSSAbortRecordBatch()
+	defer clear(c.nssWriteRefs[:])
+	if slots < 1 || slots > 16 || len(input)%slots != 0 {
+		return 0, io.ErrShortBuffer
+	}
+	capacity := len(input) / slots
+	written := 0
+	for remaining > 0 {
+		records := &c.nssWriteRefs
+		clear(records[:])
+		var sizes, wireSizes [16]int
+		count := 0
+		for count < slots && remaining > 0 {
+			m := remaining
+			if max := c.maxPayloadSizeForWrite(recordTypeApplicationData); m > max {
+				m = max
+			}
+			record := input[count*capacity : count*capacity+recordHeaderLen : (count+1)*capacity]
+			record[0] = byte(recordTypeApplicationData)
+			record[1] = 3
+			record[2] = 3
+			record[3] = byte(m >> 8)
+			record[4] = byte(m)
+			payloadOffset := recordHeaderLen + c.out.explicitNonceLen()
+			payload := input[count*capacity+payloadOffset : count*capacity+payloadOffset+m]
+			filled := 0
+			for filled < m {
+				for part < len(parts) && offset == len(parts[part]) {
+					part++
+					offset = 0
+				}
+				n := min(m-filled, len(parts[part])-offset)
+				if &payload[filled] != &parts[part][offset] {
+					copy(payload[filled:filled+n], parts[part][offset:offset+n])
+				}
+				filled += n
+				offset += n
+			}
+			record, err = c.out.encrypt(record, payload, c.config.rand())
+			if err != nil {
+				return written, err
+			}
+			records[count] = record
+			sizes[count] = m
+			wireSizes[count] = len(record)
+			count++
+			remaining -= m
+		}
+		if err = mapped.NSSFlushRecordBatch(); err != nil {
+			return written, err
+		}
+		bufs := net.Buffers(records[:count])
+		n, err := bufs.WriteTo(c.conn)
+		c.bytesSent += n
+		left := n
+		for i := 0; i < count; i++ {
+			if left < int64(wireSizes[i]) {
+				break
+			}
+			written += sizes[i]
+			left -= int64(wireSizes[i])
+		}
+		if err != nil {
+			return written, err
+		}
+		if len(bufs) != 0 {
+			return written, io.ErrShortWrite
+		}
+	}
+	return written, nil
+}
+
+type nssPrefetchedRecord struct {
+	input, plain []byte
+	err          error
+}
+
+func (hc *halfConn) nssOpenRecord(mapped nssMappedAEAD, nonce, payload, aad []byte) ([]byte, error) {
+	if len(hc.nssPrefetched) > 0 {
+		r := hc.nssPrefetched[0]
+		if len(payload) > 0 && len(r.input) > 0 && &r.input[0] == &payload[0] && len(r.input) == len(payload) {
+			hc.nssPrefetched[0] = nssPrefetchedRecord{}
+			hc.nssPrefetched = hc.nssPrefetched[1:]
+			return r.plain, r.err
+		}
+		hc.nssPrefetched = nil
+	}
+	return mapped.NSSOpenRecord(nonce, payload, aad)
+}
+func (c *Conn) nssPrefetchRecords() {
+	if len(c.in.nssPrefetched) > 0 {
+		return
+	}
+	mapped := nssBatchRecords(c.in.cipher)
+	if mapped == nil || mapped.NSSBatchSize() < 2 {
+		return
+	}
+	raw := c.rawInput.Bytes()
+	seq := c.in.seq
+	nonces := &c.in.nssPrefetchNonce
+	aadStore := &c.in.nssPrefetchAADStore
+	inputs, aads := &c.in.nssPrefetchInput, &c.in.nssPrefetchAAD
+	defer func() { clear(inputs[:]); clear(aads[:]) }()
+	count := 0
+	limit := mapped.NSSBatchSize()
+	if limit > 16 {
+		limit = 16
+	}
+	for count < limit && len(raw) >= 5 {
+		if raw[0] != byte(recordTypeApplicationData) || raw[1] != 3 || raw[2] != 3 {
+			break
+		}
+		n := int(raw[3])<<8 | int(raw[4])
+		explicit := c.in.explicitNonceLen()
+		if n < explicit+16 || n > maxCiphertext || n+5 > len(raw) {
+			break
+		}
+		record := raw[:5+n]
+		payload := record[5+explicit:]
+		if explicit == 8 {
+			copy(nonces[count][:], record[5:13])
+		} else if explicit == 0 {
+			copy(nonces[count][:], seq[:])
+		} else {
+			break
+		}
+		if c.vers == VersionTLS13 {
+			copy(aadStore[count][:], record[:5])
+			aads[count] = aadStore[count][:5]
+		} else {
+			copy(aadStore[count][:8], seq[:])
+			copy(aadStore[count][8:11], record[:3])
+			plainLen := len(payload) - 16
+			aadStore[count][11] = byte(plainLen >> 8)
+			aadStore[count][12] = byte(plainLen)
+			aads[count] = aadStore[count][:]
+		}
+		inputs[count] = payload
+		count++
+		raw = raw[n+5:]
+		j := 7
+		for ; j >= 0; j-- {
+			seq[j]++
+			if seq[j] != 0 {
+				break
+			}
+		}
+		if j < 0 {
+			break
+		}
+	}
+	if count < 2 {
+		return
+	}
+	plains, errs := mapped.NSSOpenRecords(nonces[:count], inputs[:count], aads[:count])
+	c.in.nssPrefetched = c.in.nssPrefetchStorage[:count]
+	for i := 0; i < count; i++ {
+		c.in.nssPrefetched[i] = nssPrefetchedRecord{inputs[i], plains[i], errs[i]}
+	}
+}
+
+// NSSReadBuffers fills caller-owned buffers from the current record and already
+// authenticated application records. Only the initial read may wait for input.
+// Normal readRecord processing still advances sequence numbers and validates
+// record types; speculative plaintext is never exposed directly to the caller.
+func (c *Conn) NSSReadBuffers(parts [][]byte) (int, error) {
+	if err := c.Handshake(); err != nil {
+		return 0, err
+	}
+	nonempty := false
+	for _, p := range parts {
+		nonempty = nonempty || len(p) != 0
+	}
+	if !nonempty {
+		return 0, nil
+	}
+	c.in.Lock()
+	defer c.in.Unlock()
+	for c.input.Len() == 0 {
+		if err := c.readRecord(); err != nil {
+			return 0, err
+		}
+		for c.hand.Len() > 0 {
+			if err := c.handlePostHandshakeMessage(); err != nil {
+				return 0, err
+			}
+		}
+	}
+	n := 0
+	for _, p := range parts {
+		for len(p) > 0 {
+			if c.input.Len() == 0 {
+				if !c.nssReadyApplicationRecord() {
+					return n, nil
+				}
+				if err := c.readRecord(); err != nil {
+					return n, err
+				}
+			}
+			copied, _ := c.input.Read(p)
+			n += copied
+			p = p[copied:]
+			// Preserve ordinary Read's eager handling of a queued TLS 1.2
+			// close-notify, including returning data together with EOF.
+			if c.input.Len() == 0 && c.rawInput.Len() > 0 &&
+				recordType(c.rawInput.Bytes()[0]) == recordTypeAlert {
+				if err := c.readRecord(); err != nil {
+					return n, err
+				}
+			}
+		}
+	}
+	return n, nil
+}
+
+// Called with c.in held. Stop before errors, empty records and post-handshake
+// messages: ordinary Read handles those on the next call, where waiting is OK.
+func (c *Conn) nssReadyApplicationRecord() bool {
+	if c.in.err != nil || c.hand.Len() != 0 || len(c.in.nssPrefetched) == 0 {
+		return false
+	}
+	raw := c.rawInput.Bytes()
+	if len(raw) < recordHeaderLen || recordType(raw[0]) != recordTypeApplicationData {
+		return false
+	}
+	n := int(raw[3])<<8 | int(raw[4])
+	offset := recordHeaderLen + c.in.explicitNonceLen()
+	if n+recordHeaderLen > len(raw) || offset >= n+recordHeaderLen {
+		return false
+	}
+	r := c.in.nssPrefetched[0]
+	if r.err != nil || len(r.input) != n+recordHeaderLen-offset ||
+		len(r.input) == 0 || &r.input[0] != &raw[offset] {
+		return false
+	}
+	if c.vers != VersionTLS13 {
+		return len(r.plain) > 0
+	}
+	for i := len(r.plain) - 1; i >= 0; i-- {
+		if r.plain[i] != 0 {
+			return i > 0 && recordType(r.plain[i]) == recordTypeApplicationData
+		}
+	}
+	return false
+}
