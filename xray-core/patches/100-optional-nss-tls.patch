+type batchMappedRequest struct{ nonce, plain, aad, out []byte }
+type batchMappedTestAEAD struct {
+	*mappedTestAEAD
+	queued       bool
+	requests     []batchMappedRequest
+	seals, opens []int
+}
+
+func newBatchMappedTestAEAD(t *testing.T) *batchMappedTestAEAD {
+	g := newMappedTestAEAD(t)
+	g.input = make([]byte, 4*32768)
+	g.output = make([]byte, 4*32768)
+	return &batchMappedTestAEAD{mappedTestAEAD: g}
+}
+func (g *batchMappedTestAEAD) NSSBatchSize() int                 { return 4 }
+func (g *batchMappedTestAEAD) NSSBeginRecordBatch() (int, error) { g.queued = true; return 4, nil }
+func (g *batchMappedTestAEAD) NSSAbortRecordBatch()              { g.queued = false; g.requests = nil }
+func (g *batchMappedTestAEAD) NSSSealRecord(prefix, nonce, plain, aad []byte) ([]byte, error) {
+	slot := len(g.requests)
+	out := g.output[slot*32768 : slot*32768+len(prefix)+len(plain)+16]
+	copy(out, prefix)
+	g.requests = append(g.requests, batchMappedRequest{append([]byte(nil), nonce...), plain, append([]byte(nil), aad...), out})
+	return out, nil
+}
+func (g *batchMappedTestAEAD) NSSFlushRecordBatch() error {
+	g.seals = append(g.seals, len(g.requests))
+	for _, r := range g.requests {
+		g.cpu.Seal(r.out[:len(r.aad)], r.nonce, r.plain, r.aad)
+	}
+	g.requests = nil
+	return nil
+}
+func (g *batchMappedTestAEAD) NSSOpenRecord(nonce, input, aad []byte) ([]byte, error) {
+	return g.cpu.Open(g.output[:0], nonce, input, aad)
+}
+func (g *batchMappedTestAEAD) NSSOpenRecords(nonces [][12]byte, inputs, aads [][]byte) ([][]byte, []error) {
+	g.opens = append(g.opens, len(inputs))
+	out := make([][]byte, len(inputs))
+	errs := make([]error, len(inputs))
+	for i := range inputs {
+		out[i], errs[i] = g.cpu.Open(g.output[i*32768:i*32768], nonces[i][:], inputs[i], aads[i])
+	}
+	return out, errs
+}
