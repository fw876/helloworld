@@ -0,0 +1,467 @@
+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+//go:build linux && arm64
+
+package cipher
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"runtime"
+	"strconv"
+	"sync"
+	"syscall"
+	"unsafe"
+)
+
+const nssDMACapacity = 32768
+
+type nssDMAInit struct {
+	ABI, KeyLen     uint32
+	Key             [32]byte
+	Capacity, Slots uint32
+	FD              int32
+	Reserved        uint32
+}
+type nssDMARequest struct {
+	Slot, Offset, Len, AAD, Op, Reserved uint32
+	Nonce                                [12]byte
+	Status                               int32
+}
+type nssDMABatch struct {
+	Count, Reserved uint32
+	Req             [16]nssDMARequest
+}
+
+type nssDMA struct {
+	mu          sync.Mutex
+	file        *os.File
+	mem         []byte
+	fallback    AEAD
+	borrowers   int
+	closed      bool
+	slots       int
+	writeQueued bool
+	pending     nssDMABatch
+	pendingAAD  [16][13]byte
+	records     [16][]byte
+	expected    [16][]byte
+	readOutput  [16][]byte
+	readErrors  [16]error
+	readBatch   nssDMABatch
+	singleBatch nssDMABatch
+	cpuOnly     bool
+}
+
+func newNSSDMA(key []byte, fallback AEAD) AEAD {
+	slots := 16
+	if v, err := strconv.Atoi(os.Getenv("XRAY_NSS_DMA_BATCH")); err == nil && v >= 1 && v <= 16 {
+		slots = v
+	}
+	if nssMode == "cpu-batch" {
+		// Benchmark control: identical record assembly, batching and socket writes,
+		// but CPU AES-GCM and ordinary Go memory. It never opens an NSS device.
+		g := &nssDMA{mem: make([]byte, 2*nssDMACapacity*slots), fallback: fallback, slots: slots, cpuOnly: true}
+		runtime.SetFinalizer(g, (*nssDMA).Close)
+		return g
+	}
+
+	fail := func(err error) AEAD { nssFallbacks.Add(1); nssWarning(err); return fallback }
+	f, err := os.OpenFile("/dev/nss-crypto-dmabuf", os.O_RDWR, 0)
+	if err != nil {
+		return fail(err)
+	}
+
+	init := nssDMAInit{ABI: 3, KeyLen: uint32(len(key)), Capacity: nssDMACapacity, Slots: uint32(slots), FD: -1}
+	copy(init.Key[:], key)
+	err = nssDMAIoctl(f, 0xc0384e60, unsafe.Pointer(&init))
+	clear(init.Key[:])
+	if err != nil {
+		f.Close()
+		return fail(err)
+	}
+	mem, err := syscall.Mmap(int(init.FD), 0, 2*nssDMACapacity*slots, syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_SHARED)
+	syscall.Close(int(init.FD)) // mmap retains the exported buffer's file reference.
+	if err != nil {
+		f.Close()
+		return fail(err)
+	}
+	g := &nssDMA{file: f, mem: mem, fallback: fallback, slots: slots}
+	nssCreated.Add(1)
+	runtime.SetFinalizer(g, (*nssDMA).Close)
+	return g
+}
+func (g *nssDMA) NonceSize() int { return 12 }
+func (g *nssDMA) Overhead() int  { return 16 }
+func (g *nssDMA) Close() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if !g.closed {
+		g.closed = true
+		if !g.cpuOnly {
+			g.file.Close()
+			g.file = nil
+			nssClosed.Add(1)
+		}
+	}
+	g.releaseMappingLocked()
+}
+func (g *nssDMA) releaseMappingLocked() {
+	if g.closed && g.borrowers == 0 && g.mem != nil {
+		if g.cpuOnly {
+			clear(g.mem)
+		} else {
+			syscall.Munmap(g.mem)
+		}
+		g.mem = nil
+	}
+}
+
+// Borrowed record storage remains mapped across key changes/Close until the
+// TLS record owner releases it. Generic AEAD results never borrow this storage.
+func (g *nssDMA) NSSRecordBuffers() (in, out []byte, release func()) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		return nil, nil, nil
+	}
+	g.borrowers++
+	var once sync.Once
+	return g.mem[:g.inputSize():g.inputSize()], g.mem[g.inputSize():], func() { once.Do(func() { g.mu.Lock(); defer g.mu.Unlock(); g.borrowers--; g.releaseMappingLocked() }) }
+}
+func (g *nssDMA) Seal(dst, nonce, plaintext, aad []byte) []byte {
+	// Compatibility only. Never disguise a heap->CMA copy as zero-copy.
+	nssFallbacks.Add(1)
+	nssWarning(errors.New("DMA-BUF requires the mapped TLS record API"))
+	return g.fallback.Seal(dst, nonce, plaintext, aad)
+}
+func (g *nssDMA) Open(dst, nonce, ciphertext, aad []byte) ([]byte, error) {
+	nssFallbacks.Add(1)
+	nssWarning(errors.New("DMA-BUF requires the mapped TLS record API"))
+	return g.fallback.Open(dst, nonce, ciphertext, aad)
+}
+func (g *nssDMA) runLocked(op uint32, nonce, input, aad []byte) ([]byte, error) {
+	if g.closed || len(nonce) != 12 || (len(input) == 0 && (op == 2 || len(aad) == 0)) || len(aad) > 255 {
+		return nil, errors.New("invalid mapped NSS record")
+	}
+	base := uintptr(unsafe.Pointer(&g.mem[0]))
+	start := uintptr(unsafe.Pointer(unsafe.SliceData(input)))
+	if start < base+uintptr(len(aad)) || start-base > uintptr(g.inputSize()) || uintptr(len(input)) > uintptr(g.inputSize())-(start-base) {
+		return nil, errors.New("TLS payload is not in its CMA input slot")
+	}
+	offset := int(start-base) - len(aad)
+	total := len(input) + len(aad)
+	if op != 2 {
+		total += 16
+	}
+	if total > nssMaxRequest || total > nssDMACapacity {
+		return nil, syscall.EMSGSIZE
+	}
+	// Only AAD metadata is copied. The payload already resides in CMA.
+	copy(g.mem[offset:offset+len(aad)], aad)
+	g.singleBatch = nssDMABatch{Count: 1}
+	b := &g.singleBatch
+	r := &b.Req[0]
+	r.Offset = uint32(offset)
+	r.Len = uint32(len(input))
+	r.AAD = uint32(len(aad))
+	r.Op = op
+	copy(r.Nonce[:], nonce)
+	if err := g.executeBatch(b); err != nil {
+		return nil, err
+	}
+	runtime.KeepAlive(g.mem)
+	if r.Status != 0 {
+		return nil, syscall.Errno(-r.Status)
+	}
+	size := len(input) + 16
+	if op == 2 {
+		size = len(input) - 16
+	}
+	if size < 0 {
+		return nil, syscall.EBADMSG
+	}
+	return g.mem[g.inputSize()+len(aad) : g.inputSize()+len(aad)+size], nil
+}
+func (g *nssDMA) NSSSealRecord(prefix, nonce, plaintext, aad []byte) ([]byte, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed || len(prefix) > 13 || len(prefix) != len(aad) {
+		return nil, errors.New("invalid NSS record prefix")
+	}
+	if g.writeQueued {
+		return g.queueSealLocked(prefix, nonce, plaintext, aad)
+	}
+	var header [13]byte
+	copy(header[:], prefix)
+	var expected []byte
+	if nssVerify {
+		expected = g.fallback.Seal(nil, nonce, plaintext, aad)
+	}
+	result, err := g.runLocked(1, nonce, plaintext, aad)
+	if err == nil && nssVerify && !bytes.Equal(result, expected) {
+		err = errors.New("DMA-BUF encryption failed CPU verification")
+	}
+	out := g.mem[g.inputSize() : g.inputSize()+len(prefix)]
+	if err != nil {
+		nssFallbacks.Add(1)
+		nssWarning(err)
+		if nssVerify {
+			out = append(out, expected...)
+		} else {
+			out = g.fallback.Seal(out, nonce, plaintext, aad)
+		}
+	} else {
+		if !g.cpuOnly {
+			nssSeals.Add(1)
+		}
+		out = g.mem[g.inputSize() : g.inputSize()+len(prefix)+len(result)]
+	}
+	copy(out, header[:len(prefix)])
+	return out, nil
+}
+func (g *nssDMA) NSSOpenRecord(nonce, ciphertext, aad []byte) ([]byte, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed {
+		return nil, errors.New("NSS session closed")
+	}
+	var expected []byte
+	var expectedErr error
+	if nssVerify {
+		expected, expectedErr = g.fallback.Open(nil, nonce, ciphertext, aad)
+	}
+	result, err := g.runLocked(2, nonce, ciphertext, aad)
+	if err == nil && nssVerify && (expectedErr != nil || !bytes.Equal(result, expected)) {
+		err = errors.New("DMA-BUF decryption failed CPU verification")
+	}
+	if err == nil {
+		if !g.cpuOnly {
+			nssOpens.Add(1)
+		}
+		return result, nil
+	}
+	if err == syscall.EBADMSG {
+		return nil, errors.New("cipher: message authentication failed")
+	}
+	nssFallbacks.Add(1)
+	nssWarning(err)
+	if nssVerify {
+		if expectedErr != nil {
+			return nil, expectedErr
+		}
+		return append(g.mem[g.inputSize():g.inputSize()], expected...), nil
+	}
+	return g.fallback.Open(g.mem[g.inputSize():g.inputSize()], nonce, ciphertext, aad)
+}
+
+func (g *nssDMA) inputSize() int {
+	if g.slots == 0 {
+		return nssDMACapacity
+	}
+	return g.slots * nssDMACapacity
+}
+func (g *nssDMA) NSSBeginRecordBatch() (int, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.closed || g.writeQueued {
+		return 0, errors.New("invalid NSS batch state")
+	}
+	g.writeQueued = true
+	g.pending = nssDMABatch{}
+	return g.inputSize() / nssDMACapacity, nil
+}
+func (g *nssDMA) NSSAbortRecordBatch() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.writeQueued = false
+	g.pending = nssDMABatch{}
+	clear(g.records[:])
+	clear(g.expected[:])
+}
+func (g *nssDMA) prepareRequest(slot int, op uint32, nonce, input, aad []byte) (nssDMARequest, error) {
+	r := nssDMARequest{Slot: uint32(slot), Op: op, Len: uint32(len(input)), AAD: uint32(len(aad))}
+	if g.closed || len(nonce) != 12 || (len(input) == 0 && (op == 2 || len(aad) == 0)) || len(aad) > 255 || slot < 0 || slot >= g.inputSize()/nssDMACapacity {
+		return r, errors.New("invalid NSS batch record")
+	}
+	base := uintptr(unsafe.Pointer(&g.mem[0]))
+	start := uintptr(unsafe.Pointer(unsafe.SliceData(input)))
+	if start < base+uintptr(len(aad)) || start-base > uintptr(g.inputSize()) || uintptr(len(input)) > uintptr(g.inputSize())-(start-base) {
+		return r, errors.New("NSS batch payload outside CMA input")
+	}
+	total := len(input) + len(aad)
+	if op != 2 {
+		total += 16
+	}
+	if total > nssMaxRequest || total > nssDMACapacity || (op == 2 && len(input) < 16) {
+		return r, syscall.EMSGSIZE
+	}
+	r.Offset = uint32(start-base) - uint32(len(aad))
+	copy(r.Nonce[:], nonce)
+	return r, nil
+}
+func (g *nssDMA) queueSealLocked(prefix, nonce, plaintext, aad []byte) ([]byte, error) {
+	slot := int(g.pending.Count)
+	r, err := g.prepareRequest(slot, 3, nonce, plaintext, aad)
+	if err != nil {
+		return nil, err
+	}
+	if nssVerify {
+		g.expected[slot] = g.fallback.Seal(nil, nonce, plaintext, aad)
+	}
+	out := g.mem[slot*nssDMACapacity : slot*nssDMACapacity+len(prefix)+len(plaintext)+16]
+	copy(out, prefix)
+	copy(g.pendingAAD[slot][:], aad)
+	g.pending.Req[slot] = r
+	g.pending.Count++
+	g.records[slot] = out
+	return out, nil
+}
+func (g *nssDMA) NSSFlushRecordBatch() error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if !g.writeQueued || g.closed {
+		return errors.New("NSS batch is not open")
+	}
+	defer func() { g.pending = nssDMABatch{}; clear(g.records[:]); clear(g.expected[:]) }()
+	if g.pending.Count == 0 {
+		return nil
+	}
+	var headers [16][13]byte
+	for i := 0; i < int(g.pending.Count); i++ {
+		r := g.pending.Req[i]
+		copy(headers[i][:], g.records[i][:r.AAD])
+		copy(g.mem[int(r.Offset):int(r.Offset+r.AAD)], g.pendingAAD[i][:r.AAD])
+	}
+	err := g.executeBatch(&g.pending)
+	runtime.KeepAlive(g.mem)
+	for i := 0; i < int(g.pending.Count); i++ {
+		r := g.pending.Req[i]
+		out := g.records[i]
+		copy(out[:r.AAD], headers[i][:r.AAD])
+		if err == nil && r.Status != 0 {
+			err = syscall.Errno(-r.Status)
+		}
+		if err == nil && nssVerify && !bytes.Equal(out[r.AAD:], g.expected[i]) {
+			err = errors.New("NSS batched seal failed CPU verification")
+		}
+	}
+	if err != nil {
+		return err
+	} // Never expose a partially successful batch as TLS data.
+	if !g.cpuOnly {
+		nssSeals.Add(uint64(g.pending.Count))
+	}
+	return nil
+}
+
+// Nonces are complete 12-byte GCM nonces. Inputs remain intact for key-update
+// lookahead invalidation; output slices borrow distinct slots until next RUN.
+func (g *nssDMA) NSSOpenRecords(nonces [][12]byte, inputs, aads [][]byte) ([][]byte, []error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	n := len(inputs)
+	if n > 16 {
+		return nil, nil
+	}
+	clear(g.readOutput[:])
+	clear(g.readErrors[:])
+	out := g.readOutput[:n]
+	errs := g.readErrors[:n]
+	if n == 0 {
+		return out, errs
+	}
+	if n > g.inputSize()/nssDMACapacity || len(nonces) != n || len(aads) != n || g.closed {
+		for i := range errs {
+			errs[i] = errors.New("invalid NSS read batch")
+		}
+		return out, errs
+	}
+	g.readBatch = nssDMABatch{Count: uint32(n)}
+	b := &g.readBatch
+	var saved [16][255]byte
+	var expected [16][]byte
+	var expectedErr [16]error
+	for i := 0; i < n; i++ {
+		r, err := g.prepareRequest(i, 2, nonces[i][:], inputs[i], aads[i])
+		if err != nil {
+			for j := range errs {
+				errs[j] = err
+			}
+			return out, errs
+		}
+		b.Req[i] = r
+		copy(saved[i][:], g.mem[int(r.Offset):int(r.Offset)+len(aads[i])])
+		if nssVerify {
+			expected[i], expectedErr[i] = g.fallback.Open(nil, nonces[i][:], inputs[i], aads[i])
+		}
+	}
+	for i := 0; i < n; i++ {
+		r := b.Req[i]
+		copy(g.mem[int(r.Offset):int(r.Offset)+len(aads[i])], aads[i])
+	}
+	err := g.executeBatch(b)
+	runtime.KeepAlive(g.mem)
+	for i := 0; i < n; i++ {
+		r := b.Req[i]
+		copy(g.mem[int(r.Offset):int(r.Offset)+len(aads[i])], saved[i][:len(aads[i])])
+		errs[i] = err
+		if err == nil && r.Status != 0 {
+			errs[i] = syscall.Errno(-r.Status)
+		}
+		if errs[i] == nil {
+			start := g.inputSize() + i*nssDMACapacity + len(aads[i])
+			out[i] = g.mem[start : start+len(inputs[i])-16]
+			if nssVerify && (expectedErr[i] != nil || !bytes.Equal(out[i], expected[i])) {
+				out[i] = nil
+				errs[i] = errors.New("NSS batched open failed CPU verification")
+			}
+		}
+		if errs[i] == nil {
+			if !g.cpuOnly {
+				nssOpens.Add(1)
+			}
+		}
+	}
+	return out, errs
+}
+func (g *nssDMA) NSSBatchSize() int { return g.inputSize() / nssDMACapacity }
+
+// These ABI structures contain no Go pointers and the ioctl is synchronous.
+// Passing the pointer directly in Syscall follows the syscall package's pointer
+// liveness convention. No nested Go buffers need pinning, unlike cryptodev.
+func nssDMAIoctl(f *os.File, request uintptr, arg unsafe.Pointer) error {
+	_, _, e := syscall.Syscall(syscall.SYS_IOCTL, f.Fd(), request, uintptr(arg))
+	runtime.KeepAlive(arg)
+	runtime.KeepAlive(f)
+	if e != 0 {
+		return e
+	}
+	return nil
+}
+
+func (g *nssDMA) executeBatch(b *nssDMABatch) error {
+	if !g.cpuOnly {
+		return nssDMAIoctl(g.file, 0xc2884e61, unsafe.Pointer(b))
+	}
+	for i := 0; i < int(b.Count); i++ {
+		r := &b.Req[i]
+		in := g.mem[int(r.Offset) : int(r.Offset)+int(r.AAD+r.Len)]
+		start := g.inputSize() + int(r.Slot)*nssDMACapacity
+		if r.Op == 3 {
+			start = int(r.Offset)
+		}
+		out := g.mem[start : start+nssDMACapacity]
+		copy(out[:r.AAD], in[:r.AAD])
+		r.Status = 0
+		if r.Op != 2 {
+			g.fallback.Seal(out[:r.AAD], r.Nonce[:], in[r.AAD:], in[:r.AAD])
+		} else {
+			if _, err := g.fallback.Open(out[:r.AAD], r.Nonce[:], in[r.AAD:], in[:r.AAD]); err != nil {
+				r.Status = -int32(syscall.EBADMSG)
+				clear(out)
+			}
+		}
+	}
+	return nil
+}
