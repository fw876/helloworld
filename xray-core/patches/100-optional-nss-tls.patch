+// SPDX-License-Identifier: MPL-2.0
+package tls
+
+import (
+	"github.com/xtls/xray-core/common/buf"
+	"os"
+)
+
+var nssDirectReadEnabled = (os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch") && os.Getenv("XRAY_NSS_TX_DIRECT") == "1"
+
+func nssCopyReadyFrom(writer any, reader buf.Reader, observe func(buf.MultiBuffer)) (bool, error, error) {
+	if !nssDirectReadEnabled {
+		return false, nil, nil
+	}
+	source, ok := reader.(interface {
+		NSSCanReadReady() bool
+		NSSReadReadyBuffers([][]byte) (int, error)
+	})
+	if !ok || !source.NSSCanReadReady() {
+		return false, nil, nil
+	}
+	target, ok := writer.(interface {
+		NSSWriteFromReady(func([][]byte) (int, error), func([][]byte)) (bool, error, error)
+	})
+	if !ok {
+		return false, nil, nil
+	}
+	return target.NSSWriteFromReady(source.NSSReadReadyBuffers, func(parts [][]byte) {
+		if observe != nil {
+			mb := buf.BorrowMulti(parts, func() {})
+			observe(mb)
+			buf.ReleaseMulti(mb)
+		}
+	})
+}
+func (c *Conn) NSSCopyReadyFrom(reader buf.Reader, observe func(buf.MultiBuffer)) (bool, error, error) {
+	return nssCopyReadyFrom(c.Conn, reader, observe)
+}
+func (c *UConn) NSSCopyReadyFrom(reader buf.Reader, observe func(buf.MultiBuffer)) (bool, error, error) {
+	return nssCopyReadyFrom(c.UConn, reader, observe)
+}
