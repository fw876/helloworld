--- a/_nss/xray_nss_batch.go
+++ b/_nss/xray_nss_batch.go
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: MPL-2.0
+package tls
+
+import (
+	"io"
+	"os"
+	"sync"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+var nssBatchEnabled = (os.Getenv("XRAY_NSS_TLS") == "cryptodev" || os.Getenv("XRAY_NSS_TLS") == "1" || (os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch")) && os.Getenv("XRAY_NSS_TLS_BATCH") != "0"
+
+var nssBatchBytes = func() int {
+	if os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch" {
+		return 65536
+	}
+	return 16384
+}()
+var nssRecordPool = sync.Pool{New: func() any { return make([]byte, nssBatchBytes) }}
+
+// Batch only bytes already supplied by this call. Never wait for another read,
+// and retain the standard TLS record limit and normal short-write semantics.
+func nssWriteMultiBuffer(w io.Writer, mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	if os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch" {
+		if direct, ok := w.(interface{ NSSWriteBuffers([][]byte) (int, error) }); ok {
+			var local [8][]byte
+			parts := local[:0]
+			total := 0
+			for _, b := range mb {
+				parts = append(parts, b.Bytes())
+				total += int(b.Len())
+			}
+			n, err := direct.NSSWriteBuffers(parts)
+			if err == nil && n != total {
+				err = io.ErrShortWrite
+			}
+			return err
+		}
+	}
+	if len(mb) <= 1 {
+		for _, b := range mb {
+			if err := nssWriteAll(w, b.Bytes()); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	block := nssRecordPool.Get().([]byte)
+	defer func() {
+		clear(block[:])
+		nssRecordPool.Put(block)
+	}()
+	n := 0
+	for _, b := range mb {
+		p := b.Bytes()
+		for len(p) > 0 {
+			copied := copy(block[n:], p)
+			n += copied
+			p = p[copied:]
+			if n == len(block) {
+				if err := nssWriteAll(w, block[:]); err != nil {
+					return err
+				}
+				n = 0
+			}
+		}
+	}
+	if n > 0 {
+		return nssWriteAll(w, block[:n])
+	}
+	return nil
+}
+
+func nssWriteAll(w io.Writer, p []byte) error {
+	for len(p) > 0 {
+		n, err := w.Write(p)
+		if n < 0 || n > len(p) {
+			return io.ErrShortWrite
+		}
+		p = p[n:]
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+func (c *UConn) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if nssBatchEnabled {
+		return nssWriteMultiBuffer(c.UConn, mb)
+	}
+	return buf.NewWriter(c.UConn).WriteMultiBuffer(mb)
+}
+
+var nssReadBatchEnabled = (os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch") && os.Getenv("XRAY_NSS_READ_BATCH") == "1"
+
+var nssReadBorrowEnabled = (os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch") && os.Getenv("XRAY_NSS_READ_BORROW") == "1"
+
+func nssReadMultiBuffer(r io.Reader) (buf.MultiBuffer, error) {
+	if nssReadBorrowEnabled {
+		if reader, ok := r.(interface {
+			NSSBorrowRecords() ([][]byte, func(), error)
+		}); ok {
+			parts, release, err := reader.NSSBorrowRecords()
+			if release == nil {
+				return nil, err
+			}
+			return buf.BorrowMulti(parts, release), err
+		}
+	}
+	bulk, ok := r.(interface{ NSSReadBuffers([][]byte) (int, error) })
+	if !nssReadBatchEnabled || !ok {
+		return (&buf.SingleReader{Reader: r}).ReadMultiBuffer()
+	}
+	// One pool-owned allocation avoids 32 small-buffer allocations and lets
+	// the downstream socket send a contiguous chunk. Buffer.NewWithSize
+	// retains normal MultiBuffer ownership and release semantics.
+	const capacity = 128 * 1024
+	b := buf.NewWithSize(capacity)
+	parts := [1][]byte{b.Extend(capacity)}
+	n, err := bulk.NSSReadBuffers(parts[:])
+	if n < 0 || n > capacity {
+		n, err = 0, io.ErrShortBuffer
+	}
+	if n == 0 {
+		b.Release()
+		return nil, err
+	}
+	b.Resize(0, int32(n))
+	return buf.MultiBuffer{b}, err
+}
+func (c *Conn) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	return nssReadMultiBuffer(c.Conn)
+}
+func (c *UConn) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	return nssReadMultiBuffer(c.UConn)
+}
