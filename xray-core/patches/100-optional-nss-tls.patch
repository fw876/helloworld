+func TestNSSBatchRetriesPrefetchAfterTrafficKeyUpdate(t *testing.T) {
+	old, next := newBatchMappedTestAEAD(t), newBatchMappedTestAEAD(t)
+	block, err := aes.NewCipher(bytes.Repeat([]byte{1}, 16))
+	if err != nil {
+		t.Fatal(err)
+	}
+	next.cpu, err = cipher.NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	record := func(g cipher.AEAD, plain []byte, typ byte) []byte {
+		p := append(append([]byte(nil), plain...), typ)
+		n := len(p) + 16
+		header := []byte{23, 3, 3, byte(n >> 8), byte(n)}
+		return g.Seal(header, make([]byte, 12), p, header)
+	}
+	update := []byte{24, 0, 0, 1, 0}
+	first := record(old.cpu, update, 22)
+	second := record(next.cpu, []byte("new key payload"), 23)
+	c := &Conn{vers: VersionTLS13, in: batchHalf(VersionTLS13, old)}
+	c.nssPrepareInput()
+	n := copy(old.input, first)
+	n += copy(old.input[n:], second)
+	c.rawInput = *bytes.NewBuffer(old.input[:n])
+	c.nssPrefetchRecords()
+	if len(c.in.nssPrefetched) != 2 || c.in.nssPrefetched[1].err == nil {
+		t.Fatal("lookahead should reject the next traffic key")
+	}
+	p, typ, err := c.in.decrypt(c.rawInput.Next(len(first)))
+	if err != nil || typ != recordTypeHandshake || !bytes.Equal(p, update) {
+		t.Fatalf("key update record %v %v", typ, err)
+	}
+	old.Close()
+	c.in.cipher = &xorNonceAEAD{aead: next}
+	c.in.seq = [8]byte{}
+	c.nssPrepareInput()
+	defer c.nssReleaseInput()
+	if !bytes.Equal(c.rawInput.Bytes(), second) {
+		t.Fatal("speculative decrypt changed future ciphertext")
+	}
+	p, typ, err = c.in.decrypt(c.rawInput.Next(len(second)))
+	if err != nil || typ != recordTypeApplicationData || string(p) != "new key payload" {
+		t.Fatalf("new-key retry %v %v %q", typ, err, p)
+	}
+}
