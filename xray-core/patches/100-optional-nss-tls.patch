+#!/usr/bin/env python3
+"""Build an isolated Go overlay; never edit the shared SDK or module cache."""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+source = Path(__file__).resolve().parent
+project, dest = map(lambda p: Path(p).resolve(), sys.argv[1:])
+def go(*args):
+    return subprocess.check_output(['go', *args], cwd=project, text=True).strip()
+goroot = Path(go('env', 'GOROOT')).resolve()
+utls = Path(go('list', '-m', '-f', '{{.Dir}}', 'github.com/refraction-networking/utls')).resolve()
+dest.mkdir(parents=True, exist_ok=True)
+replace = {}
+for name, root in [('go', goroot / 'src/crypto/tls'), ('utls', utls)]:
+    target = dest / name
+    if name == "utls":
+        if target.exists():
+            shutil.rmtree(target)
+        shutil.copytree(root, target, copy_function=shutil.copyfile)
+    else:
