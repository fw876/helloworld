+type batchWireConn struct {
+	net.Conn
+	bytes.Buffer
+}
+
+func (c *batchWireConn) Write(p []byte) (int, error) { return c.Buffer.Write(p) }
+func (c *batchWireConn) Read(p []byte) (int, error)  { return c.Buffer.Read(p) }
+func batchHalf(version uint16, g *batchMappedTestAEAD) halfConn {
+	if version == VersionTLS12 {
+		return halfConn{version: version, cipher: &prefixNonceAEAD{aead: g}}
+	}
+	return halfConn{version: version, cipher: &xorNonceAEAD{aead: g}}
+}
