+// SPDX-License-Identifier: MPL-2.0
+//go:build !windows && !wasm && !illumos && !openbsd
+
+package buf
+
+import (
+	"errors"
+	"syscall"
+	"testing"
+)
+
+type badReadvConn struct{ calls int }
+
+func (c *badReadvConn) Control(fn func(uintptr)) error { fn(^uintptr(0)); return nil }
+func (c *badReadvConn) Read(fn func(uintptr) bool) error {
+	c.calls++
+	if !fn(^uintptr(0)) {
+		return errors.New("permanent readv error incorrectly requested a poll wait")
+	}
+	return nil
+}
+func (c *badReadvConn) Write(fn func(uintptr) bool) error { return nil }
+func TestNSSReadvPermanentErrorDoesNotWait(t *testing.T) {
+	conn := &badReadvConn{}
+	reader := &ReadVReader{rawConn: conn, mr: newMultiReader(), alloc: allocStrategy{current: 32}}
+	mb, err := reader.readMulti()
+	if !errors.Is(err, syscall.EBADF) || len(mb) != 0 || conn.calls != 1 {
+		t.Fatalf("readv error: %v buffers=%d calls=%d", err, len(mb), conn.calls)
+	}
+	// An error path must clear stale Go buffer pointers before pool reuse.
+	for _, iov := range reader.mr.(*posixReader).iovecs[:cap(reader.mr.(*posixReader).iovecs)] {
+		if iov.Base != nil {
+			t.Fatal("readv retained a released buffer")
+		}
+	}
+}
