+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+package tls
+
+import (
+	"io"
+	"net"
+)
+
+// NSSWriteFromReady reads plaintext directly into mapped record slots. read MUST
+// be nonblocking: (0,nil) means not ready and leaves the ordinary copy path in
+// charge of waiting. No unrelated socket wait may occur under the TLS write lock.
+// observe runs before encryption and may only inspect the supplied slices during
+// its call. The return values distinguish source errors from TLS write errors.
+func (c *Conn) NSSWriteFromReady(read func([][]byte) (int, error), observe func([][]byte)) (bool, error, error) {
+	// In particular, do not start a handshake before the ordinary reader has data.
+	if !c.isHandshakeComplete.Load() {
+		return false, nil, nil
+	}
+	for {
+		x := c.activeCall.Load()
+		if x&1 != 0 {
+			return true, nil, net.ErrClosed
+		}
+		if c.activeCall.CompareAndSwap(x, x+2) {
+			break
+		}
+	}
+	defer c.activeCall.Add(-2)
+	c.out.Lock()
+	defer c.out.Unlock()
+	// A concurrent TLS 1.2 renegotiation may have started while acquiring
+	// the output lock. Let ordinary Write perform its handshake in that case.
+	if !c.isHandshakeComplete.Load() {
+		return false, nil, nil
+	}
+	if c.out.err != nil {
+		return true, nil, c.out.err
+	}
+	if c.closeNotifySent {
+		return true, nil, errShutdown
+	}
+	mapped := nssBatchRecords(c.out.cipher)
+	if mapped == nil || c.buffering || (c.vers != VersionTLS12 && c.vers != VersionTLS13) {
+		return false, nil, nil
+	}
+	input, _, release := mapped.NSSRecordBuffers()
+	if release == nil {
+		return true, nil, net.ErrClosed
+	}
+	defer release()
+	slots := mapped.NSSBatchSize()
+	if slots < 1 || slots > 16 || len(input)%slots != 0 {
+		return true, nil, io.ErrShortBuffer
+	}
+	capacity := len(input) / slots
+	var storage [16][]byte
+	parts := storage[:slots]
+	defer clear(parts)
+	// Preview the same record sizes that nssWriteScattered will commit if bytes
+	// arrive. An empty nonblocking read must not advance dynamic record sizing.
+	packets := c.packetsSent
+	total := 0
+	for i := range parts {
+		size := c.maxPayloadSizeForWrite(recordTypeApplicationData)
+		offset := i*capacity + recordHeaderLen + c.out.explicitNonceLen()
+		if size+recordHeaderLen+c.out.explicitNonceLen()+32 > capacity {
+			c.packetsSent = packets
+			return true, nil, io.ErrShortBuffer
+		}
+		parts[i] = input[offset : offset+size : offset+size]
+		total += size
+	}
+	c.packetsSent = packets
+	n, readErr := read(parts)
+	if n < 0 || n > total {
+		return true, io.ErrShortBuffer, nil
+	}
+	if n == 0 {
+		return readErr != nil, readErr, nil
+	}
+	left, count := n, 0
+	for count < len(parts) && left > 0 {
+		if len(parts[count]) > left {
+			parts[count] = parts[count][:left]
+		}
+		left -= len(parts[count])
+		count++
+	}
+	parts = parts[:count]
+	if observe != nil {
+		observe(parts)
+	}
+	written, writeErr := c.nssWriteScattered(mapped, parts)
+	if writeErr == nil && written != n {
+		writeErr = io.ErrShortWrite
+	}
+	return true, readErr, c.out.setErrorLocked(writeErr)
+}
