+//go:build linux && (arm64 || amd64)
+
+// SPDX-License-Identifier: MPL-2.0
+package buf
+
+import (
+	"io"
+	"net"
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+// Only plain TCP is eligible. A wrapper may expose a raw fd while transforming
+// reads; bypassing such a wrapper would change the byte stream or its accounting.
+func (r *ReadVReader) NSSCanReadReady() bool { _, ok := r.Reader.(*net.TCPConn); return ok }
+func (r *ReadVReader) NSSReadReadyBuffers(parts [][]byte) (int, error) {
+	if !r.NSSCanReadReady() || len(parts) == 0 || len(parts) > 16 {
+		return 0, syscall.EINVAL
+	}
+	var vec [16]syscall.Iovec
+	for i, p := range parts {
+		if len(p) == 0 {
+			return 0, syscall.EINVAL
+		}
+		vec[i].Base = &p[0]
+		vec[i].SetLen(len(p))
+	}
+	n := 0
+	var readErr error
+	err := r.rawConn.Read(func(fd uintptr) bool {
+		for {
+			count, _, errno := syscall.Syscall(syscall.SYS_READV, fd, uintptr(unsafe.Pointer(&vec[0])), uintptr(len(parts)))
+			if errno == syscall.EINTR {
+				continue
+			}
+			if errno == syscall.EAGAIN || errno == syscall.EWOULDBLOCK {
+				return true
+			}
+			if errno != 0 {
+				readErr = errno
+				return true
+			}
+			n = int(count)
+			if n == 0 {
+				readErr = io.EOF
+			}
+			return true // Never ask netpoll to wait while the TLS writer owns its lock.
+		}
+	})
+	runtime.KeepAlive(parts)
+	if err != nil {
+		return 0, err
+	}
+	if n > 0 && r.counter != nil {
+		r.counter.Add(int64(n))
+	}
+	return n, readErr
+}
