+func TestNSSBatchRecordsRoundTrip(t *testing.T) {
+	for _, version := range []uint16{VersionTLS12, VersionTLS13} {
+		tx, rx := newBatchMappedTestAEAD(t), newBatchMappedTestAEAD(t)
+		wire := &batchWireConn{}
+		writer := &Conn{conn: wire, vers: version, config: &Config{DynamicRecordSizingDisabled: true}, out: batchHalf(version, tx)}
+		plain := bytes.Repeat([]byte("multi record batch"), 6000)
+		writer.isHandshakeComplete.Store(true)
+		parts := [][]byte{nil, plain[:7], plain[7:8200], nil, plain[8200:32769], plain[32769:]}
+		n, err := writer.NSSWriteBuffers(parts)
+		if err != nil || n != len(plain) {
+			t.Fatalf("write %d %v", n, err)
+		}
+		if len(tx.seals) != 2 || tx.seals[0] != 4 || tx.seals[1] != 3 {
+			t.Fatalf("unexpected seal batches %v", tx.seals)
+		}
+		reader := &Conn{vers: version, in: batchHalf(version, rx)}
+		reader.nssPrepareInput()
+		defer reader.nssReleaseInput()
+		copy(rx.input, wire.Bytes())
+		reader.rawInput = *bytes.NewBuffer(rx.input[:wire.Len()])
+		var got []byte
+		for reader.rawInput.Len() > 0 {
+			reader.nssPrefetchRecords()
+			header := reader.rawInput.Bytes()[:5]
+			size := int(header[3])<<8 | int(header[4])
+			record := reader.rawInput.Next(5 + size)
+			p, typ, err := reader.in.decrypt(record)
+			if err != nil || typ != recordTypeApplicationData {
+				t.Fatalf("TLS %x open: %v %v", version, typ, err)
+			}
+			got = append(got, p...)
+		}
+		if !bytes.Equal(got, plain) {
+			t.Fatal("batched stream differs")
+		}
+		if len(rx.opens) != 2 || rx.opens[0] != 4 || rx.opens[1] != 3 {
+			t.Fatalf("unexpected open batches %v", rx.opens)
+		}
+	}
+}
