+func TestNSSDirectRechecksHandshakeAfterWriteLock(t *testing.T) {
+	c := &Conn{conn: &batchWireConn{}, vers: VersionTLS13, config: &Config{}, out: batchHalf(VersionTLS13, newBatchMappedTestAEAD(t))}
+	c.isHandshakeComplete.Store(true)
+	c.out.Lock()
+	done := make(chan bool, 1)
+	go func() {
+		handled, rerr, werr := c.NSSWriteFromReady(func([][]byte) (int, error) { t.Error("read during renegotiation"); return 0, nil }, nil)
+		done <- (!handled && rerr == nil && werr == nil)
+	}()
+	until := time.Now().Add(time.Second)
+	for c.activeCall.Load() == 0 && time.Now().Before(until) {
+		runtime.Gosched()
+	}
+	if c.activeCall.Load() == 0 {
+		c.out.Unlock()
+		t.Fatal("writer did not enter")
+	}
+	c.isHandshakeComplete.Store(false)
+	c.out.Unlock()
+	if !<-done {
+		t.Fatal("handshake state not rechecked")
+	}
+}
