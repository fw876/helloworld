@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: MPL-2.0
+package tls
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+type batchTestWriter struct {
+	bytes.Buffer
+	writes []int
+	limit  int
+	fail   bool
+}
+
+func (w *batchTestWriter) Write(p []byte) (int, error) {
+	w.writes = append(w.writes, len(p))
+	if w.fail {
+		return 0, io.ErrClosedPipe
+	}
+	if w.limit > 0 && len(p) > w.limit {
+		p = p[:w.limit]
+	}
+	return w.Buffer.Write(p)
+}
+
+func batchTestBuffers(sizes ...int) (buf.MultiBuffer, []byte) {
+	var mb buf.MultiBuffer
+	var want []byte
+	for i, size := range sizes {
+		p := bytes.Repeat([]byte{byte(i + 1)}, size)
+		b := buf.New()
+		b.Write(p)
+		mb = append(mb, b)
+		want = append(want, p...)
+	}
+	return mb, want
+}
+
+func TestNSSBatchRecords(t *testing.T) {
+	mb, want := batchTestBuffers(8192, 8192, 8192, 8192, 4096)
+	w := new(batchTestWriter)
+	if err := nssWriteMultiBuffer(w, mb); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(w.Bytes(), want) {
+		t.Fatal("stream changed")
+	}
+	if nssBatchBytes == 16384 {
+		if len(w.writes) != 3 || w.writes[0] != 16384 || w.writes[1] != 16384 || w.writes[2] != 4096 {
+			t.Fatal(w.writes)
+		}
+	} else if len(w.writes) != 1 || w.writes[0] != len(want) {
+		t.Fatal(w.writes)
+	}
+}
+
+func TestNSSBatchFlushAndShortWrite(t *testing.T) {
+	mb, want := batchTestBuffers(23, 41)
+	w := &batchTestWriter{limit: 7}
+	if err := nssWriteMultiBuffer(w, mb); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(w.Bytes(), want) {
+		t.Fatal("short final batch was not flushed")
+	}
+	mb, want = batchTestBuffers(31)
+	w = new(batchTestWriter)
+	if err := nssWriteMultiBuffer(w, mb); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(w.Bytes(), want) || len(w.writes) != 1 {
+		t.Fatal("single buffer was delayed")
+	}
+}
+
+func TestNSSBatchReleasesOnError(t *testing.T) {
+	mb, _ := batchTestBuffers(8192, 8192, 8192)
+	refs := append(buf.MultiBuffer(nil), mb...)
+	if err := nssWriteMultiBuffer(&batchTestWriter{fail: true}, mb); !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatal(err)
+	}
+	for _, b := range refs {
+		if !b.IsEmpty() {
+			t.Fatal("buffer retained after write error")
+		}
+	}
+}
+
+type directBatchWriter struct {
+	got    []byte
+	called bool
+	short  bool
+}
+
+func (w *directBatchWriter) Write([]byte) (int, error) { panic("direct NSS buffer path was bypassed") }
+func (w *directBatchWriter) NSSWriteBuffers(parts [][]byte) (int, error) {
+	w.called = true
+	for _, p := range parts {
+		w.got = append(w.got, p...)
+	}
+	if w.short {
+		return len(w.got) - 1, nil
+	}
+	return len(w.got), nil
+}
+func TestNSSDirectBatchBuffers(t *testing.T) {
+	t.Setenv("XRAY_NSS_TLS", "dmabuf")
+	mb, want := batchTestBuffers(13, 8192, 4096)
+	refs := append(buf.MultiBuffer(nil), mb...)
+	w := &directBatchWriter{}
+	if err := nssWriteMultiBuffer(w, mb); err != nil || !w.called || !bytes.Equal(w.got, want) {
+		t.Fatalf("direct batch: %v", err)
+	}
+	for _, b := range refs {
+		if !b.IsEmpty() {
+			t.Fatal("source buffer retained")
+		}
+	}
+	mb, _ = batchTestBuffers(13, 41)
+	w = &directBatchWriter{short: true}
+	if err := nssWriteMultiBuffer(w, mb); !errors.Is(err, io.ErrShortWrite) {
+		t.Fatal(err)
+	}
+}
+
+type readBatchTestReader struct {
+	data      []byte
+	terminal  error
+	bulkCalls int
+}
+
+func (r *readBatchTestReader) Read(p []byte) (int, error) {
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	return n, r.terminal
+}
+func (r *readBatchTestReader) NSSReadBuffers(parts [][]byte) (int, error) {
+	r.bulkCalls++
+	n := 0
+	for _, p := range parts {
+		k := copy(p, r.data)
+		r.data = r.data[k:]
+		n += k
+	}
+	return n, r.terminal
+}
+func TestNSSReadMultiBufferOwnership(t *testing.T) {
+	old := nssReadBatchEnabled
+	nssReadBatchEnabled = true
+	defer func() { nssReadBatchEnabled = old }()
+	plain := bytes.Repeat([]byte("owned-read"), 6000)
+	r := &readBatchTestReader{data: append([]byte(nil), plain...), terminal: io.EOF}
+	mb, err := nssReadMultiBuffer(r)
+	defer buf.ReleaseMulti(mb)
+	if err != io.EOF || r.bulkCalls != 1 || int(mb.Len()) != len(plain) {
+		t.Fatalf("%v %d %d", err, r.bulkCalls, mb.Len())
+	}
+	var got []byte
+	for _, b := range mb {
+		got = append(got, b.Bytes()...)
+	}
+	if !bytes.Equal(got, plain) {
+		t.Fatal("changed bytes")
+	}
+}
