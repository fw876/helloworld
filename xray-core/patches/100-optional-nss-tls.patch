+func TestNSSBorrowCloseKeepsConsumerAlive(t *testing.T) {
+	reader, _ := nssBufferedReader(t, VersionTLS13, []byte("retained plaintext"))
+	parts, release, err := reader.NSSBorrowRecords()
+	if err != nil {
+		t.Fatal(err)
+	}
+	started := make(chan struct{})
+	finished := make(chan error, 1)
+	go func() {
+		reader.in.Lock()
+		close(started)
+		err := reader.nssWaitReadLease()
+		reader.in.Unlock()
+		finished <- err
+	}()
+	<-started
+	reader.activeCall.Store(1)
+	reader.in.Lock()
+	closeNSSCipher(reader.in.cipher)
+	reader.nssReleaseInput()
+	reader.in.Unlock()
+	if err := <-finished; err != net.ErrClosed {
+		t.Fatal("wait not canceled", err)
+	}
+	if string(parts[0]) != "retained plaintext" {
+		t.Fatal("close invalidated borrowed data")
+	}
+	release()
+	release()
+}
