@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MPL-2.0
+package buf
+
+import "sync/atomic"
+
+// BorrowMulti takes ownership of a batch of disjoint slices. The slices must
+// remain valid until release is called. No payload is copied; the last Buffer
+// release returns the whole batch. Individual Buffer ownership is exclusive,
+// while different buffers in the batch may be released concurrently.
+func BorrowMulti(parts [][]byte, release func()) MultiBuffer {
+	count := 0
+	for _, p := range parts {
+		if len(p) > 0 {
+			count++
+		}
+	}
+	if count == 0 {
+		release()
+		return nil
+	}
+	var remaining atomic.Int32
+	remaining.Store(int32(count))
+	done := func() {
+		if remaining.Add(-1) == 0 {
+			release()
+		}
+	}
+	// All records already share a mapping lifetime. Allocate their descriptors
+	// together as well, avoiding one heap allocation per TLS record.
+	mb := make(MultiBuffer, count)
+	buffers := make([]Buffer, count)
+	i := 0
+	for _, p := range parts {
+		if len(p) > 0 {
+			buffers[i] = Buffer{v: p[:len(p):len(p)], end: int32(len(p)), ownership: borrowed, release: done}
+			mb[i] = &buffers[i]
+			i++
+		}
+	}
+	return mb
+}
--- a/_nss/nss_borrow_buf_test.go
+++ b/_nss/nss_borrow_buf_test.go
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: MPL-2.0
+package buf
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestNSSBorrowBatchLifetime(t *testing.T) {
+	var calls atomic.Int32
+	parts := [][]byte{[]byte("first"), nil, []byte("second")}
+	mb := BorrowMulti(parts, func() { calls.Add(1) })
+	if &mb[0].Bytes()[0] != &parts[0][0] {
+		t.Fatal("payload copied")
+	}
+	rest, first := SplitFirst(mb)
+	first.Release()
+	first.Release()
+	if calls.Load() != 0 {
+		t.Fatal("batch released early")
+	}
+	var wg sync.WaitGroup
+	for _, b := range rest {
+		wg.Add(1)
+		go func(b *Buffer) { defer wg.Done(); b.Release() }(b)
+	}
+	wg.Wait()
+	if calls.Load() != 1 {
+		t.Fatal("batch release count", calls.Load())
+	}
+	BorrowMulti(nil, func() { calls.Add(1) })
+	if calls.Load() != 2 {
+		t.Fatal("empty batch leaked")
+	}
+}
+
+type nssFailWriter struct{}
+
+func (nssFailWriter) Write(p []byte) (int, error) { return 0, errors.New("closed") }
+func TestNSSBorrowWriterFailure(t *testing.T) {
+	released := 0
+	mb := BorrowMulti([][]byte{[]byte("first"), []byte("second")}, func() { released++ })
+	w := BufferToBytesWriter{Writer: nssFailWriter{}}
+	if w.WriteMultiBuffer(mb) == nil || released != 1 {
+		t.Fatal("failed send leaked", released)
+	}
+}
+func TestNSSBorrowSplitAndSend(t *testing.T) {
+	released := 0
+	mb := BorrowMulti([][]byte{[]byte("first"), []byte("second")}, func() { released++ })
+	rest, head := SplitSize(mb, 3)
+	if released != 0 {
+		t.Fatal("split released storage")
+	}
+	var out bytes.Buffer
+	w := BufferToBytesWriter{Writer: &out}
+	if err := w.WriteMultiBuffer(head); err != nil {
+		t.Fatal(err)
+	}
+	if released != 0 {
+		t.Fatal("partial batch released")
+	}
+	if err := w.WriteMultiBuffer(rest); err != nil {
+		t.Fatal(err)
+	}
+	if released != 1 || out.String() != "firstsecond" {
+		t.Fatal("stream or release", out.String(), released)
+	}
+}
+
+func TestNSSBorrowSplitLargeRecord(t *testing.T) {
+	released := 0
+	want := bytes.Repeat([]byte{71}, 16384)
+	mb := BorrowMulti([][]byte{want}, func() { released++ })
+	rest, head := SplitSize(mb, 12000)
+	if head.Len() != 12000 || rest.Len() != 4384 {
+		t.Fatal("large split length")
+	}
+	got := append([]byte(nil), head[0].Bytes()...)
+	got = append(got, rest[0].Bytes()...)
+	if !bytes.Equal(got, want) {
+		t.Fatal("split corrupted stream")
+	}
+	ReleaseMulti(head)
+	ReleaseMulti(rest)
+	if released != 1 {
+		t.Fatal("split leaked mapping")
+	}
+}
+
+func BenchmarkNSSBorrowMulti(b *testing.B) {
+	for _, count := range []int{1, 4, 16} {
+		b.Run(fmt.Sprint(count), func(b *testing.B) {
+			parts := make([][]byte, count)
+			for i := range parts {
+				parts[i] = make([]byte, 16384)
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				ReleaseMulti(BorrowMulti(parts, func() {}))
+			}
+		})
+	}
+}
--- a/_nss/nss_borrow_tls.go
+++ b/_nss/nss_borrow_tls.go
@@ -0,0 +1,129 @@
+// Copyright 2026. SPDX-License-Identifier: BSD-3-Clause
+package tls
+
+import (
+	"io"
+	"net"
+	"os"
+	"sync"
+)
+
+// A lease pins both the mapping and its contents. Close cancels readers waiting
+// for reuse, but only the consumer may drop the mapping reference.
+var nssBorrowCond = os.Getenv("XRAY_NSS_BORROW_NOTIFY") == "cond"
+
+type nssReadLease struct {
+	cond     *sync.Cond
+	done     chan struct{}
+	canceled chan struct{}
+}
+
+// Called with c.in held. Never hold the input lock while waiting for a consumer:
+// Close must be able to cancel this wait and release the connection's own pin.
+func (c *Conn) nssWaitReadLease() error {
+	for c.nssReadLease != nil {
+		lease := c.nssReadLease
+		if lease.cond != nil {
+			lease.cond.Wait()
+			if c.activeCall.Load()&1 != 0 {
+				return net.ErrClosed
+			}
+			continue
+		}
+		c.in.Unlock()
+		select {
+		case <-lease.done:
+		case <-lease.canceled:
+		}
+		c.in.Lock()
+		if c.activeCall.Load()&1 != 0 {
+			return net.ErrClosed
+		}
+		if c.nssReadLease == lease {
+			c.nssReadLease = nil
+		}
+	}
+	return nil
+}
+
+type nssCaptureRecord struct{ data []byte }
+
+func (w *nssCaptureRecord) Write(p []byte) (int, error) { w.data = p; return len(p), nil }
+
+// NSSBorrowRecords returns authenticated application records without copying
+// their payload. The caller must release the entire batch before reading again.
+// Only records already decrypted by the same NSS request batch are included.
+// TLS control messages, key changes and the next DMA submission wait for release.
+func (c *Conn) NSSBorrowRecords() ([][]byte, func(), error) {
+	if err := c.Handshake(); err != nil {
+		return nil, nil, err
+	}
+	c.in.Lock()
+	defer c.in.Unlock()
+	if err := c.nssWaitReadLease(); err != nil {
+		return nil, nil, err
+	}
+	for c.input.Len() == 0 {
+		if err := c.readRecord(); err != nil {
+			return nil, nil, err
+		}
+		for c.hand.Len() > 0 {
+			if err := c.handlePostHandshakeMessage(); err != nil {
+				return nil, nil, err
+			}
+		}
+	}
+	// A negotiated non-NSS cipher retains normal copying semantics.
+	if c.nssReadOwner == nil {
+		p := make([]byte, c.input.Len())
+		_, err := io.ReadFull(&c.input, p)
+		return [][]byte{p}, func() {}, err
+	}
+	_, _, unpin := c.nssReadOwner.NSSRecordBuffers()
+	if unpin == nil {
+		return nil, nil, net.ErrClosed
+	}
+	parts := make([][]byte, 0, 16)
+	var readErr error
+	for {
+		var capture nssCaptureRecord
+		_, _ = c.input.WriteTo(&capture)
+		if len(capture.data) > 0 {
+			parts = append(parts, capture.data[:len(capture.data):len(capture.data)])
+		}
+		if len(parts) == 16 || !c.nssReadyApplicationRecord() {
+			break
+		}
+		if readErr = c.readRecord(); readErr != nil {
+			break
+		}
+	}
+	lease := &nssReadLease{}
+	if nssBorrowCond {
+		if c.nssReadNotify == nil {
+			c.nssReadNotify = sync.NewCond(&c.in.Mutex)
+		}
+		lease.cond = c.nssReadNotify
+	} else {
+		lease.done = make(chan struct{})
+		lease.canceled = make(chan struct{})
+	}
+	c.nssReadLease = lease
+	var once sync.Once
+	return parts, func() {
+		once.Do(func() {
+			if lease.cond == nil {
+				unpin()
+				close(lease.done)
+				return
+			}
+			c.in.Lock()
+			unpin()
+			if c.nssReadLease == lease {
+				c.nssReadLease = nil
+			}
+			lease.cond.Broadcast()
+			c.in.Unlock()
+		})
+	}, readErr
+}
--- a/_nss/nss_direct_buf.go
+++ b/_nss/nss_direct_buf.go
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MPL-2.0
+package buf
+
+import "os"
+
+var nssDirectCopyEnabled = (os.Getenv("XRAY_NSS_TLS") == "dmabuf" || os.Getenv("XRAY_NSS_TLS") == "cpu-batch") && os.Getenv("XRAY_NSS_TX_DIRECT") == "1"
+
+// A writer implementing this optional interface consumes at most one batch of
+// already-ready plaintext. False means no bytes were consumed. Read and write
+// errors are kept separate to preserve Copy's error classification.
+type nssReadyCopier interface {
+	NSSCopyReadyFrom(Reader, func(MultiBuffer)) (bool, error, error)
+}
+
+func (w *BufferedWriter) NSSCopyReadyFrom(reader Reader, observe func(MultiBuffer)) (bool, error, error) {
+	w.Lock()
+	defer w.Unlock()
+	if w.buffered {
+		return false, nil, nil
+	}
+	if direct, ok := w.writer.(nssReadyCopier); ok {
+		return direct.NSSCopyReadyFrom(reader, observe)
+	}
+	return false, nil, nil
+}
