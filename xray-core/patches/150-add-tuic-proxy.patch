+++ b/proxy/tuic/client.go
@@ -0,0 +1,230 @@
+package tuic
+
+import (
+	"context"
+	"crypto/x509"
+	stderrors "errors"
+	"github.com/gofrs/uuid/v5"
+	C "github.com/metacubex/mihomo/constant"
+	T "github.com/metacubex/mihomo/transport/tuic"
+	TC "github.com/metacubex/mihomo/transport/tuic/common"
+	Q "github.com/metacubex/quic-go"
+	TLS "github.com/metacubex/tls"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	"net/netip"
+	"os"
+	"sync"
+	"time"
+)
+
+type Client struct {
+	config      *ClientConfig
+	tls         *TLS.Config
+	policy      policy.Session
+	mu          sync.Mutex
+	clients     []T.Client
+	udpClients  map[T.Client]bool
+	closed      bool
+	connections map[*Q.Conn]struct{}
+}
+
+func NewClient(ctx context.Context, c *ClientConfig) (*Client, error) {
+	if c.Address == nil || c.Port == 0 || c.Port > 65535 {
+		return nil, errors.New("tuic: invalid server")
+	}
+	name := c.ServerName
+	if name == "" {
+		name = c.Address.AsAddress().String()
+	}
+	tls := &TLS.Config{ServerName: name, InsecureSkipVerify: c.AllowInsecure, NextProtos: c.Alpn, MinVersion: TLS.VersionTLS13}
+	if len(tls.NextProtos) == 0 {
+		tls.NextProtos = []string{"h3"}
+	}
+	if c.CertificateFile != "" {
+		pem, err := os.ReadFile(c.CertificateFile)
+		if err != nil {
+			return nil, err
+		}
+		roots, err := x509.SystemCertPool()
+		if err != nil {
+			roots = x509.NewCertPool()
+		}
+		if !roots.AppendCertsFromPEM(pem) {
+			return nil, errors.New("tuic: invalid CA")
+		}
+		tls.RootCAs = roots
+	}
+	return &Client{config: c, tls: tls, policy: core.MustFromContext(ctx).GetFeature(policy.ManagerType()).(policy.Manager).ForLevel(c.Level)}, nil
+}
+func (c *Client) Close() error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.closed = true
+	for conn := range c.connections {
+		conn.CloseWithError(0, "outbound closed")
+	}
+	for _, v := range c.clients {
+		v.Close()
+	}
+	c.clients = nil
+	return nil
+}
+func (c *Client) newClient(dialer internet.Dialer, udp bool, force bool) (T.Client, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed {
+		return nil, errors.New("tuic: closed")
+	}
+	active := c.clients[:0]
+	for _, v := range c.clients {
+		if v.OpenStreams() == 0 && !v.LastVisited().IsZero() && time.Since(v.LastVisited()) > 10*time.Minute {
+			v.Close()
+			delete(c.udpClients, v)
+		} else {
+			active = append(active, v)
+		}
+	}
+	c.clients = active
+	for _, v := range c.clients {
+		if !force && c.udpClients[v] == udp && v.OpenStreams()+1 < int64(c.config.MaxOpenStreams) {
+			v.SetLastVisited(time.Now())
+			return v, nil
+		}
+	}
+	if c.udpClients == nil {
+		c.udpClients = make(map[T.Client]bool)
+	}
+	conf := c.config
+	dial := func(ctx context.Context) (*Q.Conn, error) {
+		raw, err := dialer.Dial(ctx, net.UDPDestination(conf.Address.AsAddress(), net.Port(conf.Port)))
+		if err != nil {
+			return nil, err
+		}
+		pc := &connectedPacketConn{Conn: raw}
+		qc := &Q.Config{EnableDatagrams: true, MaxIncomingStreams: 1024, MaxIncomingUniStreams: 1024, KeepAlivePeriod: time.Duration(conf.HeartbeatInterval) * time.Millisecond, MaxDatagramFrameSize: 1400, InitialStreamReceiveWindow: TC.DefaultStreamReceiveWindow / 10, MaxStreamReceiveWindow: TC.DefaultStreamReceiveWindow, InitialConnectionReceiveWindow: TC.DefaultConnectionReceiveWindow / 10, MaxConnectionReceiveWindow: TC.DefaultConnectionReceiveWindow}
+		tr := &Q.Transport{Conn: pc}
+		var conn *Q.Conn
+		if conf.ReduceRtt {
+			conn, err = tr.DialEarly(ctx, raw.RemoteAddr(), c.tls, qc)
+		} else {
+			conn, err = tr.Dial(ctx, raw.RemoteAddr(), c.tls, qc)
+		}
+		if err != nil {
+			tr.Close()
+			raw.Close()
+			return nil, err
+		}
+		c.mu.Lock()
+		if c.closed {
+			c.mu.Unlock()
+			conn.CloseWithError(0, "closed")
+			tr.Close()
+			raw.Close()
+			return nil, errors.New("tuic: closed")
+		}
+		if c.connections == nil {
+			c.connections = make(map[*Q.Conn]struct{})
+		}
+		c.connections[conn] = struct{}{}
+		c.mu.Unlock()
+		TC.SetCongestionController(conn, conf.CongestionControl, 32, "")
+		go func() {
+			<-conn.Context().Done()
+			c.mu.Lock()
+			delete(c.connections, conn)
+			c.mu.Unlock()
+			tr.Close()
+			raw.Close()
+		}()
+		return conn, nil
+	}
+	mode := T.NATIVE
+	if conf.UdpRelayMode == "quic" {
+		mode = T.QUIC
+	}
+	var v T.Client
+	if conf.Version == 4 {
+		v = T.NewClientV4(&T.ClientOptionV4{Token: T.GenTKN(conf.Token), UdpRelayMode: mode, RequestTimeout: time.Duration(conf.RequestTimeout) * time.Millisecond, FastOpen: conf.FastOpen, MaxOpenStreams: int64(conf.MaxOpenStreams), MaxUdpRelayPacketSize: int(conf.MaxUdpRelayPacketSize)}, udp, dial)
+	} else {
+		id, _ := uuid.FromString(conf.Uuid)
+		v = T.NewClientV5(&T.ClientOptionV5{Uuid: id, Password: conf.Password, UdpRelayMode: mode, MaxOpenStreams: int64(conf.MaxOpenStreams), MaxUdpRelayPacketSize: int(conf.MaxUdpRelayPacketSize)}, udp, dial)
+	}
+	v.SetLastVisited(time.Now())
+	c.clients = append(c.clients, v)
+	c.udpClients[v] = udp
+	return v, nil
+}
+func metadata(d net.Destination) *C.Metadata {
+	m := &C.Metadata{DstPort: uint16(d.Port)}
+	if d.Address.Family().IsDomain() {
+		m.Host = d.Address.Domain()
+	} else {
+		m.DstIP, _ = netip.AddrFromSlice(d.Address.IP())
+	}
+	return m
+}
+func (c *Client) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	obs := session.OutboundsFromContext(ctx)
+	if len(obs) == 0 {
+		return errors.New("tuic: missing target")
+	}
+	ob := obs[len(obs)-1]
+	target := ob.Target
+	if !target.IsValid() || (target.Network != net.Network_TCP && target.Network != net.Network_UDP) {
+		return errors.New("tuic: invalid target")
+	}
+	ob.Name = "tuic"
+	ob.CanSpliceCopy = 3
+	v, err := c.newClient(dialer, target.Network == net.Network_UDP, false)
+	if err != nil {
+		return err
+	}
+	var reader buf.Reader
+	var writer buf.Writer
+	var stopIO func()
+	if target.Network == net.Network_TCP {
+		conn, e := v.DialContext(ctx, metadata(target))
+		if stderrors.Is(e, T.TooManyOpenStreams) {
+			v, e = c.newClient(dialer, false, true)
+			if e == nil {
+				conn, e = v.DialContext(ctx, metadata(target))
+			}
+		}
+		if e != nil {
+			return e
+		}
