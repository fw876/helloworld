+package tuic
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/features/policy"
+)
+
+// Stop blocked reads and join both copy loops before closing Mihomo packet state.
+func relay(ctx context.Context, upR buf.Reader, upW buf.Writer, downR buf.Reader, downW buf.Writer, stopIO func(), p policy.Session) error {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	timer := signal.CancelAfterInactivity(ctx, cancel, p.Timeouts.ConnectionIdle)
+	defer timer.SetTimeout(0)
+	results := make(chan error, 2)
+	go func() {
+		e := buf.Copy(upR, upW, buf.UpdateActivity(timer))
+		if e == nil {
+			common.Close(upW)
+		}
+		timer.SetTimeout(p.Timeouts.DownlinkOnly)
+		results <- e
+	}()
+	go func() {
+		e := buf.Copy(downR, downW, buf.UpdateActivity(timer))
+		if e == nil {
+			common.Close(downW)
+		}
+		timer.SetTimeout(p.Timeouts.UplinkOnly)
+		results <- e
+	}()
+	var first error
+	count := 0
+	for count < 2 {
+		select {
+		case e := <-results:
+			count++
+			if e != nil {
+				first = e
+			}
+		case <-ctx.Done():
+			first = ctx.Err()
+		}
+		if first != nil || count == 2 {
+			break
+		}
+	}
+	stopIO()
+	common.Interrupt(upR)
+	common.Interrupt(upW)
+	common.Interrupt(downR)
+	common.Interrupt(downW)
+	for count < 2 {
+		<-results
+		count++
+	}
+	return first
+}
