+package conf
+
+import (
+	"github.com/gofrs/uuid/v5"
+	"github.com/xtls/xray-core/common/errors"
+	P "github.com/xtls/xray-core/proxy/tuic"
+	T "github.com/xtls/xray-core/transport/internet/tuic"
+	"google.golang.org/protobuf/proto"
+	"strings"
+)
+
+func tuicCC(s string) (string, error) {
+	if s == "" {
+		return "cubic", nil
+	}
+	switch s {
+	case "cubic", "new_reno", "bbr", "bbr_meta_v1", "bbr_meta_v2":
+		return s, nil
+	}
+	return "", errors.New("tuic: unsupported congestion control")
+}
+
+type TUICClientConfig struct {
+	Address               *Address `json:"address"`
+	Port                  uint16   `json:"port"`
+	Version               uint32   `json:"version"`
+	Token                 string   `json:"token"`
+	UUID                  string   `json:"uuid"`
+	Password              string   `json:"password"`
+	ServerName            string   `json:"serverName"`
+	CertificateFile       string   `json:"certificateFile"`
+	AllowInsecure         bool     `json:"allowInsecure"`
+	ALPN                  []string `json:"alpn"`
+	CongestionControl     string   `json:"congestionControl"`
+	UDPRelayMode          string   `json:"udpRelayMode"`
+	ReduceRTT             bool     `json:"reduceRtt"`
+	FastOpen              bool     `json:"fastOpen"`
+	HeartbeatInterval     uint32   `json:"heartbeatInterval"`
+	RequestTimeout        uint32   `json:"requestTimeout"`
+	MaxOpenStreams        uint32   `json:"maxOpenStreams"`
+	MaxUDPRelayPacketSize uint32   `json:"maxUdpRelayPacketSize"`
+	Level                 uint32   `json:"level"`
+}
+
+func (c *TUICClientConfig) Build() (proto.Message, error) {
+	if c.Address == nil || c.Port == 0 {
+		return nil, errors.New("tuic: address and port required")
+	}
+	v := c.Version
+	if v == 0 {
+		v = 5
+		if c.Token != "" {
+			v = 4
+		}
+	}
+	if v == 4 {
+		if c.Token == "" || c.UUID != "" || c.Password != "" {
+			return nil, errors.New("tuic v4 requires token only")
+		}
+	} else if v == 5 {
+		if _, e := uuid.FromString(c.UUID); e != nil || c.Password == "" || c.Token != "" {
+			return nil, errors.New("tuic v5 requires UUID and password")
+		}
+	} else {
+		return nil, errors.New("tuic version must be 4 or 5")
+	}
+	cc, e := tuicCC(c.CongestionControl)
+	if e != nil {
+		return nil, e
+	}
+	mode := c.UDPRelayMode
+	if mode == "" {
+		mode = "native"
+	}
+	if mode != "native" && mode != "quic" {
+		return nil, errors.New("tuic: invalid UDP relay mode")
+	}
+	heartbeat := c.HeartbeatInterval
+	if heartbeat == 0 {
+		heartbeat = 10000
+	}
+	timeout := c.RequestTimeout
+	if timeout == 0 {
+		timeout = 8000
+	}
+	streams := c.MaxOpenStreams
+	if streams == 0 {
+		streams = 100
+	}
+	if streams < 2 {
+		return nil, errors.New("tuic: maxOpenStreams must be at least 2")
+	}
+	size := c.MaxUDPRelayPacketSize
+	if size == 0 {
+		size = 1200
+	}
+	if size < 256 || size > 1252 {
+		return nil, errors.New("tuic: UDP relay packet size must be 256..1252")
+	}
+	return &P.ClientConfig{Address: c.Address.Build(), Port: uint32(c.Port), Version: v, Token: c.Token, Uuid: c.UUID, Password: c.Password, ServerName: c.ServerName, CertificateFile: c.CertificateFile, AllowInsecure: c.AllowInsecure, Alpn: c.ALPN, CongestionControl: cc, UdpRelayMode: mode, ReduceRtt: c.ReduceRTT, FastOpen: c.FastOpen, HeartbeatInterval: heartbeat, RequestTimeout: timeout, MaxOpenStreams: streams, MaxUdpRelayPacketSize: size, Level: c.Level}, nil
+}
+
+type TUICServerConfig struct {
+	Tokens                []string          `json:"tokens"`
+	Users                 map[string]string `json:"users"`
+	CertificateFile       string            `json:"certificateFile"`
+	KeyFile               string            `json:"keyFile"`
+	ALPN                  []string          `json:"alpn"`
+	CongestionControl     string            `json:"congestionControl"`
+	AuthenticationTimeout uint32            `json:"authenticationTimeout"`
+	MaxUDPRelayPacketSize uint32            `json:"maxUdpRelayPacketSize"`
+	Level                 uint32            `json:"level"`
+}
+
+func (c *TUICServerConfig) Build() (proto.Message, error) {
+	if len(c.Tokens)+len(c.Users) == 0 || c.CertificateFile == "" || c.KeyFile == "" {
+		return nil, errors.New("tuic: credentials and TLS certificate/key required")
+	}
+	for _, t := range c.Tokens {
+		if strings.TrimSpace(t) == "" {
+			return nil, errors.New("tuic: empty token")
+		}
+	}
+	for id, p := range c.Users {
+		if _, e := uuid.FromString(id); e != nil || p == "" {
+			return nil, errors.New("tuic: invalid user")
+		}
+	}
+	cc, e := tuicCC(c.CongestionControl)
+	if e != nil {
+		return nil, e
+	}
+	timeout := c.AuthenticationTimeout
+	if timeout == 0 {
+		timeout = 3000
+	}
+	size := c.MaxUDPRelayPacketSize
+	if size == 0 {
+		size = 1200
+	}
+	if size < 256 || size > 1252 {
+		return nil, errors.New("tuic: invalid UDP packet size")
+	}
+	return &T.Config{Tokens: c.Tokens, Users: c.Users, CertificateFile: c.CertificateFile, KeyFile: c.KeyFile, Alpn: c.ALPN, CongestionControl: cc, AuthenticationTimeout: timeout, MaxUdpRelayPacketSize: size, Level: c.Level}, nil
+}
