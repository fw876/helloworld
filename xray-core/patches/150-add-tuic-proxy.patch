+type Listener struct {
+	server *T.Server
+	pc     net.PacketConn
+	cancel context.CancelFunc
+}
+
+func (l *Listener) Addr() net.Addr { return l.pc.LocalAddr() }
+func (l *Listener) Close() error   { l.cancel(); return errors.Join(l.server.Close(), l.pc.Close()) }
+func target(a S.Addr, network N.Network) (N.Destination, error) {
+	d, e := N.ParseDestination("tcp:" + a.String())
+	d.Network = network
+	return d, e
+}
+func Listen(ctx context.Context, address N.Address, port N.Port, settings *internet.MemoryStreamConfig, add internet.ConnHandler) (internet.Listener, error) {
+	c := settings.ProtocolSettings.(*Config)
+	cert, e := TLS.LoadX509KeyPair(c.CertificateFile, c.KeyFile)
+	if e != nil {
+		return nil, e
+	}
+	alpn := c.Alpn
+	if len(alpn) == 0 {
+		alpn = []string{"h3"}
+	}
+	pc, e := internet.ListenSystemPacket(ctx, &net.UDPAddr{IP: address.IP(), Port: int(port)}, settings.SocketSettings)
+	if e != nil {
+		return nil, e
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	var mu sync.Mutex
+	associations := map[string]*Conn{}
+	option := &T.ServerOption{TlsConfig: &TLS.Config{Certificates: []TLS.Certificate{cert}, NextProtos: alpn, MinVersion: TLS.VersionTLS13}, QuicConfig: &Q.Config{EnableDatagrams: true, Allow0RTT: true, MaxIncomingStreams: 1024, MaxIncomingUniStreams: 1024, MaxDatagramFrameSize: 1400}, CongestionController: c.CongestionControl, AuthenticationTimeout: time.Duration(c.AuthenticationTimeout) * time.Millisecond, MaxUdpRelayPacketSize: int(c.MaxUdpRelayPacketSize), Users: map[[16]byte]string{}}
+	for _, token := range c.Tokens {
+		option.Tokens = append(option.Tokens, T.GenTKN(token))
+	}
+	for id, pass := range c.Users {
+		u, err := uuid.FromString(id)
+		if err != nil {
+			cancel()
+			pc.Close()
+			return nil, err
+		}
+		option.Users[u] = pass
+	}
+	user := func(a []I.Addition) string { m := &C.Metadata{}; I.ApplyAdditions(m, a...); return m.InUser }
+	option.HandleTcpFn = func(conn net.Conn, a S.Addr, adds ...I.Addition) error {
+		d, err := target(a, N.Network_TCP)
+		if err != nil {
+			conn.Close()
+			return err
+		}
+		add(&Conn{Conn: conn, Target: d, User: user(adds)})
+		return nil
+	}
+	option.HandleUdpFn = func(a S.Addr, p C.UDPPacket, adds ...I.Addition) error {
+		d, err := target(a, N.Network_UDP)
+		if err != nil {
+			p.Drop()
+			return err
+		}
+		key := p.LocalAddr().String() + "|" + user(adds)
+		mu.Lock()
+		conn := associations[key]
+		if conn != nil && conn.ctx.Err() != nil {
+			delete(associations, key)
+			conn = nil
+		}
+		if conn == nil {
+			cc, stop := context.WithCancel(ctx)
+			conn = &Conn{Target: d, Packets: make(chan Datagram, 64), ctx: cc, cancel: stop, local: pc.LocalAddr(), remote: p.LocalAddr(), User: user(adds)}
+			associations[key] = conn
+			add(conn)
+			go func(cn *Conn) {
+				<-cn.ctx.Done()
+				mu.Lock()
+				if associations[key] == cn {
+					delete(associations, key)
+				}
+				mu.Unlock()
+				cn.Close()
+			}(conn)
+		}
+		mu.Unlock()
+		conn.packetMu.Lock()
+		if conn.ctx.Err() != nil {
+			p.Drop()
+		} else {
+			select {
+			case conn.Packets <- Datagram{p, d}:
+			default:
+				p.Drop()
+			}
+		}
+		conn.packetMu.Unlock()
+		return nil
+	}
+	server, err := T.NewServer(option, pc)
+	if err != nil {
+		cancel()
+		pc.Close()
+		return nil, err
+	}
+	l := &Listener{server: server, pc: pc, cancel: cancel}
+	go server.Serve()
+	return l, nil
+}
+func init() {
+	common.Must(internet.RegisterProtocolConfigCreator("tuic", func() interface{} { return &Config{} }))
+	common.Must(internet.RegisterTransportListener("tuic", Listen))
+}
