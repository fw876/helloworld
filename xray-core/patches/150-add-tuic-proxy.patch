+package tuic
+
+import (
+	"context"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/common/task"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	T "github.com/xtls/xray-core/transport/internet/tuic"
+	"time"
+)
+
+type Server struct{ config *T.Config }
+
+func (s *Server) Network() []net.Network { return []net.Network{net.Network_TCP} }
+func (s *Server) Process(ctx context.Context, _ net.Network, conn stat.Connection, d routing.Dispatcher) error {
+	c, ok := stat.TryUnwrapStatsConn(conn).(*T.Conn)
+	if !ok {
+		return errors.New("tuic: requires TUIC transport")
+	}
+	defer c.Close()
+	if in := session.InboundFromContext(ctx); in != nil {
+		copy := *in
+		copy.Name = "tuic"
+		copy.User = &protocol.MemoryUser{Email: c.User, Level: s.config.Level}
+		ctx = session.ContextWithInbound(ctx, &copy)
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stop := context.AfterFunc(ctx, func() { c.Close() })
+	defer stop()
+	timer := signal.CancelAfterInactivity(ctx, cancel, 5*time.Minute)
+	defer timer.SetTimeout(0)
+	link, err := d.Dispatch(ctx, c.Target)
+	if err != nil {
+		return err
+	}
+	var reader buf.Reader = buf.NewReader(c)
+	var writer buf.Writer = buf.NewWriter(c)
+	if c.Packets != nil {
+		reader = &inPacketReader{c}
+		writer = &inPacketWriter{c}
+	}
+	err = task.Run(ctx, func() error { return buf.Copy(reader, link.Writer, buf.UpdateActivity(timer)) }, task.OnSuccess(func() error { return buf.Copy(link.Reader, writer, buf.UpdateActivity(timer)) }, task.Close(link.Writer)))
+	common.Interrupt(link.Reader)
+	common.Interrupt(link.Writer)
+	return err
+}
+
+type inPacketReader struct{ c *T.Conn }
+
+func (r *inPacketReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	p, e := r.c.ReadPacket()
+	if e != nil {
+		return nil, e
+	}
+	b := buf.FromBytes(append([]byte(nil), p.Packet.Data()...))
+	p.Packet.Drop()
+	b.UDP = &p.Target
+	return buf.MultiBuffer{b}, nil
+}
+
+type inPacketWriter struct{ c *T.Conn }
+
+func (w *inPacketWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	defer buf.ReleaseMulti(mb)
+	for _, b := range mb {
+		d := w.c.Target
+		if b.UDP != nil {
+			d = *b.UDP
+		}
+		a := M.ParseSocksaddrHostPort(d.Address.String(), uint16(d.Port))
+		if e := w.c.WritePacket(b.Bytes(), a); e != nil {
+			return e
+		}
+	}
+	return nil
+}
+func init() {
+	common.Must(common.RegisterConfig((*T.Config)(nil), func(ctx context.Context, c interface{}) (interface{}, error) {
+		m, _ := session.StreamSettingsFromContext(ctx).(*internet.MemoryStreamConfig)
+		if m == nil || m.ProtocolName != "tuic" {
+			return nil, errors.New("tuic inbound requires network tuic")
+		}
+		m.ProtocolSettings = c
+		return &Server{c.(*T.Config)}, nil
+	}))
+}
