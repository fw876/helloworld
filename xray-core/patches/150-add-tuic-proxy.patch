+
+type Datagram struct {
+	Packet C.UDPPacket
+	Target N.Destination
+}
+type Conn struct {
+	net.Conn
+	Target        N.Destination
+	Packets       chan Datagram
+	ctx           context.Context
+	cancel        context.CancelFunc
+	local, remote net.Addr
+	User          string
+	mu            sync.Mutex
+	last          C.UDPPacket
+	packetMu      sync.Mutex
+}
+
+func (c *Conn) ReadPacket() (Datagram, error) {
+	select {
+	case p := <-c.Packets:
+		c.mu.Lock()
+		c.last = p.Packet
+		c.mu.Unlock()
+		return p, nil
+	case <-c.ctx.Done():
+		return Datagram{}, io.EOF
+	}
+}
+func (c *Conn) WritePacket(b []byte, a net.Addr) error {
+	c.mu.Lock()
+	p := c.last
+	c.mu.Unlock()
+	if p == nil {
+		return errors.New("tuic: no UDP association")
+	}
+	_, e := p.WriteBack(b, a)
+	return e
+}
+func (c *Conn) Close() error {
+	if c.cancel != nil {
+		c.packetMu.Lock()
+		defer c.packetMu.Unlock()
+		c.cancel()
+		for {
+			select {
+			case p := <-c.Packets:
+				p.Packet.Drop()
+			default:
+				return nil
+			}
+		}
+	}
+	return c.Conn.Close()
+}
+func (c *Conn) LocalAddr() net.Addr {
+	if c.Packets != nil {
+		return c.local
+	}
+	return c.Conn.LocalAddr()
+}
+func (c *Conn) RemoteAddr() net.Addr {
+	if c.Packets != nil {
+		if raw, ok := c.remote.(interface{ RawAddr() net.Addr }); ok {
+			return raw.RawAddr()
+		}
+		return c.remote
+	}
+	return c.Conn.RemoteAddr()
+}
